@page "/member/training"

@using System.Text.Json
@using System.Text.Json.Serialization
@using CornerkickApp.Controllers.Member
@using CornerkickApp.Components.Shared.Components
@using CornerkickApp.Shared.Models

@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject DialogService DialogService
@inject Controllers.Shared.MyAuthenticationStateProvider _auth

<PageTitle>Training</PageTitle>

<!DOCTYPE html>
<html>
<head>
</head>

<body>
  <div id="divBody" style="position: relative; height: 100%; max-width: 1200px; display: flex; flex-wrap: wrap">
    @*
    <RadzenButton Text="Show confirm dialog" Click=@(args => DialogService.Confirm("Are you sure?", "MyTitle", new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" })) />
    *@

    <h3 class="scroll-anchor" id="header_training_plan">Trainingsplan</h3>
    <div style="position: relative; width: 100%; height: auto; margin-bottom: 2%; overflow: auto">
      <div id="divTrainingPlanContainer" style="width: fit-content">
        <div style="position: relative; width: 100%; display: flex; flex-wrap: nowrap; justify-content: space-between">
          <a class="noselect" style="cursor: pointer" @onclick="(() => changeWeek(-1))">&#60;&#60; vorh. Woche</a>
          <a class="noselect" style="cursor: pointer" @onclick="(() => changeWeek(0))">akt. Woche</a>
          <a class="noselect scroll-anchor" id="aNextWeek" style="cursor: pointer" @onclick="(() => changeWeek(+1))">nä. Woche &#62;&#62;</a>
        </div>
        @if (trPlan != null) {
          <table id="tblTrainingPlan" class="table table-bordered" cellpadding="4" style="position: relative; width: 100%; margin-top: 6px">
            <thead>
              <tr>
                <th></th>
                @for (int iD = 0; iD < trPlan.Length; iD++) {
                  <th class="@(trPlan[iD][0].dt.Date.Equals(CkAppShared.ckMng.dtDatum.Date) ? "today" : "")" style="text-align: center; font-weight: bold; background-color: @ltColor[iD] !important">@trPlan[iD][0].dt.ToString("ddd., dd.MM.")</th>
                }
              </tr>
            </thead>
            <tbody>
              @for (int iIxDay = 0; iIxDay < trPlan[0].Length; iIxDay++) {
                <tr>
                  <td style="text-align: right; font-weight: bold;">@sTrainingTimes[iIxDay]</td>
                  @for (int iD = 0; iD < trPlan.Length; iD++) {
                    Cl? cl = ltCls.Find(c => c.iId == (trPlan[iD][iIxDay].iType < 0 ? -(trPlan[iD][iIxDay].iType + 1) : trPlan[iD][iIxDay].iType));
                    string sOpac = trPlan[iD][iIxDay].iType < 0 ? "opacity: 0.4" : "opacity: 0.75";
                    string sBgCl = "";
                    if (cl != null) {
                      if (string.IsNullOrEmpty(cl.sCl2)) sBgCl = "background-color: " + cl.sCl + ")";
                      else                               sBgCl = "background-image: linear-gradient(to right, " + cl.sCl + "," + cl.sCl2 + ")";
                    }
                    <td style="text-align: center; @sBgCl !important; @sOpac">
                      @if (trPlan[iD][iIxDay].iType > 100) {
                        if (trPlan[iD][iIxDay].iType == 101) {
                          <span>Spiel</span>
                        } else if (trPlan[iD][iIxDay].iType == 102) {
                          <span>Reise</span>
                        } else if (trPlan[iD][iIxDay].iType == 103) {
                          <span>Ereignis</span>
                        } else {
                          <span>?</span>
                        }
                      } else {
                        bool bSctDisabled = false;
                        @if (trPlan[iD][iIxDay].iType < 0) {
                          bSctDisabled = true;
                        } else {
                          bDisableTemplateBtns = false;
                        }
                        int jD = iD;
                        int jIxDay = iIxDay;
                        <select class="form-control" style="width: 90%; min-width: 60px" @onchange="(e) => setTraining(e, jD, jIxDay)" disabled="@bSctDisabled">
                          @for (int iT = 0; iT < sTrainingNames.Length; iT++) {
                            bool bSelected = false;
                            @if (trPlan[iD][iIxDay].iType < 0) {
                              bSelected = iT == -(trPlan[iD][iIxDay].iType + 1);
                            } else {
                              bSelected = iT == trPlan[iD][iIxDay].iType;
                            }
                            <option value="@iT" selected="@bSelected">@sTrainingNames[iT]</option>
                          }
                        </select>
                      }
                    </td>
                  }
                </tr>
              }
            </tbody>
          </table>
        }

        <div id="chartContainerParent" style="position: relative; width: 100%; display: @displaychart">
          @if (ltTeamData != null && ltTeamData.Length > 0 && ltTeamData[0].Length > 0 && ltTeamData[0][0] != null && ltTeamData[0][0].Count > 1) {
            <div id="divTeamDataChartContainer" style="height: 300px; width: 100%">
              <RadzenChart Style="height:100%">
                @{
                  string[] sFillColors = new string[] { "red", "#00BFFF", "gold" };
                  foreach (List<CkAppShared.DataPointTD>[] ltdp0 in ltTeamData) {
                    if (ltdp0 == null) continue;

                    int i = 0;
                    foreach (List<CkAppShared.DataPointTD> ltlg in ltdp0) {
                      if (ltlg != null && ltlg.Count > 0) {
                        string sFillCl = sFillColors[i++];
                        <RadzenLineSeries Data="@ltlg" CategoryProperty="X" ValueProperty="Y" Stroke="@sFillCl" StrokeWidth="1">
                          <TooltipTemplate Context="data">
                            @if (data.X.HasValue && data.Y.HasValue) {
                              <u>@(data.X.Value.ToString("dd.MM HH:mm"))</u>
                              <br />
                              @(String.Format("{0:P2}", data.Y))
                            }
                            @if (!string.IsNullOrEmpty(data.Z)) {
                              @((MarkupString)(" - " + data.Z))
                            }
                          </TooltipTemplate>
                          <ChildContent>
                            <RadzenMarkers MarkerType="MarkerType.Circle" Size="6" Fill="@sFillCl" StrokeWidth="0" />
                          </ChildContent>
                        </RadzenLineSeries>
                      }
                    }
                  }
                }
                <RadzenCategoryAxis Visible="true" Formatter="@FormatAsDate" Step="TimeSpan.FromDays(1)">
                  <RadzenGridLines Visible="true" Stroke="#ccc" LineType="Radzen.Blazor.LineType.Dashed" />
                </RadzenCategoryAxis>
                <RadzenValueAxis FormatString="{0:P0}">
                  <RadzenGridLines Visible="true" Stroke="#ccc" LineType="Radzen.Blazor.LineType.Dashed" />
                </RadzenValueAxis>
                <RadzenLegend Visible="false" />
              </RadzenChart>
            </div>

            <label id="lbPlotExpected" style="position: absolute; top: 0px; right: 0px">
              <input type="checkbox" id="cbPlotExpected" name="cbPlotExpected" @oninput="GetTeamDevelopmentData" style="margin-left: 4px">
              Vorschau
            </label>
            <select name="Camp" id="selectCamp" @onchange="GetTeamDevelopmentData" style="position: absolute; top: 20px; right: 0px; width: 80px; display: none">
              <option value="0">aus</option>
              @{
                foreach (CornerkickManager.TrainingCamp.Camp camp in CkAppShared.ckMng.tcp.ltCamps) {
                  <option value="@camp.iId.ToString()">@camp.sName</option>
                }
              }
            </select>
          }
        </div>
      </div>
    </div>

    <div class="scroll-anchor" id="training_templates" style="width: 100%; margin-bottom: 2rem">
      <h4>Vorlagen Trainingswoche</h4>
      <div id="divTrainingTemplatesContainer" style="position: relative; width: 100%; display: flex; flex-wrap: wrap; justify-content: space-between">
        <button id="bnTrainingWeekTemplate3" class="btn btn-outline-secondary btnTrainingWeekTemplate" @onclick="@(() => setTrainingTemplate(2))" disabled="@bDisableTemplateBtns">Ausgeglichen</button>
        <button id="bnTrainingWeekTemplate1" class="btn btn-outline-secondary btnTrainingWeekTemplate" @onclick="@(() => setTrainingTemplate(0))" disabled="@bDisableTemplateBtns">Kondition</button>
        <button id="bnTrainingWeekTemplate2" class="btn btn-outline-secondary btnTrainingWeekTemplate" @onclick="@(() => setTrainingTemplate(1))" disabled="@bDisableTemplateBtns">Regeneration</button>
        <button id="bnTrainingWeekTemplate4" class="btn btn-outline-secondary btnTrainingWeekTemplate" @onclick="@(() => setTrainingTemplate(3))" disabled="disabled">Mentaltraining</button>
        <button id="bnTrainingWeekTemplate5" class="btn btn-outline-secondary btnTrainingWeekTemplate" @onclick="@(() => setTrainingTemplate(4))" disabled="@bDisableTemplateBtns">Zweikampf</button>
        <button id="bnTrainingWeekTemplate6" class="btn btn-outline-secondary btnTrainingWeekTemplate" @onclick="@(() => setTrainingTemplate(5))" disabled="@bDisableTemplateBtns">Abschluss</button>
        <button id="bnCopyWeek" class="btn btn-outline-secondary" @onclick="copyTrainingWeek" style="position: relative; width: 100%; margin-top: 4px">Aktuelle Trainingswoche bis Saisonende fortführen</button>
      </div>
    </div>

    <div style="position: relative; display: flex; flex-wrap: wrap; max-width: 100%">
      <div style="position: relative; margin-right: 20px">
        <h3>Bisherige Trainings</h3>

        <div style="position: relative; float: left; margin-right: 10px; margin-bottom: 4%">
          <table class="table table-bordered" cellpadding="4">
            <thead>
              <tr>
                <th style="font-size: 18px; color: blue; text-align: center" colspan="3">Konditionelles Training</th>
              </tr>
              <tr>
                <th style="text-align: center">Art</th>
                <th style="text-align: center">Anzahl</th>
                <th style="text-align: center">Anteil</th>
              </tr>
            </thead>
            <tbody>
              @{
                foreach (CornerkickManager.PlayerTool.Training tr in CkAppShared.ckMng.plt.ltTraining) {
                  if (tr.iId > 0 && tr.iId < model.iTrainingCount.Length && tr.fCondi > 0f) {
                    <tr>
                      <td style="text-align: center">@tr.sName</td>
                      <td style="text-align: center">@model.iTrainingCount[tr.iId].ToString()</td>
                      <td style="text-align: right">@model.sTrainingCountRel[tr.iId]</td>
                    </tr>
                  }
                }
              }
            </tbody>
          </table>
        </div>

        <div style="position: relative; float: left; margin-bottom: 4%">
          <table class="table table-bordered" border="1" cellpadding="4">
            <thead>
              <tr>
                <th style="font-size: 18px; color: green; text-align: center" colspan="3">Regeneratives Training</th>
              </tr>
              <tr>
                <th style="text-align: center">Art</th>
                <th style="text-align: center">Anzahl</th>
                <th style="text-align: center">Anteil</th>
              </tr>
            </thead>
            <tbody>
              @{
                foreach (CornerkickManager.PlayerTool.Training tr in CkAppShared.ckMng.plt.ltTraining) {
                  if (tr.iId > 0 && tr.iId < model.iTrainingCount.Length && tr.fCondi < 0f) {
                    <tr>
                      <td style="text-align: center">@tr.sName</td>
                      <td style="text-align: center">@model.iTrainingCount[tr.iId].ToString()</td>
                      <td style="text-align: right">@model.sTrainingCountRel[tr.iId]</td>
                    </tr>
                  }
                }
              }
            </tbody>
          </table>
        </div>
      </div>

      @if (model?.tripts != null) {
        <div style="position: relative; margin-bottom: 4%; max-width: 100%; overflow-x: auto">
          <h3>Sondertraining</h3>
          <table id="tblTrainingRules" cellpadding="2">
            @{
              int i = 0;
              foreach (TrainingRulesInput tri in model.tripts) {
                int j = i;
                <tr data-row=@j.ToString()>
                  <td style="text-align: right">
                    <b style="color: @(((tri.iTrainingRulesSmGr < 0 && tri.fTrainingRulesValue < 0.01) || (tri.iTrainingRulesSmGr > 0 && tri.fTrainingRulesValue > 0.99)) ? "grey" : "black")">@(j + 1).&nbsp;Regel:</b> Wenn
                  </td>
                  <td class="contain-select" style="text-align: center">
                    @*@Html.DropDownListFor(m => m.tripts[j].iTrainingRulesCFM, model.tripts[j].sliTrainingRulesCFM, new { @class = "form-horizontal ctrTrainingRules sctTrainingRulesCFM", @onchange = "setTrainingRules(" + j + ")", @disabled = "disabled" })*@
                    <Blazorise.Select class="form-horizontal ctrTrainingRules sctTrainingRulesCFM" SelectedValue="@tri.iTrainingRulesCFM" SelectedValueChanged="@(e => setTrainingRulesCFM(j, e))" TValue="int" Disabled="@bTrRuleDisabled[j]">
                      @foreach (LayoutModel.SelectListItem sli in tri.sliTrainingRulesCFM) {
                        <Blazorise.SelectItem Value="@sli.Value">@sli.Text</Blazorise.SelectItem>
                      }
                    </Blazorise.Select>
                  </td>
                  <td class="contain-select">
                    @*@Html.DropDownListFor(m => m.tripts[j].iTrainingRulesSmGr, model.tripts[j].sliTrainingRulesSmGr, new { @class = "form-horizontal ctrTrainingRules sctTrainingRulesSmGr", @onchange = "setTrainingRules(" + j + ")", @disabled = "disabled" })*@
                    <Blazorise.Select class="form-horizontal ctrTrainingRules sctTrainingRulesSmGr" SelectedValue="@tri.iTrainingRulesSmGr" SelectedValueChanged="@(e => setTrainingRulesSmGr(j, e))" TValue="int" Disabled="@bTrRuleDisabled[j]">
                      @foreach (LayoutModel.SelectListItem sli in tri.sliTrainingRulesSmGr) {
                        <Blazorise.SelectItem Value="@sli.Value">@sli.Text</Blazorise.SelectItem>
                      }
                    </Blazorise.Select>
                  </td>
                  <td>
                    @*@Html.EditorFor(Model => Model.tripts[j].fTrainingRulesValue, new { htmlAttributes = new { @class = "ctrTrainingRules iptTrainingRulesValue", @type = "tel", @style = "width: 40px; text-align: right", @onchange = "setTrainingRules(" + j + ")", @disabled = "disabled" } })*@
                    <input type="tel" style="width: 40px; text-align: right" @bind-value:event="onchange" @oninput="(e => setTrainingRulesValue(j, e))" @bind-value="tri.fTrainingRulesValue" disabled="@bTrRuleDisabled[j]">
                  </td>
                  <td>
                    %&nbsp;trainiere
                  </td>
                  <td class="contain-select">
                    @*@Html.DropDownListFor(m => m.tripts[j].iTrainingRulesType, model.tripts[j].sliTrainingRulesType, new { @class = "form-horizontal ctrTrainingRules sctTrainingRulesType", @onchange = "setTrainingRules(" + j + ")", @onkeyup = "setTrainingRules(" + j + ")", @disabled = "disabled" })*@
                    <Blazorise.Select class="form-horizontal ctrTrainingRules sctTrainingRulesType" SelectedValue="@tri.iTrainingRulesType" SelectedValueChanged="@(e => setTrainingRulesType(j, e))" TValue="int" Disabled="@bTrRuleDisabled[j]">
                      @foreach (LayoutModel.SelectListItem sli in tri.sliTrainingRulesType) {
                        <Blazorise.SelectItem Value="@sli.Value">@sli.Text</Blazorise.SelectItem>
                      }
                    </Blazorise.Select>
                  </td>
                </tr>

                i++;
              }
            }
          </table>
        </div>
      }
    </div>

