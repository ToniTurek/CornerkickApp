    <div id="teamlist" style="width: 100%">
      <h3>Kaderliste</h3>
      <div style="overflow: auto">
        <table class="b-table table table-striped table-sm b-datagrid table-bordered" style="white-space:nowrap">
          <thead>
            @if (bShowIndTr) {
              <tr style="font-size: 120%; color: gray">
                <th colspan="12" class="cursor-pointer text-center" style="border: 1px solid gray">Allgemeines</th>
                <th colspan="3" class="cursor-pointer text-center" style="border: 1px solid gray">Individuelles Training</th>
              </tr>
            }
            <tr>
              <th scope="col" class="cursor-pointer text-center" style="border-left: 1px solid gray">Nr</th>
              <th scope="col" class="cursor-pointer text-center"><div class="d-inline-flex">Name</div></th>
              <th scope="col" class="cursor-pointer text-center"><div class="d-inline-flex">HP</div></th>
              <th scope="col" class="cursor-pointer text-center"><div class="d-inline-flex">St.</div></th>
              <th scope="col" class="cursor-pointer text-center"><div class="d-inline-flex">Kondi.</div></th>
              <th scope="col" class="cursor-pointer text-center"><div class="d-inline-flex">Frische</div></th>
              <th scope="col" class="cursor-pointer text-center"><div class="d-inline-flex">Moral</div></th>
              <th scope="col" class="cursor-pointer text-center"><div class="d-inline-flex">Alter</div></th>
              <th scope="col" class="cursor-pointer text-center"><div class="d-inline-flex">Tal.</div></th>
              <th scope="col" class="cursor-pointer text-center"><div class="d-inline-flex">letztes Tr.</div></th>
              <th scope="col" class="cursor-pointer text-center"><div class="d-inline-flex">Hist.</div></th>
              <th scope="col" class="cursor-pointer text-center" style="border-right: 1px solid gray"><div class="d-inline-flex">Nat.</div></th>
              @if (bShowIndTr) {
                <th scope="col" class="cursor-pointer text-center"><div class="d-inline-flex">Typ</div></th>
                <th scope="col" class="cursor-pointer text-center"><div class="d-inline-flex"></div></th>
                <th scope="col" class="cursor-pointer text-center" style="border-right: 1px solid gray"><div class="d-inline-flex">Tal.</div></th>
              }
            </tr>
          </thead>
          <tbody>
            @if (ltTableTeam != null) {
              ltPlayerskillbuttons = new Templates.PlayerSkill[ltTableTeam.Count];
              int j = 0;
              foreach (TrainingModel.TableItem ti in ltTableTeam) {
                Templates.PlayerSkill psb = new Templates.PlayerSkill();
                psb.iPlayerId = ti.iId;
                <tr class="table-row-selectable">
                  <td hidden>@ti.iId</td>
                  <td style="text-align: end; border-left: 1px solid gray">@ti.iNb</td>
                  <td style="text-align: center">
                    <a href="/member/playerdetails/@ti.iId" style="text-decoration: none">@((MarkupString)ti.sName)</a>
                  </td>
                  <td style="text-align: center">@ti.sPosition</td>
                  <td style="text-align: center">@(ti.fSkill > 0f ? ti.fSkill.ToString("0.0") : "?")</td>
                  <td style="text-align: end">
                    <span style="color: @CornerkickApp.Controllers.Member.PlayerController.getColorFromValue(0, ti.fCondi)">
                      @((ti.fCondi * 100f).ToString("0.0"))
                    </span>
                  </td>
                  <td style="text-align: end">
                    <span style="color: @CornerkickApp.Controllers.Member.PlayerController.getColorFromValue(1, ti.fFresh)">
                      @((ti.fFresh * 100f).ToString("0.0"))
                    </span>
                  </td>
                  <td style="text-align: end">
                    <span style="color: @CornerkickApp.Controllers.Member.PlayerController.getColorFromValue(2, ti.fMoral)">
                      @((ti.fMoral * 100f).ToString("0.0"))
                    </span>
                  </td>
                  <td style="text-align: center">@ti.iAge</td>
                  <td style="text-align: center">@ti.fTalent.ToString("0.0")</td>
                  <td style="text-align: center">@ti.sTrLast</td>
                  <td>
                    <Blazorise.Button class="btn btn-outline-secondary" Clicked="@(() => showTrainingHist(ti.iId, ti.sName))">
                      <Blazorise.Icon Name="Blazorise.IconName.List" />
                    </Blazorise.Button>
                  </td>
                  <td style="text-align: center; border-right: 1px solid gray">@((MarkupString)Controllers.Tool.getNatIcon(ti.sNat))</td>
                  @if (bShowIndTr) {
                    <td>
                      <Blazorise.Select class="form-horizontal ctrTrainingRules sctTrainingRulesCFM" SelectedValue="@(ti.iIndTr)" SelectedValueChanged="@(i => setIndTraining(ti.iId, i))" TValue="int">
                        @foreach (LayoutModel.SelectListItem sli in CornerkickApp.Controllers.Member.PlayerController.getIndSkillsSelectList(ti.iId)) {
                          <Blazorise.SelectItem Value="@sli.Value">@sli.Text</Blazorise.SelectItem>
                        }
                      </Blazorise.Select>
                    </td>
                    <td>
                      @* Referenz mittels Lambda in die Liste schreiben *@
                      <CornerkickApp.Components.Pages.Templates.PlayerSkill @ref="ltPlayerskillbuttons[j++]"
                        usr="_usr" 
                        iPlayerId="ti.iId" 
                        iSkillIx="ti.iIndTr">
                      </CornerkickApp.Components.Pages.Templates.PlayerSkill>
                    </td>
                    <td style="text-align: center; border-right: 1px solid gray">@ti.iTalentIndTr</td>
                  }
                </tr>
              }
            }
          </tbody>
        </table>
