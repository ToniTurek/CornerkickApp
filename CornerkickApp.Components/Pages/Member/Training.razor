    await setTrainingRules(i, model.tripts[i].iTrainingRulesCFM, model.tripts[i].iTrainingRulesSmGr, model.tripts[i].fTrainingRulesValue, model.tripts[i].iTrainingRulesType);
  }

  protected async Task setTrainingRulesValue(int i, ChangeEventArgs args)
  {
    if (model == null) return;
    if (args.Value == null) return;
    float fValue;
    if (!float.TryParse(args.Value.ToString(), out fValue)) return;
    model.tripts[i].fTrainingRulesValue = fValue;
