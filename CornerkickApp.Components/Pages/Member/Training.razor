  protected async Task changeWeek(int iDeltaWeek)
  {
    if (iDeltaWeek == 0) iWeekGlobal = 0;
    else                 iWeekGlobal += iDeltaWeek;

    displaychart = iWeekGlobal == 0 ? "block" : "none";
    bDisableTemplateBtns = iWeekGlobal < 0;

    await GetTrainingPlan(iWeekGlobal);

    await ShowTutorial();
