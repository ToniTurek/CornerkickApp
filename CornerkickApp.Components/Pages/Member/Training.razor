  protected override async Task OnInitializedAsync()
  {
    //await base.OnInitializedAsync();

#if _WebApp
    //_usr = await Http.GetFromJsonAsync<CornerkickManager.User>("member/Member/ckUser");
    _usr = Controllers.Member.MemberController.ckUser(await _auth.GetUserId());
#else
    _usr = CkAppShared.ckMng.ltUser[CkAppShared.iUserActive];
#endif

    model = CornerkickApp.Controllers.Member.TrainingController.Model(_usr);
    if (model != null) {
      iWeekGlobal = model.iWeekIni;

      bShowIndTr = _usr != null && _usr.iResp >= CkAppShared.iUserRespPlayerIndTraining;

      float fCondiMin = 1f;
      float fCondiMax = 0f;
      float fFreshMin = 1f;
      float fFreshMax = 0f;
      float fMoralMin = 1f;
      float fMoralMax = 0f;
      foreach (CornerkickManager.PlayerTool.Training tr in CkAppShared.ckMng.plt.ltTraining) {
        if (tr.iId < 0) continue;

        if (tr.fCondi > 0f) fCondiMin = Math.Min(fCondiMin, tr.fCondi);
        fCondiMax = Math.Max(fCondiMax, tr.fCondi);
        fFreshMin = Math.Min(fFreshMin, tr.fFresh);
        fFreshMax = Math.Max(fFreshMax, tr.fFresh);
        fMoralMin = Math.Min(fMoralMin, tr.fMoral);
        fMoralMax = Math.Max(fMoralMax, tr.fMoral);
      }

      foreach (CornerkickManager.PlayerTool.Training tr in CkAppShared.ckMng.plt.ltTraining) {
        if (tr.iId < 0) continue;

        Cl cl = new Cl() { iId = tr.iId };
        if (tr.fCondi > 0f) {
          int iCl = (int)((192 * (tr.fCondi - fCondiMin)) / (fCondiMax - fCondiMin));
          cl.sCl = "rgb(255," + iCl.ToString() + "," + iCl.ToString() + ")";
        } else {
          int iCl = (int)((128 * (tr.fFresh - fFreshMin)) / (fFreshMax - fFreshMin));
          cl.sCl = "rgb(" + (128 - iCl).ToString() + "," + (128 - iCl).ToString() + ",255)";
        }

        int iCl2 = (int)((128 * (tr.fMoral - fMoralMin)) / (fMoralMax - fMoralMin));
        cl.sCl2 = "rgb(255," + (128 + iCl2).ToString() + ",0)";

        ltCls.Add(cl);
      }

      await GetTrainingPlan(model.iWeekIni);
      if (model.iWeekIni == 0) await GetTeamDevelopmentData();
      await GetTableTeam();
      await enableTrainingRules();
#if _WebApp
    } else {
      NavigationManager.NavigateTo("/authentication/register");
#endif
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
