    await setTrainingRules(i, model.tripts[i].iTrainingRulesCFM, model.tripts[i].iTrainingRulesSmGr, model.tripts[i].fTrainingRulesValue, model.tripts[i].iTrainingRulesType);
  }

  protected async Task setTrainingRules(int i, int iCFM, int iSmGr, float fValue, int iType)
  {
    CornerkickApp.Controllers.Member.TrainingController.TrainingSetTrainingRule(_usr, i, iCFM, iSmGr, fValue, iType);
    await enableTrainingRules();
  }

  private async Task enableTrainingRules()
  {
    if (model == null) return;
    for (int i = 0; i < bTrRuleDisabled.Length - 1; i++) {
      bTrRuleDisabled[i + 1] = model.tripts[i].fTrainingRulesValue < 0.001f;
    }
  }

