  private async Task setRenewPitchStr()
  {
    float[] f = Controllers.Member.StadiumController.GetRenewPitchCost(_usr);

    sRenewPitch = "";
    if (!bMobile) sRenewPitch = "Rasen ";
    sRenewPitch += "+" + f[0].ToString("0%") + ", ";
    if (!bMobile) sRenewPitch += "Kosten: ";
    sRenewPitch += f[1].ToString("N0") + "€";
  }

  private async Task renewPitch()
  {
    if (model == null) return;

    CornerkickManager.Club? clb = Controllers.Member.MemberController.ckClub(_usr);
    if (clb == null) return;
    int iBalanceStart = clb.iBalance;

    string sMsg;
    float fPitchQualityNew = Controllers.Member.StadiumController.RenewPitch(_usr, out sMsg);

    if (fPitchQualityNew > 0f) {
      model.fPitchQuality = fPitchQualityNew;
      await setRenewPitchStr();
      MainLayout.headline.Refresh(clb, iBalanceStart: iBalanceStart);

      //await InvokeAsync(StateHasChanged);
      if (!string.IsNullOrEmpty(sMsg) && MainLayout.ckToast != null) {
        MainLayout.toastMessage = sMsg;
        await MainLayout.ckToast.Show();
      }
    }
  }

  private async Task changeSeats(object o)
  {
    int iS;
    if (!int.TryParse(o.ToString(), out iS)) return;

    iSeatsCct = iS;

    await getBlockBuildCost();
  }

  private async Task changeBlockType(object o)
  {
    byte iBt;
    if (!byte.TryParse(o.ToString(), out iBt)) return;

    iTypeCct = iBt;

    await getBlockBuildCost();
  }

  private async Task changeBlockRoof(object o)
  {
    bool bRoof;
    if (!bool.TryParse(o.ToString(), out bRoof)) return;

    bRoofCct = bRoof;

    await getBlockBuildCost();
  }

  private async Task getBlockBuildCost()
  {
    if (model == null) return;

    int[]? i = Controllers.Member.StadiumController.GetBuildCost(_usr, iCctBlock, iSeatsCct, iTypeCct, bRoofCct);

    if (i != null) {
      sCctButton = "Block ausbauen";
      if (i[2] < 0) {
        sCctButton += ": Maximale Anzahl Plätze: " + i[0].ToString("N0");
      } else {
        sCctButton += ": Kosten: " + i[0].ToString("N0") + " €, Dauer: " + i[1].ToString() + " Tage";

        if (i[1] == 0 || i[1] == 0 || i[2] == 0) {
          if (i[2] == 0) sCctButton = ". Zu wenig Geld!";
          bCctButtonDisabled = true;
        } else {
          bCctButtonDisabled = false;
        }
      }
    }
  }

  private async Task buildBlock()
  {
    if (model == null) return;

    CornerkickManager.Club? clb = Controllers.Member.MemberController.ckClub(_usr);
    if (clb == null) return;
    int iBalanceStart = clb.iBalance;

    string sMsg;
    int i = Controllers.Member.StadiumController.BuildBlock(_usr, iCctBlock, iSeatsCct, iTypeCct, bRoofCct, out sMsg);

    if (i > 0) {
      model.blocks[iCctBlock].iSeats = iSeatsCct;
      model.blocks[iCctBlock].iType  = iTypeCct;
      model.blocks[iCctBlock].iSeatsDaysConstruct    = i;
      model.blocks[iCctBlock].iSeatsDaysConstructIni = i;
      sCctButton = "Block ausbauen";
      bConstructionMode = false;
      bCctButtonDisabled = true;
      model.iSeatsConstr[iTypeCct] += iSeatsCct;
      setCctValues();
      await InvokeAsync(StateHasChanged);

      await JS.InvokeAsync<string>("PlaySound", "construction");
      MainLayout.headline.Refresh(clb, iBalanceStart: iBalanceStart);

      //await InvokeAsync(StateHasChanged);
      if (!string.IsNullOrEmpty(sMsg) && MainLayout.ckToast != null) {
        MainLayout.toastMessage = sMsg;
        await MainLayout.ckToast.Show();
      }
    }
  }

