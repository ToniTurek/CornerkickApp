  private async Task showInfo(int iType)
  {
    if (model == null) return;
    if (mlInfo == null) return;

    sInfoHeader = "";
    sInfoBuild = "";

    iInfoType = iType;

    if (iType == 0) {
      sInfoHeader = CornerkickManager.Stadium.facVideo.sName;
      if (model.iVideo + 1 < CornerkickManager.Stadium.facVideo.sLevelNames.Length) {
        sInfoBuild = CornerkickManager.Stadium.facVideo.sLevelNames[Math.Max(iVideoNew, model.iVideo + 1)];
      }
    } else if (iType == 1) {
      sInfoHeader = CornerkickManager.Stadium.facSecurity.sName;
      if (model.iSecurity + 1 < CornerkickManager.Stadium.facSecurity.sLevelNames.Length) {
        sInfoBuild = CornerkickManager.Stadium.facSecurity.sLevelNames[model.iSecurity + 1];
      }
    } else if (iType == 2) {
      sInfoHeader = "Imbissbuden";
    } else if (iType == 3) {
      sInfoHeader = "Toiletten";
    }

    await mlInfo.Show();
  }

