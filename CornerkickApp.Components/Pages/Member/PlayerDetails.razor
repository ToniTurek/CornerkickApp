  private SpiderData[] getSpiderGraphData(int iPlSdId)
  {
    List<SpiderData> ltSpiderData = new List<SpiderData>();
    foreach (byte iSC in CornerkickGame.Game.iSkillCategorys) {
      if (iSC == CornerkickGame.Game.iSkillCategoryIxCharacter) continue;
      if (CornerkickGame.Game.iSkillsOfCategory[iSC] == null) continue;

      float fSkillAveCat = 0f;
      int nSkills = 0;
      foreach (byte iS in CornerkickGame.Game.iSkillsOfCategory[iSC]) {
        float f = PlayerController.getScoutedSkillAve(_clb, iPlSdId, iS);
        if (f > 0f) {
          fSkillAveCat += f;
          nSkills++;
        }
      }
      ltSpiderData.Add(new SpiderData() {
        Feature = CornerkickManager.Names.sSkillCategorys != null && iSC < CornerkickManager.Names.sSkillCategorys.Length ? CornerkickManager.Names.sSkillCategorys[iSC] : "?",
        Skill = nSkills > 0 ? (fSkillAveCat / nSkills) * 10.0 : 0.0
      });
    }
    return ltSpiderData.ToArray();
  }

