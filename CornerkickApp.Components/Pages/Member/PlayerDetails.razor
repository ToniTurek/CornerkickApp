                            <th style="text-align: center" hidden>Eff.*</th>
                            <th style="text-align: center">Training</th>
                            <th style="text-align: center">Ind.</th>
                          }
                        </tr>
                      </thead>
                      <tbody>
                        @{
                          if (model?.sSkillTable != null) {
                            int i = 0;
                            foreach (string[] sSkill in model.sSkillTable) {
                              int jSkillIx;
                              if (!int.TryParse(sSkill[0], out jSkillIx)) continue;

                              <tr>
                                @{
                                  <td hidden class="td_skill_ix">@sSkill[0]</td>

                                  int iRowSpan = 1;
                                  if (!string.IsNullOrEmpty(sSkill[1])) {
                                    while (i + iRowSpan < model.sSkillTable.Length && string.IsNullOrEmpty(model.sSkillTable[i + iRowSpan][1])) {
                                      iRowSpan++;
                                    }

                                    <td align="center" rowspan=@iRowSpan.ToString() title="@sSkill[1]" style="vertical-align: middle">
                                      @{ string sSkillIcon = CornerkickApp.Shared.Models.CkAppShared.sContentDir + "/Icons/skills/" + sSkill[8] + ".png"; }
                                      <img width="24" src=@sSkillIcon />
                                    </td>
                                    <td align="center" rowspan=@iRowSpan.ToString() style="font-size: 1em; vertical-align: middle">@sSkill[2]</td>
                                  }
                                }

                                @{
                                  string sColor = "";
                                  if (i == 0 || i == 2) {
                                    sColor = "color: grey";
                                  }
                                }

                                <td align="center" style="@sColor">@sSkill[3]</td>
                                <td class="td_skill" align="center" style="@sColor">
                                  <CornerkickApp.Components.Pages.Templates.PlayerSkill @ref="skillButton" usr="_usr" iPlayerId="iId" iSkillIx="Convert.ToInt32(sSkill[0])" ActDeleteScoutingData="() => getSkillAve()"></CornerkickApp.Components.Pages.Templates.PlayerSkill>
                                </td>
                                @{
                                  if ((model.bOwnPlayer && !model.bNation && iUserRespLevel >= CkAppShared.iUserRespPlayerIndTraining) || model.bAdmin) {
                                    <td align="right">@sSkill[6]</td>
                                    if (i == 0 || i == 2) {
                                      <td></td>
                                    } else {
                                      <td align="center">
                                        <Blazorise.Radio Value="@(jSkillIx)"></Blazorise.Radio>
                                      </td>
                                    }
                                    if (!model.bScouting || model.bAdmin) {
                                      <td align="right">@sSkill[7]</td>
                                    }
                                  }
                                }
                              </tr>

                              i++;
                            }
                          }
                        }
                      </tbody>
                    </table>
                  </Blazorise.RadioGroup>
                  <p style="margin: 0">* Effektiver Wert</p>
                  <p style="margin: 0">abh. z.B. von Frische, Moral und akt. Pos.</p>
                </div>

                @if (dataSpiderChart != null) {
                  <div style="width: 400px; height: fit-content; display: flex; justify-content:center">
                    <RadzenSpiderChart Style="width: 320px; height: 320px;">
                      <RadzenSpiderLegend Visible="false" />
                      <RadzenSpiderSeries TItem="SpiderData"
                                          Data="@dataSpiderChart"
                                          CategoryProperty="@nameof(SpiderData.Feature)"
                                          ValueProperty="@nameof(SpiderData.Skill)"
                                          ValueFormatter="@GetValueFormatter()"
                                          Title="@(dataSpiderChart2 != null && plCompare != null ? model.sName : "")" />
                      @if (dataSpiderChart2 != null && plCompare != null) {
                        <RadzenSpiderSeries TItem="SpiderData"
                                            Data="@dataSpiderChart2"
                                            CategoryProperty="@nameof(SpiderData.Feature)"
                                            ValueProperty="@nameof(SpiderData.Skill)"
                                            ValueFormatter="@GetValueFormatter()"
                                            Title="@plCompare.plGame.sName" />
                      }
                    </RadzenSpiderChart>
                  </div>
                }
              </div>
            </div>

            <div>
              @*
              Scouts
              *@
              @if (model.bScouting && model.ltScouts != null && model.ltScouts.Count > 0) {
                <div style="position: relative; width: auto; height: auto; display: inline-grid; margin-bottom: 20px; margin-right: 20px">
                  <h4>Scouts</h4>
                  <div id="divScouts" style="position: relative; display: flex; flex-direction:column; flex-wrap:nowrap">
                    @foreach (PlayerModel.Scout scout in model.ltScouts) {
                      <button type="button" class="btn btn-outline-secondary" style="display: flex; position: relative; width: 100%; margin-top: 6px; text-align: left;" @onclick="(() => scoutPlayer(scout.iId))" disabled="@(scout.iMinActive > 0)">
                        <img src="@CornerkickApp.Shared.Models.CkAppShared.sContentDir/Icons/menu/binoculars.svg" width="48" height="48" style="margin-right: 10px;">
                          <div>
                            <p style="margin: 0px;">@(scout.sName + " (Level: " + scout.iSkill.ToString() + ", n: " + scout.nDataPerScouting.ToString() + ")")</p>
                            <p style="margin: 0px;">
                              @if (scout.iMinActive < 0) {
                                <img src="@CornerkickApp.Shared.Models.CkAppShared.sContentDir/Icons/news/coins.png" width="24" height="24" style="margin-right: 10px;">
                                <span>@scout.sCost</span>
                              } else {
                                <Blazorise.Icon Name="Blazorise.IconName.Clock" />
                                if (scout.iMinActive > 0) {
                                  <span style="flex: 1 1 0%; text-align: right; white-space: nowrap; margin-left: 6px;">@(TimeSpan.FromMinutes(scout.iMinActive).ToString())</span>
                                } else {
                                  <span style="flex: 1 1 0%; text-align: right; white-space: nowrap; margin-left: 6px;">verfügbar</span>
                                }
                              }
                            </p>
                          </div>
                      </button>
                    }
                  </div>
                </div>
              }
