  string FormatAsStr(object value)
  {
    string[] sNames = new string[] { "Kondition", "Frische", "Moral" };
    if (value != null) {
      int iVal = Convert.ToInt32(value);
      if (iVal >= 0 && iVal < sNames.Length) return sNames[iVal];
    }

    return string.Empty;
  }

  string FormatAsDate(object value)
  {
    if (value != null) {
      if (DateTime.TryParse(value.ToString(), out DateTime dt)) return dt.ToString("dd.MM.yy");
      if (int.TryParse(value.ToString(), out int i)) return i.ToString();
      //return Convert.ToDateTime(value).ToString("dd.MM.yy");
    }

    return string.Empty;
  }

  Func<double, string> GetValueFormatter()
