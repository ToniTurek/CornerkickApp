@page "/member/playerdetails/{id}"

@using System.Text.Json
@using System.Text.Json.Serialization
@using CornerkickApp.Controllers.Member
@using CornerkickApp.Components.Shared.Components
@using CornerkickApp.Shared.Models

@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject Controllers.Shared.MyAuthenticationStateProvider _auth

<PageTitle>Spielerdetails</PageTitle>

<!DOCTYPE html>
<html>
<head>
  <style>
    div.form-check-inline {
      margin-right: 0px;
    }

    .table .compact>:not(caption)>*>* {
      padding: 0.25rem;
    }

    /* Radzen inputs */
    .rz-inputtext {
      font-size: 1rem;
      color: black;
    }
  </style>
</head>

<body>
  @if (model != null) {
    @if (model.iPlPrevId >= 0 || model.iPlNextId >= 0) {
      <div style="position: relative; width: 100%; display: flex; justify-content: space-between">
        @{
          string sPlPrevName = "";
          if (model.iPlPrevId >= 0) {
            sPlPrevName = "<<   " + model.sPlPrevName;
            <a href="/member/playerdetails/@model.iPlPrevId" style="text-decoration: none" @onclick="@(() => NavigationManager.NavigateTo("/member/playerdetails/" + @model.iPlPrevId.ToString(), forceLoad: true))">@sPlPrevName</a>
          } else {
            <div></div>
          }

          string sPlNextName = "";
          if (model.iPlNextId >= 0) {
            sPlNextName = model.sPlNextName + "   >>";
            <a href="/member/playerdetails/@model.iPlNextId" style="text-decoration: none" @onclick="@(() => NavigationManager.NavigateTo("/member/playerdetails/" + @model.iPlNextId.ToString(), forceLoad: true))">@sPlNextName</a>
          }
        }
      </div>
    }
    <div style="position: relative; width: 100%; margin-top: 4px; display: flex">
      <div style="position: relative; height: fit-content">
        @if (!model.bJouth && _clb != null) {
          int iNb = model.iNo;
          if ((model.bOwnPlayer && (model.iNo < 1 || model.bSeasonStart)) || model.bAdmin) iNb *= -1;
          <CornerkickApp.Components.Pages.Templates.Jersey iClubId="_clb.iId" iSet="0" iPlayerId="iId" iNb="iNb" ltNbFree="model.ltNo" NumberChanged="(i) => setNumber(i)"></CornerkickApp.Components.Pages.Templates.Jersey>
        }
      </div>

      <div>
        <div style="width: @(iStarsRadiusPx)px; height: 84px">
          <div style="position: absolute; width: @(iStarsRadiusPx)px; height: 84px; text-align: center">
            <text style="position: absolute; top: 22px; left: 0px; width: 100%; font-size: 10px">@model.sPos</text>
            <b id="txtAveSkill" style="position: absolute; top: 26px; left: 0px; font-size: 26px; width: 100%">@(fSkillAve > 0f ? fSkillAve.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) : "?")</b>
            <text style="position: absolute; top: 54px; left: 0px; width: 100%; font-size: 10px">@model.iAge.ToString()</text>
            @rfStars
          </div>
        </div>

        @{
          if ((model.bOwnPlayer && (model.bEditable || model.bJouth)) || model.bAdmin) {
            <div class="form-group">
              @* @Html.TextBoxFor(m => m.sName, new { @class = "form-control", @onChange = "setName()", @style = "width:180px" }) *@
              <input type="text" class="form-control" style="width:180px" value="@model.sName" @onchange=@((s) => setName(s.Value.ToString()))>
            </div>
          } else {
            <div style="position: relative; width: 100%; font-size: 28px">
              <text>@model.sName</text>

              @if (plCompare != null && plCompare.plGame.iId != iId) {
                <span> / </span>
                <span style="color: #64dfdf">@plCompare.plGame.sName</span>
              }
            </div>
          }
        }
      </div>
    </div>

    <div style="position: absolute; top: 24px; height: fit-content; right: 0px; display: flex; flex-direction: column; align-items: end">
      <div style="max-width: 128px; border-style: outset; border-width: 3px; border-color: lightgray">
        @{
          void RenderImg()
          {
            <div class="portrait">
              @*<img style="height: 100%; object-fit: contain" src="@model.sPortrait" />*@
              @((MarkupString)model.sPortrait)
            </div>
          }
#if _WebApp
        if (model.bOwnPlayer) {
          <form asp-controller="Member" asp-action="PlayerDetails" asp-route-i="@id" method="post" enctype="multipart/form-data">
            <div class="portrait" style="cursor: pointer">@((MarkupString)model.sPortrait)</div>
            <input id="fileInput" name="file" type="file" accept="image/*" style="position: absolute; left: 0px; display: none" onchange="this.form.submit();">
          </form>
        } else {
#endif
          RenderImg();
#if _WebApp
        }
#endif
        }
      </div>

      @if (plCompare == null) {
        <button class="btn btn-outline-secondary" style="width: 100%" @onclick="MarkForCompare">merken</button>
      } else if (plCompare.plGame.iId == iId) {
        <p>zum Vergl. gemerkt</p>
      } else {
        <button class="btn btn-outline-secondary" style="width: 100%" @onclick="DeleteCompare">Vergl. beenden</button>
      }
    </div>

    <div class="scroll-anchor" id="div_top"></div>
    <Blazorise.Tabs SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged">
      <Items>
        <Blazorise.Tab Style="@CkAppShared.sCssStyleClubColors" Name="tabOverview">Überblick</Blazorise.Tab>
        <Blazorise.Tab Style="@CkAppShared.sCssStyleClubColors" Name="tabSkills">Fähigkeiten</Blazorise.Tab>
        <Blazorise.Tab Style="@CkAppShared.sCssStyleClubColors" Name="tabStatistic" hidden="@(iUserRespLevel < CkAppShared.iUserRespPlayerStatistic)">Statistik</Blazorise.Tab>
      </Items>
      <Content>
        <Blazorise.TabPanel Name="tabOverview">
          <div id="tabs-1" style="margin-top: 1rem; overflow: auto">
            <div style="position: absolute; width: 10%; right: 10px">
              <div id="divEmblemClub" style="position: relative; width: 100%; border-style: outset; border-width: 3px; border-color: lightgray">@((MarkupString)model.sEmblem)</div>
            </div>

            <div style="position: relative; width: 100%; height: auto">
              <div style="position: relative; margin-right: 20px; margin-bottom: 20px; display: inline-grid">
                <div style="position: absolute; top: 0px; right: 0px; width: auto; height: 40px; text-align: right">
                  @if (!string.IsNullOrEmpty(model.sInjury)) {
                    <img src="@CornerkickApp.Shared.Models.CkAppShared.sContentDir/Icons/ambulance.png" title="@model.sInjury" style="position: relative; width: 16px; margin-left: 4px" />
                  }
                  @if (model.bCaptain) {
                    <img src="@CornerkickApp.Shared.Models.CkAppShared.sContentDir/Icons/captain.png" alt="Kapitän" title="Kapitän" style="position: relative; width: 24px; margin-left: 4px" />
                  } else if (model.bCaptain2) {
                    <img src="@CornerkickApp.Shared.Models.CkAppShared.sContentDir/Icons/captain2.png" alt="Vize-Kapitän" title="Vize-Kapitän" style="position: relative; width: 24px; margin-left: 4px" />
                  }

                  @{
                    string sFlag = CornerkickApp.Shared.Models.CkAppShared.sContentDir + "/Icons/flags/" + model.sNat1 + ".png";
                  }
                  <img src=@sFlag alt=@model.sNat1 title=@model.sNat1 style="position: relative; width: 24px; margin-left: 4px" />
                </div>

                <h4>Allgemeine Daten</h4>
                <table class="table table-bordered" cellpadding="0" style="width: 100%">
                  <tbody>
                    <tr>
                      <td align="right">Verein:</td>
                      <td align="right">@model.sClub</td>
                    </tr>
                    <tr>
                      <td align="right">Geburtsdatum:</td>
                      <td align="right">@model.sBirthday</td>
                    </tr>
                    <tr>
                      <td align="right">Körpergröße/-gewicht:</td>
                      <td align="right">@model.sHeightWeight</td>
                    </tr>
                    <tr>
                      <td align="right">Positionen:</td>
                      <td align="right">@model.sPos</td>
                    </tr>
                    <tr>
                      <td align="right">Stärke (bereinigt):</td>
                      <td id="tdAveSkill" align="right">@(fSkillAve > 0f ? fSkillAve.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) : "?")</td>
                    </tr>
                    <tr>
                      <td align="right">Talent:</td>
                      <td align="right">@model.fTalentAve.ToString("0.0")</td>
                    </tr>
                    <tr>
                      <td align="right">Fuß (links/rechts):</td>
                      @{
                        <td align="right">
                          @model.sFoot
                          <button type="button" class="btn btn-outline-secondary" style="margin-left: 6px" @onclick="openPassChart">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pie-chart-fill" viewBox="0 0 16 16">
                              <path d="M15.985 8.5H8.207l-5.5 5.5a8 8 0 0 0 13.277-5.5zM2 13.292A8 8 0 0 1 7.5.015v7.778l-5.5 5.5zM8.5.015V7.5h7.485A8.001 8.001 0 0 0 8.5.015z"></path>
                            </svg>
                          </button>
                        </td>
                      }
                    </tr>
                    <tr>
                      <td align="right">Verletzung:</td>
                      @{
                        if (!string.IsNullOrEmpty(model.sInjury)) {
                          <td align="right">@model.sInjury</td>
                        } else {
                          <td align="right">keine</td>
                        }
                      }
                    </tr>
                    <tr>
                      <td align="right">Marktwert:</td>
                      <td align="right">@model.sValue</td>
                    </tr>
                  </tbody>
                </table>

                <div style="position: relative; width: 100%">
                  <div style="position: relative; top: 0px; width: 49%; display: inline-grid">
                    <table class="table table-bordered">
                      <thead>
                        <tr>
                          <td colspan="2" align="center">
                            Sperren
                            <i style="position: absolute; left: 8px; margin-right: 4px"><img src="@CornerkickApp.Shared.Models.CkAppShared.sContentDir/Icons/rCard.png" style="position: relative; width: 16px" /></i>
                          </td>
                        </tr>
                      </thead>

                      <tbody>
                        @{
                          if (model.iSuspension[0] + model.iSuspension[1] + model.iSuspension[2] + model.iSuspension[3] + model.iSuspension[4] + model.iSuspension[6] == 0) {
                            <tr>
                              <td colspan="2" align="center">keine</td>
                            </tr>
                          } else {
                            if (model.iSuspension[0] > 0) {
                              string sSp = model.iSuspension[0].ToString() + " Spiele";
                              <tr>
                                <td align="right">Liga</td>
                                <td align="center">@sSp</td>
                              </tr>
                            }
                            if (model.iSuspension[1] > 0) {
                              string sSp = model.iSuspension[1].ToString() + " Spiele";
                              <tr>
                                <td align="right">Pokal</td>
                                <td align="center">@sSp</td>
                              </tr>
                            }
                            if (model.iSuspension[2] + model.iSuspension[3] > 0) {
                              string sSp = (model.iSuspension[2] + model.iSuspension[3]).ToString() + " Spiele";
                              <tr>
                                <td align="right">Int.</td>
                                <td align="center">@sSp</td>
                              </tr>
                            }
                            if (model.iSuspension[4] > 0) {
                              string sSp = model.iSuspension[4].ToString() + " Spiele";
                              <tr>
                                <td align="right">Testsp.</td>
                                <td align="center">@sSp</td>
                              </tr>
                            }
                            if (model.iSuspension[6] > 0) {
                              string sSp = model.iSuspension[6].ToString() + " Spiele";
                              <tr>
                                <td align="right">Nat</td>
                                <td align="center">@sSp</td>
                              </tr>
                            }
                          }
                        }
                      </tbody>
                    </table>
                  </div>

                  <div style="position: relative; top: 0px; width: 49%; right: 0px; display: inline-grid">
                    <table class="table table-bordered" id="tblDoping">
                      <thead>
                        <tr>
                          <td colspan="2" style="text-align: center;">Doping<i style="position: absolute; left: 8px; margin-right: 4px;"><img src="@CornerkickApp.Shared.Models.CkAppShared.sContentDir/Icons/doping.png" style="width: 24px;"></i></td>
                        </tr>
                      </thead>
                      <tbody>
                        @if (model.fDoping != null && model.fDoping.Length > 3) {
                          <tr>
                            <td style="text-align: right">Mittel:</td>
                            <td style="text-align: right; white-space: nowrap">@model.sDopingName</td>
                          </tr>
                          <tr>
                            <td style="text-align: right">Kondition:</td>
                            <td style="text-align: right">@model.fDoping[0].ToString("+0.0%;-0.0%;+0%")</td>
                          </tr>
                          <tr>
                            <td style="text-align: right">Rest:</td>
                            <td style="text-align: center">
                              <div style="display: flex; align-items: center; justify-content: center">
                                <Blazorise.Progress Value="(int)(100 * model.fDoping[1])" Animated Striped Color="Blazorise.Color.Danger" Style="width: 100%; height: 24px; background-color: white" />
                                <span style="position: absolute">@(model.fDoping[1].ToString("0.0%"))</span>
                              </div>
                            </td>
                          </tr>
                          <tr>
                            <td style="text-align: right">Reduktion:</td>
                            <td style="text-align: right">@model.fDoping[2].ToString("0.0%")/d</td>
                          </tr>
                          <tr>
                            <td style="text-align: right">Akt. Det.-Risiko:</td>
                            <td style="text-align: right">@model.fDoping[3].ToString("0.0%")</td>
                          </tr>
                        } else {
                          <tr>
                            <td colspan="2" style="text-align: center">keins</td>
                          </tr>
                        }
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>

              <div style="position: relative; margin-right: 20px; margin-bottom: 20px; display: inline-grid">
                @if (model.sCharacter != null) {
                  <h4>Charakter</h4>
                  <table class="table table-bordered" cellpadding="0" style="width: 100%; margin-bottom: 20px">
                    <tbody>
                      <tr>
                        <td align="right">Führungspersönlichkeit:</td>
                        <td align="right">@model.sCharacter[0]</td>
                      </tr>
                      <tr>
                        <td align="right">Schußhäufigkeit:</td>
                        <td align="right">@model.sCharacter[1]</td>
                      </tr>
                      <tr>
                        <td align="right">Teamplayer:</td>
                        <td align="right">@model.sCharacter[2]</td>
                      </tr>
                      <tr>
                        <td align="right">Dribbler:</td>
                        <td align="right">@model.sCharacter[3]</td>
                      </tr>
                      <tr>
                        <td align="right">Flexibilität:</td>
                        <td align="right">@model.sCharacter[4]</td>
                      </tr>
                      <tr>
                        <td align="right">Robustheit:</td>
                        <td align="right">@model.sCharacter[5]</td>
                      </tr>
                      <tr>
                        <td align="right">Gemüt:</td>
                        <td align="right">@model.sCharacter[6]</td>
                      </tr>
                      <tr>
                        <td align="right">Geldgier:</td>
                        <td align="right">@model.sCharacter[7]</td>
                      </tr>
                    </tbody>
                  </table>
                }

                @if (model.bOwnPlayer && iUserRespLevel >= CkAppShared.iUserRespPlayerContractsFast) {
                  <h4>Vertrag</h4>
                  <table class="table table-bordered" cellpadding="0" style="width: 100%">
                    <tbody>
                      @if (model.contract != null && model.contract.iLength > 0) {
                        <tr>
                          <td align="right">Gehalt:</td>
                          <td align="right">@model.contract.iSalary.ToString("N0") €</td>
                        </tr>
                        if ((!model.bJouth || model.bJouthWithContract) && iUserRespLevel >= CkAppShared.iUserRespPlayerContractsExpert) {
                          <tr>
                            <td align="right">Auflaufprämie:</td>
                            <td align="right">@model.contract.iPlay.ToString("N0") €</td>
                          </tr>
                          <tr>
                            <td align="right">Punkteprämie:</td>
                            <td align="right">@model.contract.iPoint.ToString("N0") €</td>
                          </tr>
                          <tr>
                            <td align="right">Torprämie:</td>
                            <td align="right">@model.contract.iGoal.ToString("N0") €</td>
                          </tr>
                          if (model.contract.ltCupBonus != null) {
                            foreach (CornerkickManager.Player.Contract.CupBonus cb in model.contract.ltCupBonus) {
                              if (cb.cup != null) {
                                <tr>
                                  <td align="right">@cb.cup.sName (Pl.):</td>
                                  <td align="right">@cb.iValue.ToString("N0") € (@cb.iPlace.ToString())</td>
                                </tr>
                              }
                            }
                          }
                          <tr>
                            <td align="right">Fixe Ablöse:</td>
                            <td align="right">@model.contract.iFixTransferFee.ToString("N0") €</td>
                          </tr>
                        }
                        <tr>
                          @{
                            string sDauer = model.contract.iLength.ToString() + " Jahre";
                            if (model.contract.iLength == 1) {
                              sDauer = "Saisonende";
                            }

                            if (model.bRetire) {
                              sDauer += " (beendet Karriere)";
                            }
                          }
                          <td align="right">Laufzeit:</td>
                          <td align="right">@sDauer</td>
                        </tr>
                        if (model.bOwnPlayer && !model.bJouth && !model.bNation) {
                          <tr>
                            <td align="right">Zufriedenheit:</td>
                            @if (model.fContractHappyFactor < 0.5) {
                              <td align="right" style="color: red">@model.fContractHappyFactor.ToString("0.0%")</td>
                            } else if (model.fContractHappyFactor < 0.75) {
                              <td align="right" style="color: orange">@model.fContractHappyFactor.ToString("0.0%")</td>
                            } else {
                              <td align="right" style="color: green">@model.fContractHappyFactor.ToString("0.0%")</td>
                            }
                          </tr>
                        }
                      } else {
                        <tr>
                          <td align="right">-</td>
                        </tr>
                      }
                      @if (!string.IsNullOrEmpty(model.sClubNextSeason)) {
                        <tr>
                          <td align="right">Verein nächste Saison:</td>
                          <td align="right">@model.sClubNextSeason</td>
                        </tr>
                      }
                    </tbody>
                  </table>
                }
              </div>

              <div style="position: relative; height: auto; width: 300px; margin-right: 20px; margin-bottom: 20px; display: inline-grid">
                @if ((model.bOwnPlayer && !model.bNation) || model.bAdmin) {
                  <div style="position: relative; height: 340px; width: 100%; margin-bottom: 20px; display: inline-grid">
                    <h4>Konstitution</h4>
                    <div id="divChartCFM" style="position: relative; width: 100%; height: 310px">
                      @if (data_CFM != null && data_CFM.Length > 0) {
                        <RadzenRow Style="height:100%">
                          <RadzenChart>
                            @*
                            <RadzenStackedColumnSeries Data="@data_CFM" CategoryProperty="x" ValueProperty="y" Fills="@(new[] {"red", "#00BFFF", "gold"})">
                              <TooltipTemplate Context="data">
                                @data.z
                              </TooltipTemplate>
                            </RadzenStackedColumnSeries>
                            *@
                            @{
                              double fMax = 1.0;
                              if (data_CFM     != null && data_CFM    .Length > 2 && data_CFM    [2].Y.HasValue) fMax = Math.Max(data_CFM    [2].Y.Value, fMax); // Moral
                              if (data_CFM_max != null && data_CFM_max.Length > 0 && data_CFM_max[0].Y.HasValue) fMax = Math.Max(data_CFM_max[0].Y.Value, fMax); // Doping condi.
                              if (fMax > 1.0) fMax = Math.Ceiling(fMax * 4.0) / 4.0;
                              string[] sFills = new[] { "red", "#00BFFF", "gold" };
                              for (int i = 0; i < data_CFM.Length; i++) {
                                <RadzenStackedColumnSeries Data="@([data_CFM[i]])" CategoryProperty="X" ValueProperty="Y" Fill="@(sFills[i])">
                                  <TooltipTemplate Context="data">
                                    @data.Z
                                  </TooltipTemplate>
                                </RadzenStackedColumnSeries>
                              }
                            }
                            <RadzenStackedColumnSeries Data="@data_CFM_max" CategoryProperty="X" ValueProperty="Y" Fill="#FFB6C1">
                              <TooltipTemplate Context="data">
                                @data.Z
                              </TooltipTemplate>
                            </RadzenStackedColumnSeries>
                            <RadzenColumnOptions Radius="5" Width="40" />
                            <RadzenCategoryAxis Visible="true">
                              <RadzenGridLines Visible="true" Stroke="#ccc" LineType="Radzen.Blazor.LineType.Dashed" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis FormatString="{0:P0}" Min="0" Max="@fMax" Step="0.25">
                              <RadzenGridLines Visible="true" StrokeWidth="2" />
                            </RadzenValueAxis>
                            <RadzenLegend Visible="false" />
                          </RadzenChart>
                        </RadzenRow>
                      }
                    </div>
                  </div>
                }

                <div id="divPlOptionsContainer" style="position: relative; width: 100%; height: auto; display: inline-grid">
                  @{
                    if (model.bOwnPlayer && !model.bLiveGame) {
                      <h4 class="scroll-anchor" id="header_options">Optionen</h4>

                      @if (iUserRespLevel >= CkAppShared.iUserRespPlayerContractsExpert) {
                        string sExtendContract = "Vertrag verlängern";
                        if (model.iAge > 15) {
                          if (model.bJouthWithContract) {
                            sExtendContract = "In Profikader übernehmen";
                          } else if (model.bJouth) {
                            sExtendContract = "Profivertrag aushandeln";
                          }
                        }

                        if (!model.bNation) {
                          if (model.iAge > 15 || (model.contract != null && model.contract.iLength < 2)) {
                            <button type="button" id="bnContract" class="btn btn-outline-secondary" style="width: 90%; margin-bottom: 4px" @onclick=NegotiatePlayerContract>@sExtendContract</button>
                          }

                          <button class="btn btn-outline-secondary" style="width: 90%; margin-bottom: 8px; @(model.bOnTransferlist ? "background-color: rgb(" + CkAppShared.sClCkRgb4 + ")" : "")" @onclick="PutOnTakeFromTransferlist">@(model.bOnTransferlist ? "Von Transferliste nehmen" : "Auf Transferliste setzen")</button>
                        }
                      }

                      if (!model.bJouth) {
                        if (!model.bCaptain) {
                          <button type="button" id="bnCaptain" class="btn btn-outline-secondary" style="width: 90%; margin-bottom: 4px" @onclick="() => checkSetCapitain(0)">Zum Kapitän machen</button>
                        }

                        if (!model.bCaptain2) {
                          <button type="button" id="bnCaptain2" class="btn btn-outline-secondary" style="width: 90%; margin-bottom: 4px" @onclick="() => checkSetCapitain(1)">Zum Vize-Kapitän machen</button>
                        }

                        /*
                        if (!model.bNation) {
                          <button type="button" id="bnDoping" class="btn btn-outline-secondary" style="width: 90%; margin-top: 4px">Spieler dopen</button>
                        }
                        */
                      }
                    } else if (model.bCpuPlayerNotOnTransferlist) {
                      <h4>Optionen</h4>

                      <button type="button" id="bnForcePutOnTransfer" class="btn btn-outline-secondary" style="width: 90%; margin-bottom: 8px" onclick="forcePutOnTransferlistGetSecretMoney()">Setzen auf Transferliste erstreiken</button>
                    }
                  }
                </div>
              </div>
            </div>
          </div>
        </Blazorise.TabPanel>
