                  <thead>
                    <tr>
                      <th style="text-align:center">Pos.</th>
                      <th style="text-align:center">Wert</th>
                      <th style="text-align:center">Stärke</th>
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (CkAppShared.DataPointDD dp in model.ltPlayerPosSkillData) {
                      if (dp.X.HasValue && dp.Y.HasValue) {
                        <tr style="font-weight: @(dp.X > 0.999 ? "bold" : "normal")">
                          <td align="center">@dp.Z</td>
                          <td align="right">@(dp.X.HasValue && dp.X.Value > 0.0 ? dp.X.Value.ToString("0.0%") : "?")</td>
                          <td align="center">@(dp.Y.HasValue && dp.Y.Value > 0.0 ? dp.Y.Value.ToString("0.0") : "?")</td>
                        </tr>
                      }
                    }
                  </tbody>
                </table>
              </div>
            }

            <div class="scroll-anchor" id="divPlayerSkills" style="position: relative; width: fit-content; max-width: 100%; height: auto; margin-bottom: 20px; margin-right: 20px">
              <h4>Individuelle Fähigkeiten</h4>

              <div style="display: flex; flex-wrap: wrap">
                <div style="max-width: 100%; height: auto; margin-bottom: 1rem; margin-right: 1rem; overflow: auto">
                  <Blazorise.RadioGroup TValue="int"
                          Name="indtraining"
                          @ref="rgSkills"
                          CheckedValue="@model.iPlayerIndTr"
                          CheckedValueChanged="@setIndTraining">
                    <table class="table table-bordered" id="tblPlayerSkills" cellpadding="0" style="width: auto; background-color: white">
                      <thead>
                        <tr>
                          <th style="text-align: center" class="category">Kat.</th>
                          <th style="text-align: center">Tal.</th>
                          <th style="text-align: center">Fähigkeit</th>
                          <th>Wert</th>
