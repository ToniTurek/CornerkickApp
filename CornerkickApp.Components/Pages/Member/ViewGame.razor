  private Task SetHeatmap(int iHm, int iType)
  {
    if (model == null) return Task.CompletedTask;

    model.iHeatmap   = -1;
    model.iOppThreat = -1;
    if      (iType == 0) model.iHeatmap   = iHm;
    else if (iType == 1) model.iOppThreat = iHm;

    ltHeatmap.Clear();
    StateHasChanged();

    GetHeatmap(iType);

    //if (player   != null) player.clear();

    StateHasChanged();

    return Task.CompletedTask;
  }
  private Task GetHeatmap(int iType)
  {
    if (model == null) return Task.CompletedTask;

    int iValue = -1;
    if (iType == 0) iValue = model.iHeatmap;
    if (iType == 1) iValue = model.iOppThreat;
    if (iValue < 0) return Task.CompletedTask;

    //gd = await CornerkickApp.Controllers.Member.ViewGameController.getStatistics(_usr, iState: iState, iHeatmap: iHm, bAddFMList: false);
    if (gd == null) return Task.CompletedTask;

    byte iHA = 0;
    int iPlIx = -1;
    if      (iType == 0) Controllers.Member.ViewGameController.getStatisticHAPlayerIx(iValue, gd.nPlStart, out iHA, out iPlIx);
    else if (iType == 1) iHA = (byte)iValue;
    ltHeatmap = Controllers.Member.ViewGameController.getDivHeatmap(_usr, iHA, iState, iPlIx, iType: iType);

    return Task.CompletedTask;
  }

  string FormatAsPercent(object value)
  {
    double fValue = (double)value;

    if (fValue < 0.001) return "";

    return fValue.ToString("P1", CornerkickApp.Controllers.Member.MemberController.getCi(_usr));
  }
  string FormatAsFloatAbs(object value)
  {
    if (value == null) return "";

    double fValue;
    if (!double.TryParse(value.ToString(), out fValue)) return "";
    fValue = Math.Abs(fValue);

    if (fValue < 0.001) return "";

    //return fValue.ToString("G3", CornerkickApp.Controllers.Member.MemberController.getCi(_usr));
    return fValue.ToString("0.##", CornerkickApp.Controllers.Member.MemberController.getCi(_usr));
  }

  string FormatAsMinute(object value)
  {
    if (value != null) {
      try {
        return Convert.ToDateTime(value).ToString("mm:ss");
#if false
        string? s = value.ToString();
        if (string.IsNullOrEmpty(s)) return "";

        TimeSpan ts = TimeSpan.Parse(s);
        return ts.TotalMinutes.ToString("0");
        //return ts.TotalMinutes.ToString("00") + ":" + ts.Seconds.ToString();
#endif
      } catch (Exception ex) {
        Console.WriteLine(ex.Message);
      }
    }

    return string.Empty;
  }

