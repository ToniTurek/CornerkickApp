  private async Task setShootSituation(System.Drawing.Point ptShooter, System.Drawing.Point ptKeeper)
  {
    bStop = true;
    try { cts?.Cancel(); } catch { }

    if (_usr?.game == null) return;

    _usr.game.resetGame();

    // Correct player positions
    if (iDebugHA == 0) {
      ptShooter = CornerkickGame.Tool.transformPosition(ptShooter, _usr.game.ptPitch.X);
      ptKeeper  = CornerkickGame.Tool.transformPosition(ptKeeper,  _usr.game.ptPitch.X);
    }

    // Define player and ball
    CornerkickGame.Player plShoot = _usr.game.player[iDebugHA][_usr.game.data.nPlStart - 1];
    plShoot.ptPos = ptShooter;
    _usr.game.ball.ptPos     = plShoot.ptPos;
    _usr.game.ball.ptPosLast = plShoot.ptPos;
    _usr.game.ball.plAtBall = plShoot;
    _usr.game.ball.setPos();

    CornerkickGame.Player plKeeper = _usr.game.tl.getKeeper(iDebugHA == 1);
    plKeeper.ptPos = ptKeeper;

    state = await CornerkickApp.Controllers.Member.ViewGameController.getState(_usr);
    if (state == null) return;

    sPlActive = CornerkickApp.Controllers.Member.ViewGameController.GetPlayerActiveDetails(plShoot);
    CornerkickApp.Controllers.Member.ViewGameController.PlayerChances? pc = CornerkickApp.Controllers.Member.ViewGameController.GetPlayerChances(_usr.game, iReceiverIx: (sbyte)iRecvIx);
    if (player != null && gd != null) await player.update(state.ltPlayer, gd.sJerseyColors, _sPlActive: sPlActive, _fPlAction: pc?.fPlAction);
    if (ball   != null)               await ball  .update(state.gBall, 0);

    await InvokeAsync(StateHasChanged);
  }

