  private async Task getGameData()
  {
    if (_usr == null) return;

    gd = await CornerkickApp.Controllers.Member.ViewGameController.getStatistics(_usr, iState: iState, bAddFMList: bTeamInfos);
    if (gd == null) return;

    int iMin = (int)gd.fMinute;
    sMin = iMin.ToString() + ":" + ((gd.fMinute - iMin) * 60).ToString("00 Min.");
    nStates = gd.nStates;
    if (iState < 0) {
      iState2 = nStates;
      nStates = Math.Max(nStates, (int)Math.Round(iState2 * (gd.iGameMinutes / Math.Max(gd.fMinute, 1f))));
    }
  }

  public static async Task wait(int iDuration)
  {
    if (iDuration <= 0) return;

    Task tkDelay = Task.Delay(iDuration);
    await tkDelay.ConfigureAwait(false);
    tkDelay.Dispose();
  }

  async Task loopStates(int jStateStart) {
    if (bRunning) {
      bRunning = false;
      return;
    }
    bRunning = true;

    iState = jStateStart;

    while (iState < nStates && bRunning) {
      await setState(iState + 1);
      await wait(200);
    }
  }

  async Task setState(int jState)
  {
    jState = Math.Max(jState, 0);
    jState = Math.Min(jState, nStates);
    iState  = jState;
    iState2 = jState;

    if (_usr == null) return;

    state = await CornerkickApp.Controllers.Member.ViewGameController.getState(_usr, iState: iState2);

    // Update player & ball
    if (state != null) {
      if (player   != null && gd != null) await player.update(state.ltPlayer, gd.sJerseyColors, _sPlActive: sPlActive);
      if (ball     != null)               await ball.update(state.gBall, 0);
      if (comments != null)               await comments.update(state.ltComments, bReset: true);
    }

    await getGameData();
    setChartData();
    await GetHeatmap(model.iOppThreat);
    await GetShootLines();

    await InvokeAsync(StateHasChanged);
  }

  protected void setChartData()
  {
    if (gd != null && dataH != null && dataA != null && dataGoalH != null && dataGoalA != null) {
      // Abs. chart data goals / xgoals
      dataGoalH[0].fValue = -gd.iGoalsH;
      dataGoalA[0].fValue =  gd.iGoalsA;
      dataGoalH[1].fValue = -gd.fGoalsX[0];
      dataGoalA[1].fValue =  gd.fGoalsX[1];
      /*
      fChartMinMax = Math.Max(gd.iGoalsH, gd.iGoalsA);
      fChartMinMax = Math.Max(fChartMinMax, gd.fGoalsX[0]);
      fChartMinMax = Math.Max(fChartMinMax, gd.fGoalsX[1]);
      */

      // Abs. chart data shoots
      /*
      fChartShootsFactor = Math.Max(gd.iShoots[0], gd.iShoots[1]);
      dataGoalH[2].fValue = -fChartMinMax * (gd.iShoots[0] / fChartShootsFactor);
      dataGoalA[2].fValue =  fChartMinMax * (gd.iShoots[1] / fChartShootsFactor);
      dataGoalH[3].fValue = -fChartMinMax * (gd.iShootsOnGoal[0] / fChartShootsFactor);
      dataGoalA[3].fValue =  fChartMinMax * (gd.iShootsOnGoal[1] / fChartShootsFactor);
      */
      dataGoalH[2].fValue = -gd.iShoots[0];
      dataGoalA[2].fValue =  gd.iShoots[1];
      dataGoalH[3].fValue = -gd.iShootsOnGoal[0];
      dataGoalA[3].fValue =  gd.iShootsOnGoal[1];
      fChartMinMax = Math.Max(gd.iShoots[0], gd.iShoots[1]);
      fChartMinMax = Math.Max(fChartMinMax, 1f);

      // Relative chart data
      /*
      if (gd.iShoots      [0] + gd.iShoots      [1] > 0) dataH[0].fValue = gd.iShoots      [0] / (float)(gd.iShoots      [0] + gd.iShoots      [1]);
      if (gd.iShootsOnGoal[0] + gd.iShootsOnGoal[1] > 0) dataH[1].fValue = gd.iShootsOnGoal[0] / (float)(gd.iShootsOnGoal[0] + gd.iShootsOnGoal[1]);
      */
      if (gd.iPossession  [0] + gd.iPossession  [1] > 0) dataH[0].fValue = gd.iPossession  [0] / (float)(gd.iPossession  [0] + gd.iPossession  [1]) + (float)1e-5;
      if (gd.iDuels       [0] + gd.iDuels       [1] > 0) dataH[1].fValue = gd.iDuels       [0] / (float)(gd.iDuels       [0] + gd.iDuels       [1]) + (float)2e-5;
      if (gd.iFouls       [0] + gd.iFouls       [1] > 0) dataH[2].fValue = gd.iFouls       [0] / (float)(gd.iFouls       [0] + gd.iFouls       [1]) + (float)3e-5;
      if (gd.iCornerkick  [0] + gd.iCornerkick  [1] > 0) dataH[3].fValue = gd.iCornerkick  [0] / (float)(gd.iCornerkick  [0] + gd.iCornerkick  [1]) + (float)4e-5;
      if (gd.iOffsite     [0] + gd.iOffsite     [1] > 0) dataH[4].fValue = gd.iOffsite     [0] / (float)(gd.iOffsite     [0] + gd.iOffsite     [1]) + (float)5e-5;
      if (gd.fPassGood    [0] + gd.fPassGood    [1] > 0) dataH[5].fValue = gd.fPassGood    [0] / (float)(gd.fPassGood    [0] + gd.fPassGood    [1]) + (float)6e-5;

      for (int i = 0; i < dataH.Length; i++) dataA[i].fValue = 1f - dataH[i].fValue;
    }
  }

