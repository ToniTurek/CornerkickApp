  protected Task setTactic()
  {
    if (_usr == null) return Task.CompletedTask;

    // Set tactic directly (do not wait for next step)
    int iHA = _usr.game.data.team[0].iTeamId == _usr.club.iId ? 0 : 1;
    _usr.game.SetTactic(iHA);
    _usr.game.ai.setOffenceWoBallTargetPos(iDebugHA == 0);

    CornerkickApp.Controllers.Member.ViewGameController.PlayerChances? pc = CornerkickApp.Controllers.Member.ViewGameController.GetPlayerChances(_usr.game, iReceiverIx: (sbyte)iRecvIx);
    if (player != null && gd != null) player.update(state.ltPlayer, gd.sJerseyColors, _sPlActive: sPlActive, _fPlAction: pc?.fPlAction, _iEventCounter: iEventCounter);

    ShowPath();

    return Task.CompletedTask;
  }

  public async ValueTask DisposeAsync()
  {
    // Fordere laufende Update-Schleifen zum Stoppen auf
    bStop = true;
    try { cts?.Cancel(); } catch { }

    // Warte kurz auf das Ende der Schleifen (sicherer Abbruch)
    for (int i = 0; i < 50 && bRunning; i++) {
      await Task.Delay(100).ConfigureAwait(false);
    }

    // Dispose JS-Module sicher
    if (moduleSite != null) {
      try { await moduleSite.DisposeAsync().ConfigureAwait(false); } catch { }
      moduleSite = null;
    }
    if (module != null) {
      try { await module.DisposeAsync().ConfigureAwait(false); } catch { }
      module = null;
    }

    // Entferne statische UI-Referenzen, damit GC greifen kann
    chartPlayerFresh = null;

    // Optional: Reset globaler Flags
    MainLayout.bOnViewGamePage = false;

    // Dispose CTS
    try { cts?.Dispose(); } catch { }
    cts = null;
  }
