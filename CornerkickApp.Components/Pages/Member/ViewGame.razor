  private string GetPathSvg(List<System.Drawing.Point> path)
  {
    if (gd == null || edField.Width == 0 || edField.Height == 0 || path == null || path.Count < 2) return string.Empty;

    double scaleX = edField.Width  / (double)gd.ptPitch.X;
    double scaleY = edField.Height / (double)(gd.ptPitch.Y * 2);

    var sb = new System.Text.StringBuilder();
    for (int i = 0; i < path.Count; i++) {
      double x = (path[i].X) * scaleX;
      double y = (path[i].Y + gd.ptPitch.Y) * scaleY;
      if (i == 0) sb.Append($"M{x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} ");
      else        sb.Append($"L{x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} ");
    }
    return sb.ToString();
  }
  private string GetPathSvg(List<float[]> xy)
  {
    if (gd == null || edField.Width == 0 || edField.Height == 0 || xy == null || xy.Count < 2) return string.Empty;

    var sb = new System.Text.StringBuilder();
    for (int i = 0; i < xy.Count; i++) {
      float x = (xy[i][0] * edField.Width)  + ((edFieldContainer.Width  - edField.Width ) / 2);
      float y = (xy[i][1] * edField.Height) + ((edFieldContainer.Height - edField.Height) / 2);
      if (i == 0) sb.Append($"M{x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} ");
      else        sb.Append($"L{x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} ");
    }
    return sb.ToString();
  }

  private string[] convertPointToSvgPix(System.Drawing.Point pt)
  {
    if (gd == null || edField.Width == 0 || edField.Height == 0) return [string.Empty, string.Empty];

    double scaleX = edField.Width  / (double)gd.ptPitch.X;
    double scaleY = edField.Height / (double)(gd.ptPitch.Y * 2);

    double x = (pt.X) * scaleX;
    double y = (pt.Y + gd.ptPitch.Y) * scaleY;

    return [x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture), y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)];
  }

  public async Task ShowPath()
  {
    if (bShowPlayerPath) {
      UpdatePath();
    } else {
      ltPathsH.Clear();
      ltPathsA.Clear();
    }
  }

  public async Task UpdatePath()
  {
    if (_usr?.game == null) return;
    if (!bShowPlayerPath) return;

    ltPathsH.Clear();
    ltPathsA.Clear();

    for (int iHA = 0; iHA < 2; iHA++) {
      int iPl = 0;
      foreach (CornerkickGame.Player pl in _usr.game.player[iHA]) {
        if (iPl >= _usr.game.data.nPlStart) break;

        // A*-Pfad berechnen (z. B. über Field.FindPathAStar)
        var path = _usr.game.field.FindPath(pl.ptPos, pl.ptPosTarget);

        if (path != null) {
          if (iHA == 0) ltPathsH.Add(path);
          else          ltPathsA.Add(path);
        }

        iPl++;
      }
    }

    await InvokeAsync(StateHasChanged);
  }

