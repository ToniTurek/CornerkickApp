@page "/member/viewgame/{id}"

@implements IAsyncDisposable

@using System.Text.Json
@using System.Text.Json.Serialization
@using CornerkickApp.Shared.Models
@using CornerkickApp.Components.Pages.Templates

@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject Controllers.Shared.MyAuthenticationStateProvider _auth

<PageTitle>Live-Spiel</PageTitle>

<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" href="./_content/CornerkickApp.Components/css/slider.css" />

  <style>
    .accordion-body {
      padding: 2px !important;
    }
  </style>
</head>

<body id="body">
  <input type="hidden" id="bShowAnimations" name="bShowAnimations" checked="">
  <input type="hidden" id="bShowChances" name="bShowChances" checked="">
  <input type="hidden" id="bShowPassTargets" name="bShowPassTargets">
  <input type="hidden" id="bShowTargetPos" name="bShowTargetPos">

  @*
  <div id="divRenderContainer" style="position: absolute; top: 100px; left: 25%; width: 50%; min-width: 300px; height: 800px; z-index: 101; border-style: ridge; border-width: 4px; border-color: lightgray; display: none;">
    <b id="txtRenderLeft" style="position: absolute; top: 4px; left: 4px; color: white"></b>
    <b id="txtRenderShootResult" style="position: absolute; top: 16px; left: 0px; width: 100%; text-align: center; color: red; font-size: 200%"></b>
    <canvas width="1264" height="792" style="display: block; width: 1264px; height: 792px; touch-action: none;"></canvas>
  </div>
  *@

  @if (model != null) {
    <div id="header" style="position: relative; width: 100%; max-width: 1200px; height: calc(71px * var(--ckRelSize)); background-color: lightgrey; border-radius: 10px; display: block; z-index: 2">
      @if (gd != null) {
        if (!string.IsNullOrEmpty(gd.sTeamH)) {
          if (!string.IsNullOrEmpty(gd.sEmblemH)) {
            <div id="divEmblemH" class="emblem" style="left: 36%">
              <img src="@gd.sEmblemH" alt="Wappen" style="position: absolute; height: 100%; right: 0px; object-fit: contain" title="@gd.sTeamH">
            </div>
          }
          <div style="position: absolute; width: 30px; height: 30px; left:  1%; margin-top: 12px" @onclick="() => changeJerseyColors(0)">
            <div id="divJerseyH" style="position: relative; width: 30px; height: 30px; border: 2px solid @gd.sJerseyColors[0][1 + iClIxH]; border-radius: 50%; cursor: pointer; background-color: @gd.sJerseyColors[0][0 + iClIxH]"></div>
          </div>
          <div style="position: absolute; width: 30%; left: 5%; top: 30%; text-align: right; white-space: nowrap; overflow: hidden">
            <text id="lbTeamH" style="font-size: 1.25em">@gd.sTeamH</text>
          </div>
        }

        if (!string.IsNullOrEmpty(gd.sTeamA)) {
          if (!string.IsNullOrEmpty(gd.sEmblemA) && !string.IsNullOrEmpty(gd.sTeamA)) {
            <div id="divEmblemA" class="emblem" style="right: 36%">
              <img src="@gd.sEmblemA" alt="Wappen" style="position: absolute; height: 100%; left: 0px; object-fit: contain" title="@gd.sTeamA">
            </div>
          }
          <div style="position: absolute; width: 30px; height: 30px; right: 1%; margin-top: 12px" @onclick="() => changeJerseyColors(1)">
            <div id="divJerseyA" style="position: relative; width: 30px; height: 30px; border: 2px solid @gd.sJerseyColors[1][1 + iClIxA]; border-radius: 50%; cursor: pointer; background-color: @gd.sJerseyColors[1][0 + iClIxA]"></div>
          </div>
          <div style="position: absolute; width: 30%; right: 5%; top: 30%; text-align: left; white-space: nowrap; overflow: hidden">
            <text id="lbTeamA" style="font-size: 1.25em">@gd.sTeamA</text>
          </div>
        }

        <div style="position: absolute; width: 20%; height: 100%; left: 40%">
          <div style="position: absolute; width: 35%; height: 100%; left: 0%">
            <text id="lbGoalsH" style="position: absolute; top: 0px; right: 3px; font-size: 2.75em; color: @(!bFinished && state != null && state.iShootHA == 1 ? "red" : "black"); font-weight: @(!bFinished && state != null && state.iShootHA == 1 ? "bold" : "normal");">@gd.iGoalsH.ToString()</text>
          </div>
          <div style="position: absolute; width: 100%; height: 100%; left: 0px; text-align: center">
            <text style="font-size: 2.75em">-</text>
          </div>
          <div style="position: absolute; width: 35%; height: 100%; right: 0%">
            <text id="lbGoalsA" style="position: absolute; top: 0px; left: 3px; font-size: 2.75em; color: @(!bFinished && state != null && state.iShootHA == 2 ? "red" : "black"); font-weight: @(!bFinished && state != null && state.iShootHA == 2 ? "bold" : "normal");">@gd.iGoalsA.ToString()</text>
          </div>
        </div>

        <div style="position: absolute; width: 100%; height: auto; bottom: 0px; left: 0px; text-align: center">
          <text id="lbStadium" style="font-size: 0.75em">@gd.sStadium</text>
      </div>
      }
    </div>

    @*<div id="divContainer" style="position:relative; width: 100%; max-width: 1200px; top: calc(71px * var(--ckRelSize))">*@
    <div id="divContainer">
      @if (bShowPitch) {
        <div id="divOptions" style="position: relative; left: 0px; width: 100%; margin-top: 8px; display: flex; align-items: flex-end">
          @if (bFinished) {
            <button id="bnStart" @onclick="() => setState(iState2 - 10)" class="btn btn-outline-secondary" style="width: 5rem; margin-right: 4px" disabled="@(iState2 <= 0)">
              <i class="fa fa-fast-backward"></i>
            </button>
            <button id="bnBack" @onclick="() => setState(iState2 - 1)" class="btn btn-outline-secondary" style="width: 5rem; margin-right: 4px" disabled="@(iState2 <= 0)">
              <i class="fa fa-step-backward"></i>
            </button>
            <button id="bnPlay"@onclick="() => loopStates(iState2)" class="btn btn-outline-secondary" style="width: 5rem; margin-right: 4px" disabled="@(iState2 >= nStates)">
              <i class="@( bRunning ? "fa fa-stop" : "fa fa-play" )"></i>
            </button>
            <button id="bnForth" @onclick="() => setState(iState2 + 1)" class="btn btn-outline-secondary" style="width: 5rem; margin-right: 4px" disabled="@(iState2 >= nStates)">
              <i class="fa fa-step-forward"></i>
            </button>
            <button id="bnEnd" @onclick="() => setState(iState2 + 10)" class="btn btn-outline-secondary" style="width: 5rem; margin-right: 4px" disabled="@(iState2 >= nStates)">
              <i class="fa fa-fast-forward"></i>
            </button>
          }
        </div>
      }

      @if (CkAppShared.debug) {
        <h5>Debug options</h5>
        <div id="divDebugOptions" style="position: relative; left: 0px; width: 100%; margin-top: 2px; margin-bottom: 4px; display: flex; flex-wrap: wrap; align-items: center; border: 1px solid black; padding: 4px">
          <div style="margin-right: 2rem">
            <button class="btn btn-outline-secondary" @onclick="StartStopDebug">
              <i class="@( bRunning ? "fa fa-stop" : "fa fa-play" )"></i>
            </button>
            <button class="btn btn-outline-secondary" @onclick="OneStep" disabled="@bRunning">
              <i class="fa fa-step-forward"></i>
            </button>
          </div>
          <div style="margin-right: 1rem">
            <label>
              Anspieler:
              <Blazorise.Select @bind-SelectedValue="@iRecvIx" TValue="int" Style="width: 100px; margin-right: 4px" Disabled="@(bRunning || slRecv.Count == 0)">
                @foreach (LayoutModel.SelectListItem sli in slRecv) {
                  <Blazorise.SelectItem Value="@sli.Value">@sli.Text</Blazorise.SelectItem>
                }
              </Blazorise.Select>
            </label>
          </div>
          <div style="width: 100%; max-width: 300px; margin-right: 1rem; display: flex; flex-direction: column; z-index: 1">
            <div style="color: orange">Ausrichtung: @model.iOrient.ToString()</div>
            <Blazorise.Slider TValue="int" Value="model.iOrient" Min="-100" Max="100" Step="5" ValueChanged="setTacticOrient" Class="slider handleOrange" />
          </div>
          <div style="width: 100%; max-width: 300px; margin-right: 1rem; display: flex; flex-direction: column; z-index: 1">
            <div style="color: red">Schusshäufigk.: @model.iShootFreq.ToString()</div>
            <Blazorise.Slider TValue="int" Value="model.iShootFreq" Min="-100" Max="100" Step="5" ValueChanged="setTacticShootFreq" Class="slider handleRed" />
          </div>
          <div style="width: 100%; max-width: 300px; margin-right: 1rem; display: flex; flex-direction: column; z-index: 1">
            <div style="color: blue">Abstand gegn. Abseits: @model.iDistOffsite.ToString()</div>
            <Blazorise.Slider TValue="int" Value="model.iDistOffsite" Min="-1" Max="3" Step="1" ValueChanged="setTacticDistOffsite" Class="slider handleRed" />
          </div>
          @if (AppConstants.IS_DEBUG) {
            <div>
              <select @bind="iDebugHA">
                <option value="0">Heim</option>
                <option value="1">Ausw</option>
              </select>

              <button class="btn btn-outline-secondary" style="width: auto" @onclick="setSituation1">Sit. 1</button>
              <button class="btn btn-outline-secondary" style="width: auto" @onclick="setSituation2">Sit. 2</button>
              <button class="btn btn-outline-secondary" style="width: auto" @onclick="setSituation3">Sit. 3</button>
              <select @bind="iDebugNextAction">
                <option value="-1">auto</option>
                <option value="0">Schuss</option>
                <option value="1">Pass</option>
                <option value="2">Solo</option>
                <option value="3">Warten</option>
              </select>
              <select @bind="iDebugNextActionResult">
                <option value="-1">auto</option>
                <option value="0">vorbei</option>
                <option value="1">Tor</option>
                <option value="2">gefangen</option>
                <option value="3">Abpraller</option>
                <option value="4">Ecke</option>
                <option value="5">Pfosten</option>
                <option value="6">Latte</option>
              </select>
            </div>
          }
        </div>
      }

      @if (bShowPitch) {
        <div id="divTimeline" style="position: relative; width: 100%; left: 0px;">
          @if (gd != null) {
            <div id="divTimelineIcons" style="position: absolute; width: 100%; height: 100%">
              @((MarkupString)gd.sTimelineIcons)
            </div>
            <div style="position: absolute; width: 100%; top: 20px; display: flex; align-items: center; justify-content: center">
              @if (bFinished) {
                <Blazorise.Slider TValue="int" Value="iState2" Min="0" Max="nStates" Step="1" ValueChanged="setState" Class="slider handleOrange" />
              } else {
                <Blazorise.Progress Value="iState2" Max="nStates" Animated Striped Color="Blazorise.Color.Warning" Style="width: 100%; height: 24px" />
              }
              <span style="position: absolute; left: @(((iState2 / (float)nStates) + (bFinished ? 0.02f : 0f)).ToString("0.0%", System.Globalization.CultureInfo.InvariantCulture))">@sMin</span>
            </div>
            @*
            <div id="slider-Minute" style="position: absolute; width: 100%; top: 20px" class="ui-slider ui-corner-all ui-slider-horizontal ui-widget ui-widget-content">
              <div id="divMinute" style="position: absolute; width: 100%">
                <text id="txtMinute" style="position: absolute; left: @fMin.ToString("0.0%", System.Globalization.CultureInfo.InvariantCulture)">@sMin</text>
              </div>
              <div class="ui-slider-range ui-corner-all ui-widget-header ui-slider-range-min" style="width: @fMin.ToString("0.0%", System.Globalization.CultureInfo.InvariantCulture)"></div>
              <span tabindex="0" class="ui-slider-handle ui-corner-all ui-state-default" style="left: @fMin.ToString("0.0%", System.Globalization.CultureInfo.InvariantCulture)"></span>
            </div>
            *@
          }
        </div>

        <div style="position: relative; width: 100%; min-height: 28px; margin-bottom: 4px; height: auto; display: flex; align-items: center">
          <div id="divDrawGameContainer" style="position: relative; width: 100%; height: 100%; display: block; top: 0px; left: 0px; z-index: 0;" @ref=refFieldContainer>
            <img id="imgGame" style="position: relative; width: 100%; height: auto;" src="@CornerkickApp.Shared.Models.CkAppShared.sContentDir/Images/stadium/field_full.png" alt="">

            @* Shoots *@
            @{
              if (ltShootLines != null && ltShootLines.Count > 0) {
                <svg style="position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:3"
                     viewBox="0 0 @edFieldContainer.Width @edFieldContainer.Height" preserveAspectRatio="none">
                  @{
                    int iShoot = 0;
                    foreach (var line in ltShootLines) {
                      List<float[]> path = new List<float[]>();
                      path.Add(new float[] { line.x0, line.y0 });
                      path.Add(new float[] { line.x1, line.y1 });
                      <defs>
                        <marker id="circle_@iShoot" markerWidth="8" markerHeight="8" refX="4" refY="4">
                          <circle cx="4" cy="4" r="2" fill="@line.sColor" />
                        </marker>
                        <marker id='head_@iShoot'
                                orient="auto"
                                markerWidth='6'
                                markerHeight='6'
                                refX='5'
                                refY='3'>
                          <path d='M0,0 V6 L6,3 Z' fill="@line.sColor" />
                        </marker>
                      </defs>
                      <path d="@GetPathSvg(path)" stroke="@line.sColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" marker-start="url(#circle_@iShoot)" marker-end='url(#head_@iShoot)' />

                      iShoot++;
                    }
                  }
                </svg>
              }
            }

            @*<div id="divDrawGame" style="position: absolute; margin-left: 5%; width: 90%; height: 84%; top: 8%" @ref=refField>*@
            <div id="divDrawGame" style="position: absolute; margin-left: 5%; width: 90%; aspect-ratio: 1.57895; top: 8%" @ref=refField>
              @if (gd != null) {
                @* Hexagonnetz SVG-Overlay *@
                <ViewGameGrid @ref="grid" edField="@edField" ptPitch="@gd.ptPitch"></ViewGameGrid>

                @* Player paths *@
                @if ((ltPathsH != null && ltPathsH.Count > 0) || (ltPathsA != null && ltPathsA.Count > 0)) {
                  <svg style="position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:3"
                       viewBox="0 0 @edField.Width @edField.Height" preserveAspectRatio="none">
                    @if (ltPathsH != null && ltPathsH.Count > 1) {
                      @foreach (var path in ltPathsH) {
                        <path d="@GetPathSvg(path)" stroke="@gd.sJerseyColors[0][0 + iClIxH]" stroke-width="1" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.85" />
                        <circle cx="@convertPointToSvgPix(path[path.Count - 1])[0]" cy="@convertPointToSvgPix(path[path.Count - 1])[1]" r="4" fill="@gd.sJerseyColors[0][0 + iClIxH]"></circle>
                      }
                    }
                    @if (ltPathsA != null && ltPathsA.Count > 1) {
                      @foreach (var path in ltPathsA) {
                        <path d="@GetPathSvg(path)" stroke="@gd.sJerseyColors[1][0 + iClIxA]" stroke-width="1" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.85" />
                        <circle cx="@convertPointToSvgPix(path[path.Count - 1])[0]" cy="@convertPointToSvgPix(path[path.Count - 1])[1]" r="4" fill="@gd.sJerseyColors[1][0 + iClIxA]"></circle>
                      }
                    }
                  </svg>
                }

                @* Heatmap *@
                <div id="drawHeatmap" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%">
                  @foreach (ViewGameModel.HeatmapPoint hmp in ltHeatmap) {
                    <div class="heatmap-point" style="top: @hmp.y.ToString("0.00%", System.Globalization.CultureInfo.InvariantCulture); left: @hmp.x.ToString("0.00%", System.Globalization.CultureInfo.InvariantCulture); background-color: @hmp.color; -webkit-border-radius: 50%; -moz-border-radius: 50%; z-index: @hmp.level.ToString()" title="@hmp.value.ToString("0.0%")"></div>
                  }
                </div>

                @* Offsite *@
                if (fOffsiteLine > 0f) {
                  <div style="position: absolute; top: 0; left: @fOffsiteLine.ToString("0.00%", System.Globalization.CultureInfo.InvariantCulture); height: 100%; border: 2px solid yellow"></div>
                  if (fPlOffsite != null) {
                    @*
                    <div style="position: absolute; top: @fPlOffsite[1].ToString("0.00%", System.Globalization.CultureInfo.InvariantCulture); left: @fPlOffsite[0].ToString("0.00%", System.Globalization.CultureInfo.InvariantCulture); height: 5%; border: 1px solid yellow"></div>
                    *@
                    <svg style="position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:3"
                         viewBox="0 0 @edField.Width @edField.Height" preserveAspectRatio="none">
                      <circle cx="@fPlOffsite[0].ToString("0.00%", System.Globalization.CultureInfo.InvariantCulture)" cy="@fPlOffsite[1].ToString("0.00%", System.Globalization.CultureInfo.InvariantCulture)" r="14" stroke="yellow" stroke-width="1" fill="none"></circle>
                    </svg>
                  }
                }

                @((MarkupString)gd.sCard)

                <ViewGamePlayer @ref="player" ptPitch="gd.ptPitch" GameFinished="bFinished"></ViewGamePlayer>
                <ViewGameBall @ref="ball" ptPitch="gd.ptPitch"></ViewGameBall>
              }
            </div>

            <text id="txtDebugInfo"></text>

            @if (!bFinished) {
              <div id="divCbUpdate" style="position: absolute; bottom: 0px; right: 4px; width: 200px; text-align: right">
                <label>
                  <input type="checkbox" @bind-value="bTeamInfos">
                  Mannschaftsinfos
                </label>
              </div>
            }

            @if (model.bAdmin) {
              <div id="divAdminChanceShoot" style="position: absolute; width: 30%; left: 35%; bottom: 0px; text-align: center">
                <text id="txtAdminChanceShootOnGoal"></text>
                <text id="txtAdminChanceGoal"></text>
              </div>
            }
          </div>
          <div id="divLinks" style="position: absolute; top: 0px; left: 5%; width: 90%; z-Index: 9; display: flex; justify-content: space-between">
            @{
              if (model.bOwnLiveGame) {
                <div style="margin-right: 6px">
                  <div id="divLinkTeam">
                    <a href="/member/team" style="color:#000aaa; text-decoration: none">Aufstellung</a>
                  </div>
                  <div id="divLinkTactic">
                    <a href="/member/tactic" style="color:#000aaa; text-decoration: none">Taktik</a>
                  </div>
                </div>
                @*
                @Html.DropDownListFor(m => m.iSystem, Model.sliSystem, new { @onchange = "javascript:changeSystem(this, null, 0)", @style = "position: relative; top: 0px; width: 95px; float: left", id = "ddlSystem" })
                *@
              }
            }
            <div>
              <div id="divLinkHome" style="text-align: right">
                <a href="/member/desk" style="color:#000aaa; text-decoration: none">Schreibtisch</a>
              </div>
              <div>
                <Blazorise.Accordion>
                  <Blazorise.AccordionItem Style="background-color: transparent">
                    <Blazorise.AccordionHeader>
                      <Blazorise.Heading Size="Blazorise.HeadingSize.Is4">
                        <Blazorise.AccordionToggle Style="background-color: transparent; padding: 2px">Optionen</Blazorise.AccordionToggle>
                      </Blazorise.Heading>
                    </Blazorise.AccordionHeader>
                    <Blazorise.AccordionBody Style="background-color: rgb(255,255,255,0.25)">
                      <div id="divOptions" style="position: relative; left: 0px; width: fit-content; display: flex; flex-direction: column">
                        <label style="margin-left:8px">
                          <input type="checkbox" @onchange="ToggleHexGrid" />
                          Spielfelder
                        </label>
                        @if (bFinished) {
                          <label>
                            Spielerpos.:
                            <Blazorise.Select SelectedValue="@model.iPositions" SelectedValueChanged="(i) => SetPlayerPos(i)" TValue="int" Style="width: 100px; margin-right: 4px">
                              @foreach (LayoutModel.SelectListItem sli in model.ddlPositions) {
                                <Blazorise.SelectItem Value="@sli.Value">@sli.Text</Blazorise.SelectItem>
                              }
                            </Blazorise.Select>
                          </label>
                          <label>
                            Schüsse:
                            <Blazorise.Select SelectedValue="@model.iShoots" SelectedValueChanged="(i) => SetShootLines(i)" TValue="int" Style="width: 100px; margin-right: 4px">
                              @foreach (LayoutModel.SelectListItem sli in model.ddlShoots) {
                                <Blazorise.SelectItem Value="@sli.Value">@sli.Text</Blazorise.SelectItem>
                              }
                            </Blazorise.Select>
                          </label>
                          <label>
                            Heatmap:
                            <Blazorise.Select SelectedValue="@model.iHeatmap" SelectedValueChanged="(i) => SetHeatmap(i, 0)" TValue="int" Style="width: 100px; margin-right: 4px">
                              @foreach (LayoutModel.SelectListItem sli in model.ddlHeatmap) {
                                <Blazorise.SelectItem Value="@sli.Value">@sli.Text</Blazorise.SelectItem>
                              }
                            </Blazorise.Select>
                          </label>
                        } else {
                          <label style="margin-left:8px">
                            <input type="checkbox" @onchange="TogglePlayerPath" />
                            Zielpositionen
                          </label>
                          <label style="margin-left:8px">
                            <input type="checkbox" @onchange="ToggleOffsiteWait" />
                            Warte bei Abseits
                          </label>
                        }
                        @if (CkAppShared.debug && !bFinished) {
                          <label>
                            Gegnerdruck:
                            <Blazorise.Select SelectedValue="@model.iOppThreat" SelectedValueChanged="(i) => SetHeatmap(i, 1)" TValue="int" Style="width: 100px; margin-right: 4px">
                              @foreach (LayoutModel.SelectListItem sli in model.ddlOppThreat) {
                                <Blazorise.SelectItem Value="@sli.Value">@sli.Text</Blazorise.SelectItem>
                              }
                            </Blazorise.Select>
                          </label>
                        }
                      </div>
                    </Blazorise.AccordionBody>
                  </Blazorise.AccordionItem>
                </Blazorise.Accordion>
              </div>
            </div>
            @*
            <div id="divLinkOptions" style="position: absolute; top: calc(20px * var(--ckRelSize)); right: 0px; text-align: right">
              <a href="#" id="aOptions" style="color:#000aaa; text-decoration:none">Optionen</a>
            </div>
            *@
          </div>

          @* Half-time information & continue button *@
          @if (state != null && (state.evt != null || state.bFinished) && !(bHideScoutingData && state.bFinished)) {
            if ((state.evt != null && (state.evt == ViewGameModel.State.Event.NotStarted || state.evt == ViewGameModel.State.Event.HalfTime || state.evt == ViewGameModel.State.Event.FullTime || state.evt == ViewGameModel.State.Event.PenaltyShootout)) || state.bFinished) {
              <div style="position: absolute; width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; bottom: 4px">
                <div style="display: flex; flex-direction: column; height: fit-content; max-height: 100%; background-color: white; padding: 0.5rem; z-index: 10">
                  @* Half-time information *@
                  @if (ltScoutedPlayer != null && !bHideScoutingData) {
                    <div style="display: flex; justify-content: space-between; align-items: center">
                      <h5><img src="@CkAppShared.sContentDir/Icons/menu/binoculars.svg" height="20" width="20" /> Spielerbeobachtungen</h5>
                      <button @onclick="@(() => bHideScoutingData = true)">X</button>
                    </div>
                    <div style="overflow-y: auto">
                      <table style="border: 1px solid black">
                        <thead>
                          <tr style="background-color: lightgrey">
                            <th class="scouting-row-details">Nr.</th>
                            <th class="scouting-row-details">Spieler</th>
                            <th class="scouting-row-details">Min.</th>
                            <th class="scouting-row-details">Fertigkeit</th>
