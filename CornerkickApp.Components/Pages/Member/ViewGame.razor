  public void Stop()
  {
    bStop = true;
    try {
      cts?.Cancel();
    } catch {
    }
  }

  public async Task Reset()
  {
    bStop = true;
    try { cts?.Cancel(); } catch { }

    while (bRunning) {
      // Warte, bis laufendes Update fertig ist
      await wait(state != null && state.iGameSpeedUsed > 2 ? state.iGameSpeedUsed / 2 : 100);
    }

    // neues CancellationTokenSource für zukünftige Starts
    try { cts?.Dispose(); } catch { }
    cts = new System.Threading.CancellationTokenSource();
    bStop = false;

    Ini();

    if (StartGameOnEnter) {
      _ = updateState();
    } else {
      if (player   != null) await player  .clear();
      if (ball     != null) await ball    .clear();
      if (comments != null) await comments.clear();

      await InvokeAsync(StateHasChanged);
    }
  }

