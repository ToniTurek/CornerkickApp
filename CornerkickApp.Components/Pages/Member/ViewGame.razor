  private async Task StartStopDebug()
  {
    // Wenn aktuell gestoppt -> starten
    if (bStop) {
      bStop = false;
      try { cts?.Dispose(); } catch { }
      cts = new System.Threading.CancellationTokenSource();
      await InvokeAsync(StateHasChanged);
      _ = updateState();
      return;
    }

    // sonst stoppen
    bStop = true;
    try { cts?.Cancel(); } catch { }
    await InvokeAsync(StateHasChanged);
  }
  private async Task OneStep()
  {
    // Einzelschritt: neues Token, sicherstellen dass nicht abgebrochen wird
    try { cts?.Dispose(); } catch { }
    cts = new System.Threading.CancellationTokenSource();
    bStop = false;

    await updateState(bOneStep: true);
    await InvokeAsync(StateHasChanged);
  }
  private async Task updateState(bool bOneStep = false, bool bImediately = false)
  {
    if (_usr == null) return;
    if (model?.game == null) return;

    /*
    bStop = false;
    if (bRunning) {
      bStop = true;
      return;
      }
    */

    bool bFirstCall = true;

    int iBalanceStart = 0;
    int iBalanceSecretStart = 0;
    CornerkickManager.Club? clb = Controllers.Member.MemberController.ckClub(_usr);
    if (clb != null) {
      iBalanceStart       = clb.iBalance;
      iBalanceSecretStart = clb.iBalanceSecret;
    }

    bHideScoutingData = false;

    // Verwende das aktuelle CancellationToken (falls vorhanden)
    var token = cts?.Token ?? System.Threading.CancellationToken.None;
    while (!bFinished) {
      if (token.IsCancellationRequested) {
        bRunning = false;
        await InvokeAsync(StateHasChanged);
        return;
      }

      bRunning = true;

      try {
        state = await CornerkickApp.Controllers.Member.ViewGameController.getState(_usr,
#if !_WebApp
          bExecuteGame: true,
          bImediately: bImediately,
#if DEBUG
  iPlNextAction: (sbyte)iDebugNextAction,
  iPlNextActionResult: (sbyte)iDebugNextActionResult,
#endif
#endif
          bOnlyMainComments: _usr.lti != null && _usr.lti[UserOptionsModel.iUserOptionsIxComment] > 0,
          bPlayerAtBallDetails: bd != null && bd.Width > 640 && model.game.data.iGameSpeed > 2
        );
      } catch (Exception e) {
        System.Diagnostics.Debug.Print(e.StackTrace);
        System.Diagnostics.Debug.Print(e.Message);
      }
      bFinished = model.game.data.bFinished;

      if (state != null) {
        //if (_usr.game.data.iGameSpeed > 1) {
        if (state.iGameSpeedUsed > 1 || state.evt == ViewGameModel.State.Event.HalfTime || state.evt == ViewGameModel.State.Event.FullTime || state.evt == ViewGameModel.State.Event.PenaltyShootout) {
          // If not waiting
          if (state.evt != ViewGameModel.State.Event.Wait || bFirstCall) {
            // Reset offsite
            fOffsiteLine = -1f;
            fPlOffsite = null;
            //await InvokeAsync(StateHasChanged);

            // Break for game pause
            if (state.evt == ViewGameModel.State.Event.HalfTime || state.evt == ViewGameModel.State.Event.FullTime || state.evt == ViewGameModel.State.Event.PenaltyShootout) {
              ltScoutedPlayer = Controllers.Member.ViewGameController.GetScoutedPlayer(_usr, model.game.data.dt);
              bHideScoutingData = false;
              /*
              // Scout home player
              if (clbH.user != null && clbH.ltPlayer != null) {
                for (byte iPl = 0; iPl < _usr.game.data.nPlStart; iPl++) {
                  if (iPl >= clbH.ltPlayer.Count) break;
                  Player plSc = clbH.ltPlayer[iPl];
                  plt.checkPlayerDevScouting(clbH.user.scout.scoutPlayer(plSc.plGame, dtDatum), clbH.user, plSc);
                  }
                }

              // Scout away player
              if (clbA.user != null && clbA.ltPlayer != null) {
                for (byte iPl = 0; iPl < game.data.nPlStart; iPl++) {
                  if (iPl >= clbA.ltPlayer.Count) break;
                  Player plSc = clbA.ltPlayer[iPl];
                  plt.checkPlayerDevScouting(clbA.user.scout.scoutPlayer(plSc.plGame, dtDatum), clbA.user, plSc);
                  }
                }
              */
              break;
            }

            sPlActive = [ state.sPlActiveName, state.sPlActivePortraitImg ];

            // Update player, ball & comments
#if !DEBUG
            if (state.bUpdate) {
#endif
            if (player   != null && gd != null) await player.update(state.ltPlayer, gd.sJerseyColors, _sPlActive: sPlActive, _fPlAction: state.fPlAction, _iEventCounter: iEventCounter);
            if (ball     != null)               await ball.update(state.gBall, state.iGameSpeedUsed);
            if (comments != null)               await comments.update(state.ltComments);

            if (bShowPlayerPath) UpdatePath();
            if (model.iOppThreat >= 0) await GetHeatmap(1);

            if (CkAppShared.debug) {
              slRecv = new List<CornerkickApp.Shared.Models.LayoutModel.SelectListItem>();

              if (_usr.game.ball.plAtBall != null) {
                List<CornerkickGame.AI.Receiver> ltReceiver = CornerkickGame.AI.getReceiverList(_usr.game, _usr.game.ball.plAtBall, iType: 0);
                if (ltReceiver != null && ltReceiver.Count > 0) {
                  slRecv.Add(new CornerkickApp.Shared.Models.LayoutModel.SelectListItem() { Value = "-1", Text = "zufällig" });
                  for (int i = 0; i < ltReceiver.Count; i++) {
                    slRecv.Add(new CornerkickApp.Shared.Models.LayoutModel.SelectListItem() { Value = i.ToString(), Text = ltReceiver[i].plReceiver.sName });
                  }
                }
              }
            }
#if !DEBUG
            }
#endif

            if (state.evt == null) iEventCounter = 0;
            else                   iEventCounter++;

            if (state.bUpdateStatistic) {
              await getGameData();

              setChartData();

              if (bTeamInfos && model.gD != null) {
                // Update team table
                ltTableTeam = (await CornerkickApp.Controllers.Member.TeamController.getTableTeam(_usr, model.gD.nPlStart, 0, 0)).ToList();

                // Fresh chart
                if (chartPlayerFresh != null) await chartPlayerFresh.Reload();
              } else {
                ltTableTeam = null;
                chartPlayerFresh = null;
              }

              if (MainLayout.headline != null) await MainLayout.headline.Refresh();

              await InvokeAsync(StateHasChanged);
            } else if (state.evt != null) {
              await InvokeAsync(StateHasChanged);
            }

  #if !_WebApp
            if (bOneStep || bInterruptLiveGame) {
              bRunning = false;
              /*
              float fTest = model.game.tl.getOffsiteX(model.game.ball.plAtBall.iHA == 0) / (float)model.game.ptPitch.X;
              Console.WriteLine("Offsite Line: " + fTest.ToString("0.00"));
              */
              return;
            }
  #endif

            if (state.evt == ViewGameModel.State.Event.GoalHome || state.evt == ViewGameModel.State.Event.GoalAway) {
              // Wait 1 sec. for goal cheers
              await Task.Delay(1500, token).ContinueWith(_ => { });
            } else if (state.evt == ViewGameModel.State.Event.NoGoal) {
              // Wait 0.75 sec. for shoot result
              await Task.Delay(750, token).ContinueWith(_ => { });
            } else if (state.evt == ViewGameModel.State.Event.RedCard) {
              // Wait 2 sec. for red card
              await Task.Delay(1500, token).ContinueWith(_ => { });
            } else if (state.evt == ViewGameModel.State.Event.Offsite) {
              fOffsiteLine = model.game.tl.getOffsiteX(model.game.ball.plAtBallLast.iHA == 0) / (float)model.game.ptPitch.X;
              if (model.game.ball.plAtBall != null) {
                fPlOffsite = [
                   model.game.ball.plAtBall.ptPos.X                         / (float)   model.game.ptPitch.X,
                  (model.game.ball.plAtBall.ptPos.Y + model.game.ptPitch.Y) / (float)(2*model.game.ptPitch.Y)
                ];
              }
              await InvokeAsync(StateHasChanged);

              /*
              bRunning = false;
              return;
              */

              if (bOffsiteWait) await Task.Delay(1000, token).ContinueWith(_ => { });
              /*
              fOffsiteLine = -1f;
              fPlOffsite = null;
              await InvokeAsync(StateHasChanged);
              */
            }

            //await InvokeAsync(StateHasChanged);
          } // if (state.evt != ViewGameModel.State.Event.Wait)

          if (state.iGameSpeedUsed > 2) {
            try { await Task.Delay(state.iGameSpeedUsed, token).ConfigureAwait(false); } catch (OperationCanceledException) { }
          }
        } else if (state.evt != null) {
          await getGameData();
          if (MainLayout.headline != null) await MainLayout.headline.Refresh();
          await InvokeAsync(StateHasChanged);
        }
      }

      bFirstCall = false;
    }  // while (!bFinished)

    // Final update player, ball & comments
    if (state != null) {
      if (player   != null && gd != null) await player.update(state.ltPlayer, gd.sJerseyColors, _sPlActive: sPlActive);
      if (ball     != null)               await ball.update(state.gBall, 0);
      if (comments != null)               await comments.update(state.ltComments);
      //ltScoutedPlayer = Controllers.Member.ViewGameController.GetScoutedPlayer(_usr, model.game.data.dt);
    } else {
      bShowPitch = false;
      state = await CornerkickApp.Controllers.Member.ViewGameController.getState(_usr, bPlayerAtBallDetails: false);
    }

    await getGameData();
    setChartData();
    if (model.gD != null && model.bOwnLiveGame) {
      ltTableTeam = (await CornerkickApp.Controllers.Member.TeamController.getTableTeam(_usr, model.gD.nPlStart, 0, 0)).ToList();
    }

    if (MainLayout.headline != null) {
      if (bFinished && clb != null) {
        MainLayout.headline.Refresh(clb, iBalanceStart: iBalanceStart, iBalanceSecretStart: iBalanceSecretStart);
      } else {
        await MainLayout.headline.Refresh();
      }
    }

    bRunning = false;

    await InvokeAsync(StateHasChanged);
  }

