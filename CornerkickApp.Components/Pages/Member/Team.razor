  private string getPosName(int iSelPlId, int iX, int iY)
  {
    if (teamData?.ltPlayer2 == null) return "";
    if (CornerkickManager.Main.sPosition == null) return "";

    TeamModel.Player? pl = teamData.ltPlayer2.Find(p => p.iId == iSelPlId);
    if (pl == null) return "";

    byte iPos = CornerkickGame.Tool.getBasisPos(CornerkickGame.Tool.getPosRole(new System.Drawing.Point(iX, iY), teamData.ptPitch));
    if (iPos < 0) return "";
    if (iPos >= CornerkickManager.Main.sPosition.Length) return "";

    pl.iPos = iPos;

    return CornerkickManager.Main.sPosition[iPos];
  }

  private string getPosName(int iX, int iY)
  {
    if (teamData == null) return "";
    if (CornerkickManager.Main.sPosition == null) return "";

    byte iPos = CornerkickGame.Tool.getBasisPos(CornerkickGame.Tool.getPosRole(new System.Drawing.Point(iX, iY), teamData.ptPitch));
    if (iPos < 0) return "";
    if (iPos >= CornerkickManager.Main.sPosition.Length) return "";

    return CornerkickManager.Main.sPosition[iPos];
  }

