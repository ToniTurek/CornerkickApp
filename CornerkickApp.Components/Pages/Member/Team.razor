  private async Task<List<int[]>?> switchPlayerWork(List<TeamModel.TableTeam> ltPlayer)
  {
    if (ltPlayer.Count == 2 && ltPlayer[0].iId != ltPlayer[1].iId && _usr != null && team != null) {
      if (ltPlayer[1].bSubstituted) {
        ltPlayer.RemoveAt(1);
        return null;
      }

      //CornerkickApp.Controllers.Member.TeamController.UpdateRow(_usr, ltPlayer[0].iIndex, ltPlayer[1].iIndex);
      bool bOk = CornerkickApp.Controllers.Member.TeamController.SwitchPlayerByID(_usr, team, ltPlayer[0].iId, ltPlayer[1].iId, team.ltiSubstitution == null ? 0 : team.ltiSubstitution.Count);

      if (bOk) {
        updateTeam();

        if (teamtable != null) teamtable.ltiSubstitution = team.ltiSubstitution;

        await ShowTutorial(1);
      }

      return team.ltiSubstitution;
    }

    return null;
  }

