  private async Task GetRadiusOfActionAsync()
  {
    // Get Radius of Action
    if (_usr != null && selected_player != null && iFormationOption == 1) {
      fRadiusOfAction = new List<float[]>();

      for (float fRnd = 0.5f; fRnd < 1.01f; fRnd += 0.1f) {
        float[]? fRoa = Controllers.Member.TeamController.GetPlayerRadiusOfAction(_usr, selected_player.iIndex - 1, selected_player.fRadOfAction, fRnd);

        if (fRoa != null) {
          if ((fRoa[2] > 0.03f && fRoa[3] > 0.03f) || Math.Abs(fRnd - 0.9f) < 0.001f) {
            fRadiusOfAction.Add(
              [
                fRnd,
                fRoa[0],
                fRoa[1],
                fRoa[2],
                fRoa[3]
              ]
            );
          }
        }

      }

      await InvokeAsync(StateHasChanged);
    }
  }

