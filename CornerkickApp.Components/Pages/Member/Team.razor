  private async Task drawTeam()
  {
    if (iFormationOption == 0) {
      DotNetObjectReference<JStoCS> dotNetReference = DotNetObjectReference.Create(new JStoCS(this));
      await JS.InvokeVoidAsync("drawAufstellung", JsonSerializer.Serialize(teamData), selected_player == null ? -1 : selected_player.iId, 0, false, bd.Width < 600, dotNetReference);
      //await InvokeAsync(StateHasChanged);
      //await InvokeAsync(StateHasChanged);

      edField = await JS.InvokeAsync<Components.Pages.Member.ViewGame.ElemDimension>("getElemDimensions", refField);

      /* Man-markings */
      await GetManMarkings(selected_player != null ? selected_player.iIndex : -1);
    }
  }

  private async Task GetManMarkings(int iSelPlIx)
  {
    if (iFormationOption == 0) {
      /* Man-markings */
      ltManMarkings = new List<TeamField.ManMarking>();
      if (teamData?.ltPlayer2 != null) {
        int iPlIx = 0;
        foreach (TeamModel.Player pl in teamData.ltPlayer2) {
          if (pl.iIxManMarking >= 0) {
            TeamModel.Player? plOpp = teamData.ltPlayerOpp2[pl.iIxManMarking];
            if (plOpp != null) {
              ltManMarkings.Add(
                new TeamField.ManMarking {
                  ptPl = pl.ptPos.toPoint(),
                  ptPlOpp = new System.Drawing.Point(teamData.ptPitch.X - plOpp.ptPos.x, -plOpp.ptPos.y),
                  iPlIx = iPlIx
                }
              );
            }
          }

          iPlIx++;
        }

        if (field != null) field.ShowAsync(ltManMarkings, edField, iSelPlIx);
      }
    }
  }

