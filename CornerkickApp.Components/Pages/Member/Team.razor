  private bool toBeSubstituted(int iIndex)
  {
    if (team == null) return false;
    if (_usr == null) return false;
    if (_usr.game == null) return false;

    CornerkickManager.Club? clb = MemberController.ckClub(_usr);
    if (clb == null) return false;

    bool bOnSubList = false;
    byte iHA = 0;
    if (clb.iId == _usr.game.data.team[1].iTeamId) iHA = 1;
    if (_usr.game.ltSubstitutions[iHA] != null) {
      foreach (byte[] iSub in _usr.game.ltSubstitutions[iHA]) {
        if (iSub[0] == iIndex || iSub[1] == iIndex) {
          bOnSubList = true;
          break;
        }
      }
    }

    return bOnSubList || team.ltiSubstitution?.Find(s => s[0] == iIndex || s[1] == iIndex) != null;
  }

  protected async Task ShowTutorial(int iLevelChange = 0)
  {
    if (_usr != null && team?.tutorial != null) {
      team.tutorial.iLevel += iLevelChange;
      await Task.Run(() => ShowTutorial(_usr, team, NavigationManager));
      await InvokeAsync(StateHasChanged);
    }
  }

