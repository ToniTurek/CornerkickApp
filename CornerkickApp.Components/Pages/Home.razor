@page "/home"

@layout MainLayout
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager NavigationManager
@implements IAsyncDisposable
@using System.Text.Json
@using System.Text.Json.Serialization
@using CornerkickApp.Shared.Models

<PageTitle>Cornerkick Home</PageTitle>

<html style="height: 100%; min-height: 100%">
<head>
  <meta charset="utf-8">

  <style>
    .btn-primary {
      width: 100%;
      max-width: 270px;
      border: 2px solid white;
    }

    p[name="txtTeaser"] {
      color: white;
      font-family: Arial, Helvetica, sans-serif;
      margin: 8px;
    }

    .ckTeaser {
      font-size: 20px;
    }

    .ckTeaserSmall {
      font-size: 14px;
    }
  </style>
</head>

<body onload="setTimeout(function(){ window.scrollTo(0, 1); }, 100)" style="height: 100%; min-height: 100%">
  @*<h1 class="text-muted">Render @(OperatingSystem.IsBrowser() ? "Wasm" : "Server")</h1>*@

  @*
    full view
  *@
  <div class="main_container_default" id="divMain" style="max-width: 1100px">
    <div id="renderContainer" style="position: absolute; top: 100px; right: 0px; width: 25%; min-width: 300px; height: 800px; z-index: 9; border-style: ridge; border-width: 4px; border-color: lightgray; display:none">
      <b id="txtRenderInfo" style="position: absolute; top: 4px; left: 4px; color: white"></b>
      <b id="txtRenderCount" style="position: absolute; top: 4px; right: 4px; text-align: right; color: white"></b>
      <b id="txtRenderShootResult" style="position: absolute; top: 16px; left: 0px; width: 100%; text-align: center; color: rgb(@CkAppShared.sClCkRgb2); font-size: 200%"></b>
    </div>

    <div class="p-5 mb-4 rounded-3" style="background-color: rgb(@CkAppShared.sClCkRgb); padding-bottom: 0.5rem !important">
      <div style="display: flex; flex-direction: row; flex-wrap: wrap-reverse; justify-content: space-between; align-items: flex-end">
        <div style="position: relative; min-height: 340px; color: white; margin-right: 2rem; display: flex; flex-direction: column">
          @* Title *@
          <div style="width: fit-content; display: flex; flex-direction: column; align-items: center">
            <h1 style="margin-bottom: 0px; font-size: 3rem">
              CORNERKICK
              @if (CkAppShared.bWebApp) {
                <i style="color: rgb(@CkAppShared.sClCkRgb2); text-shadow: 2px 2px #696969"> Online</i>
              }
            </h1>
            <p style="position: relative; font-size: 1.5rem; margin-bottom: 0px">
              @if (CkAppShared.bWebApp) {
                <span>Online </span>
              }
              Football Manager Simulation
            </p>
            <p style="position: relative; font-size: 0.9rem">v<span>@CkAppShared.sVersion</span></p>
          </div>

          @* Buttons *@
          <div style="width: 100%; display: flex; flex: 1; align-items: center">
            <div style="width: 100%">
              <p>
                @if (CkAppShared.bWebApp) {
                  <div>
                    <b style="font-size: 20px">Registriere dich als Manager mit deinem<br>Verein und starte sofort in die neue @sSeason Saison!</b>
                  </div>
                  <br />
                  <a href="/Account/Register" class="btn btn-primary btn-lg" style="background-color: rgb(@CkAppShared.sClCkRgb2)">Registrieren &raquo;</a>
                } else {
                  <a href="/database" class="btn btn-primary btn-lg" style="background-color: rgb(@CkAppShared.sClCkRgb2)">Neues Spiel &raquo;</a>
                }
              </p>
              <p>
                @if (CkAppShared.bWebApp) {
                  <a href="/Account/Login" class="btn btn-primary btn-lg" style="background-color: rgb(@CkAppShared.sClCkRgb3); color: black">Anmelden &raquo;</a>
                } else {
                  <a href="/gameload" class="btn btn-primary btn-lg @(HomeModel.iFilesLoad > 0 ? "" : " disabled")" style="background-color: rgb(@CkAppShared.sClCkRgb3); color: black">Spiel laden &raquo;</a>
                }
              </p>
            </div>
          </div>

          @if (CkAppShared.bWebApp) {
            @* Game to start info *@
            <div id="counter_container" style="display: none; width: 100%; background-color: rgb(@CkAppShared.sClCkRgb3); padding: 10px; border: 2px solid rgb(@CkAppShared.sClCkRgb2)">
              <p style="color: rgb(@CkAppShared.sClCkRgb2); font-size: 200%; margin-left: 10px">Die neue Saison startet am <span><i><b id="counter_date_season_start"></b></i></span></p>
              <p style="color: rgb(@CkAppShared.sClCkRgb2); font-size: 200%; margin-left: 10px; margin-bottom: 0">&#10146; noch: <span id="counter_season_start"></span></p>
            </div>

            @* World info *@
            @if (CkAppShared.sCkInstanceName != null) {
              <div style="position: relative; margin-top: 40px">
                <p style="margin-bottom: 0px;">
                  Aktuelle Welt: <b>@CkAppShared.sCkInstanceName</b>
                  @{
                    if (CkAppShared.ckMng?.ltUser != null) {
                      string sUserCount = Math.Max(CkAppShared.ckMng.ltUser.Count - 1, 0).ToString();
                      <span>(Anzahl Manager: @sUserCount)</span>
                    }
                  }
                </p>
                <p style="margin-bottom: 0px;">
                  Wechseln zu Welt:
                  <b>
                    @if (CkAppShared.sCkInstanceName.Equals("Cornerkick1")) {
                      <a href="http://ck2.cornerkick-manager.de">Cornerkick2</a>
                    } else if (CkAppShared.sCkInstanceName.Equals("Cornerkick2")) {
                      <a href="http://www.cornerkick-manager.de">Cornerkick1</a>
                    }
                  </b>
                </p>
              </div>
            }
          }
        </div>

        @* Ck Image *@
        <div style="position: relative; flex: 1; min-width: 320px; height: fit-content; margin-bottom: 1rem; border-style: outset; border-width: 6px; border-color: gray">
          <img style="width: 100%" src="./_content/CornerkickApp.Components/Content/Images/ck.png" />
        </div>
      </div>
      <span style="position: relative; bottom: 0; color: white">Entwickelt von Toni Turek</span>
    </div>

    @* Online / App links *@
    <div class="p-5 mb-4 rounded-3" style="width: 100%; padding-top: 1rem; padding-bottom: 1rem; background-color: rgb(@CkAppShared.sClCkRgb3)">
      @if (CkAppShared.bWebApp) {
        <b style="width: 100%; color: rgb(@CkAppShared.sClCkRgb2); font-size: 20px">Hol dir den Cornerkick-Manager als lokale App:</b>

        <br />
        <div style="width: 300px">
          <script type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"></script>
          <ms-store-badge productid="9P2T5TXWQM27"
                          productname="Cornerkick-Manager_v8"
                          window-mode="direct"
                          theme="auto"
                          size="large"
                          language="de"
                          animation="on">
          </ms-store-badge>
          <a href='https://play.google.com/store/apps/details?id=com.cornerkick.maui&pcampaignid=pcampaignidMKT-Other-global-all-co-prtnr-py-PartBadge-Mar2515-1' style="display: block; width: 100%">
            <img alt='Jetzt bei Google Play' src='https://play.google.com/intl/en_us/badges/static/images/badges/de_badge_web_generic.png' style="display: block; width: 100%"/>
          </a>
        </div>
      } else {
        <b style="width: 100%; color: rgb(@CkAppShared.sClCkRgb2); font-size: 20px">Registriere dich beim <i>online Cornerkick-Manager</i> und beweise dich gegen andere menschliche Spieler:<br />
          <a href="http://www.cornerkick-manager.de">www.cornerkick-manager.de</a>
        </b>
      }
    </div>

    @* Teaser *@
    <div class="p-5 mb-4 rounded-3" style="background-color: rgb(@CkAppShared.sClCkRgb); margin-top: 10px">
      <p name="txtTeaser" class="ckTeaser"><span><img src="./_content/CornerkickApp.Components/Content/Images/logo_64.png" width="24" /></span> Absolut kostenlos, keine in-game Käufe</p>
      <p name="txtTeaser" class="ckTeaser"><span><img src="./_content/CornerkickApp.Components/Content/Images/logo_64.png" width="24" /></span> Komplette Simulation der Spiele in Echtzeit</p>
      <p name="txtTeaser" class="ckTeaser"><span><img src="./_content/CornerkickApp.Components/Content/Images/logo_64.png" width="24" /></span> Spiele nationale Wettbewerbe und qualifiziere dich für internationale Pokale</p>
      <p name="txtTeaser" class="ckTeaser"><span><img src="./_content/CornerkickApp.Components/Content/Images/logo_64.png" width="24" /></span> Gewinne die Meisterschaft und coache die Nationalmannschaft</p>
      <p name="txtTeaser" class="ckTeaser"><span><img src="./_content/CornerkickApp.Components/Content/Images/logo_64.png" width="24" /></span> Baue dein Stadion aus und errichte weitere Gebäude um deinen Verein nach ganz oben zu bringen</p>
      <p name="txtTeaser" class="ckTeaser"><span><img src="./_content/CornerkickApp.Components/Content/Images/logo_64.png" width="24" /></span> Umfassende Statistik z.B. deiner Spieler</p>

      <div style="margin-top: 2rem">
        <a href="/info" class="btn btn-primary" style="font-size: 20px; white-space: nowrap">Mehr Infos & <i class="fa-solid fa-heart" style="color: red"></i> Support &raquo;</a>
        <a href="/usermanual" class="btn btn-primary" style="font-size: 20px">Anleitung &raquo;</a>
      </div>
    </div>

    @if (CkAppShared.bWebApp) {
      <h4>Bildergalerie (klicken zum vergrößern):</h4>

      <div style="width: 100%; height: 440px; z-index: 99">
        @*<div style="width: 200px; cursor: pointer; margin-right: 10px; margin-bottom: 10px; float: left" onclick="zoomVideo(this, 1)">*@
        <div style="height: 200px; cursor: pointer; margin-right: 10px; margin-bottom: 10px">
          <video height="200" controls="controls">
            <source src="./_content/CornerkickApp.Components/Content/Videos/game_example_1.mp4" type="video/mp4" />
            <source src="./_content/CornerkickApp.Components/Content/Videos/game_example_1.ogg" type="video/ogg">
            Your browser does not support the video tag.
          </video>
        </div>

        <div style="height: 200px; cursor: pointer; margin-right: 10px; margin-bottom: 10px; float: left" onclick="zoomImg($(this))">
          <img style="height: 100%; border: 1px solid black" src="./_content/CornerkickApp.Components/Content/Images/user_manual/Team1b.gif" title="Aufstellung (1)" />
        </div>

        <div style="height: 200px; cursor: pointer; margin-right: 10px; margin-bottom: 10px; float: left" onclick="zoomImg($(this))">
          <img style="height: 100%; border: 1px solid black" src="./_content/CornerkickApp.Components/Content/Images/user_manual/Team3a.gif" title="Aufstellung (2)" />
        </div>

        <div style="height: 200px; cursor: pointer; margin-right: 10px; margin-bottom: 10px; float: left" onclick="zoomImg($(this))">
          <img style="height: 100%; border: 1px solid black" src="./_content/CornerkickApp.Components/Content/Images/user_manual/Tactic.png" title="Taktik" />
        </div>

        <div style="height: 200px; cursor: pointer; margin-right: 10px; margin-bottom: 10px; float: left" onclick="zoomImg($(this))">
          <img style="height: 100%; border: 1px solid black" src="./_content/CornerkickApp.Components/Content/Images/user_manual/Training.png" title="Training" />
        </div>

        <div style="height: 200px; cursor: pointer; margin-right: 10px; margin-bottom: 10px; float: left" onclick="zoomImg($(this))">
          <img style="height: 100%; border: 1px solid black" src="./_content/CornerkickApp.Components/Content/Images/user_manual/PlayerDetails_1.gif" title="Spielerdetails (1)" />
        </div>

        <div style="height: 200px; cursor: pointer; margin-right: 10px; margin-bottom: 10px; float: left" onclick="zoomImg($(this))">
          <img style="height: 100%; border: 1px solid black" src="./_content/CornerkickApp.Components/Content/Images/user_manual/PlayerDetails_2.gif" title="Spielerdetails (2)" />
        </div>
      </div>
    }
  </div>

  @*
    mobile view
  *@
  <div class="main_container_mobile" style="background-image: url(./_content/CornerkickApp.Components/Content/Images/ck_mobile4.png); background-repeat: no-repeat; background-size: cover">
    <div style="position: absolute; left: 0; top: 2rem; width: 100%; text-align: center; color: white">
      <h1 style="margin-bottom: 0">CORNERKICK</h1>
      <p style="position: relative; font-size: 0.7rem">v<span>@CkAppShared.sVersion</span></p>
    </div>
    <div style="position: absolute; left: 15%; top: 23vw; width: 80%; aspect-ratio: 1.17">
      <div class="mobile-item" style="left: 0; top: 0">
        @if (CkAppShared.bWebApp) {
          <a href="/Account/Register" style="width: 100%; height: 100%; text-decoration: none">
            <div class="btn btn-primary btn-lg" style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; max-width: 270px; font-size: x-large; background-color: transparent; border: 2px solid white">Registrieren &raquo;</div>
          </a>
        } else {
          <a href="/database" style="width: 100%; height: 100%; text-decoration: none">
            <div class="btn btn-primary btn-lg" style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; max-width: 270px; font-size: x-large; background-color: transparent; border: 2px solid white">Neues Spiel &raquo;</div>
          </a>
        }
      </div>
      <div class="mobile-item" style="left: 50%; top: 0">
        @if (CkAppShared.bWebApp) {
          <a href="/Account/Login" style="width: 100%; height: 100%; text-decoration: none">
            <div class="btn btn-primary btn-lg" style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; max-width: 270px; font-size: x-large; background-color: transparent; border: 2px solid white">Anmelden &raquo;</div>
          </a>
        } else {
          <a href="/gameload" style="width: 100%; height: 100%; text-decoration: none">
            <div class="btn btn-primary btn-lg" style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; max-width: 270px; font-size: x-large; background-color: transparent; border: 2px solid white">Spiel laden &raquo;</div>
          </a>
        }
      </div>
      <div class="mobile-item" style="left: 0; top: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center">
        @if (CkAppShared.bWebApp) {
          if (iOS == 0 || iOS == 1) {
            <div style="width: 100%">
              <script type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"></script>
              <ms-store-badge productid="9P2T5TXWQM27"
                              productname="Cornerkick-Manager_v8"
                              window-mode="direct"
                              theme="auto"
                              size="small"
                              language="de"
                              animation="on">
              </ms-store-badge>
            </div>
          }
          if (iOS == 0 || iOS == 2) {
            <div style="width: 100%">
              <a href='https://play.google.com/store/apps/details?id=com.cornerkick.maui&pcampaignid=pcampaignidMKT-Other-global-all-co-prtnr-py-PartBadge-Mar2515-1' style="display: block; width: 100%">
                <img alt='Jetzt bei Google Play' src='https://play.google.com/intl/en_us/badges/static/images/badges/de_badge_web_generic.png' style="display: block; width: 100%" />
              </a>
            </div>
          }
        } else {
          <div style="width: 90%; text-align: center">
            <b style="width: 100%; color: rgb(@CkAppShared.sClCkRgb2); font-size: 110%"><i>online Cornerkick-Manager</i>:<br /><a href="http://www.cornerkick-manager.de">cornerkick-manager.de</a></b>
          </div>
        }
      </div>
      <div class="mobile-item" style="left: 50%; top: 50%">
        <a href="/usermanual" style="width: 100%; height: 100%; text-decoration: none">
          <div class="btn btn-primary btn-lg" style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; max-width: 270px; font-size: x-large; background-color: transparent; border: 2px solid white">Anleitung &raquo;</div>
        </a>
      </div>
    </div>
    <div style="position: fixed; left: 18%; bottom: 2px; width: 81%; color: white; font-size: small">
      <p style="margin: 0"><span><img src="./_content/CornerkickApp.Components/Content/Images/logo_64.png" width="16" /></span> Absolut kostenlos, keine in-game Käufe</p>
      <p style="margin: 0"><span><img src="./_content/CornerkickApp.Components/Content/Images/logo_64.png" width="16" /></span> Komplette Simulation der Spiele in Echtzeit</p>
      <p style="margin: 0"><span><img src="./_content/CornerkickApp.Components/Content/Images/logo_64.png" width="16" /></span> Spiele nationale Wettbewerbe und qualifiziere dich für internationale Pokale</p>
      <p style="margin: 0"><span><img src="./_content/CornerkickApp.Components/Content/Images/logo_64.png" width="16" /></span> Gewinne die Meisterschaft und coache die Nationalmannschaft</p>
      <p style="margin: 0"><span><img src="./_content/CornerkickApp.Components/Content/Images/logo_64.png" width="16" /></span> Baue dein Stadion aus und errichte weitere Gebäude um deinen Verein nach ganz oben zu bringen</p>
      <p style="margin: 0"><span><img src="./_content/CornerkickApp.Components/Content/Images/logo_64.png" width="16" /></span> Umfassende Statistik z.B. deiner Spieler</p>
    </div>
  </div>
</body>
</html>

