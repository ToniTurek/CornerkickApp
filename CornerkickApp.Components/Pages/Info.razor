@page "/info"

<PageTitle>Info</PageTitle>

<html style="height: 100%; min-height: 100%">
<head>
  <meta charset="utf-8">

  <style>
    h3 {
      margin-top: 1em;
    }
  </style>
</head>

<body style="height: 100%; min-height: 100%">
  <h3>Credentials</h3>
  <p>Entwickelt von Toni Turek</p>

  <h3>Kontakt</h3>
  <p><a href="mailto:mail@cornerkick-manager.de">mail@cornerkick-manager.de</a></p>

  <h3>Versionen</h3>
  <table>
    <tbody>
      <tr>
        <td><b>Cornerkick-GUI:</b></td>
        <td>@sCkAppVersion</td>
        <td><span style="margin-right: 1rem"></span> Repo: <a href="https://github.com/ToniTurek/CornerkickApp">GitHub</a></td>
      </tr>
      <tr>
        <td><b>Cornerkick-Manager:</b></td>
        <td>@sCkMngVersion</td>
        <td></td>
      </tr>
      <tr>
        <td><b>Cornerkick-Game:</b></td>
        <td>@sCkGameVersion</td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <h3><i class="fa-solid fa-heart" style="color: red"></i> Entwicklung unterstützen</h3>
  <p>Wenn dir Cornerkick gefällt, würde ich mich über eine kleine Spende freuen, um die Entwicklung zu unterstützen. Vielen Dank!</p>
  <p>
    <a href='https://ko-fi.com/B2F720Q0OO' target='_blank'><img height='36' style='border:0px;height:36px;' src='https://storage.ko-fi.com/cdn/kofi5.png?v=6' border='0' alt='Buy Me a Coffee at ko-fi.com' /></a>
  </p>
  <p>
    <iframe src="https://github.com/sponsors/ToniTurek/button" title="Sponsor ToniTurek" height="32" width="114" style="border: 0; border-radius: 6px;"></iframe>
  </p>
</body>
</html>

@code {
  string sCkAppVersion = "Unknown";
  string sCkMngVersion = "Unknown";
  string sCkGameVersion = "Unknown";

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();

    sCkAppVersion  = CornerkickApp.Controllers.App.Version + " (commit: " + CornerkickApp.Controllers.App.Commit + ")";
    sCkMngVersion  = CornerkickManager.Main.Version + " (commit: " + CornerkickManager.Main.Commit + ")";
    sCkGameVersion = CornerkickGame   .Game.Version + " (commit: " + CornerkickGame   .Game.Commit + ")";
  }
}
