  private void OnRowStyling(TeamModel.TableTeam pl, DataGridRowStyling styling)
  {
    if (selected_player != null && selected_player.iIndex == pl.iIndex) {
      styling.Style = "background-color: pink";
    } else {
      if (pl.iIndex < nPlStart + 1) {
        if (pl.iIndex % 2 == 0) {
          styling.Style = "background-color: rgb(235,255,235)";
        } else {
          styling.Style = "background-color: rgb(245,255,245)";
        }
      } else if (pl.iIndex < nPlStart + nPlRes + 1) {
        if (pl.iIndex % 2 == 0) {
          styling.Style = "background-color: rgb(230,240,255)";
        } else {
          styling.Style = "background-color: rgb(240,250,255)";
        }
      } else {
        if (pl.iIndex % 2 == 0) {
          styling.Style = "background-color: rgb(240,240,240)";
        } else {
          styling.Style = "background-color: white";
        }
      }
    }

    if (pl.bSubstituted) { // Player is substituted -->
      styling.Style += "; color: rgb(180,180,180)"; // --> text color grey
    } else if (pl.bAtNationalTeam) { // Player is at national team -->
      styling.Style += "; color: rgb(180,180,180)"; // --> text color grey
    } else if (toBeSubstituted(pl.iIndex - 1)) { // Player is to be substituted -->
      styling.Style += "; color: rgb(180,180,180)"; // --> text color grey
    } else {
      if (pl.iSuspended < 0) { // Player has yellow card -->
        styling.Style += "; color: rgb(220,140,0)"; // --> text color yellow
      } else if (pl.iSuspended > 0) { // Player has red card -->
        styling.Style += "; color: rgb(255,0,0)"; // --> text color red
      }
    }
  }

  public async Task disable()
  {
    sClass = "disabled";
    await InvokeAsync(StateHasChanged);
    await InvokeAsync(StateHasChanged);
  }
  private async Task refresh(DataGridReadDataEventArgs<TeamModel.TableTeam> e)
  {
    //sClass = "disabled";
    //await InvokeAsync(StateHasChanged);
    //sClass = "";
    //await Task.Delay(10);
    await InvokeAsync(StateHasChanged);
  }
  public async Task update(List<TeamModel.TableTeam>? _ltTableTeam, int iSelPlIx = 0, bool bMobile = false)
  {
    selected_player = ltTableTeam != null ? ltTableTeam.Find(p => p.iIndex == iSelPlIx) : null;
    await update(_ltTableTeam, selected_player, bMobile: bMobile);
  }
  private async Task update(List<TeamModel.TableTeam>? _ltTableTeam, TeamModel.TableTeam? _selected_player, bool bMobile = false)
  {
#if DEBUG
    sw.Restart();
#endif
    if (!_bMobileSet) await setMobile(bMobile);
    ltTableTeam = _ltTableTeam;
    selected_player = _selected_player;
    sClass = "";
    await InvokeAsync(StateHasChanged);
  }
  public async Task clearSelectedPlayer()
  {
    selected_player = null;
    if (teamtable != null) teamtable.SelectedRows.Clear();
    if (actRefresh != null) actRefresh(0);
  }

  private async Task switchMobile()
  {
    _bMobileSet = true;
    _bMobile = !_bMobile;
    setMobile(_bMobile);
    //await InvokeAsync(StateHasChanged);
  }

  private async Task setMobile(bool bMobile)
  {
    _bMobile = bMobile;
    nPageSize = bMobile ? nPlStart : 100;
    //await InvokeAsync(StateHasChanged);
  }

  private bool toBeSubstituted(int iIndex)
  {
    if (User == null) return false;
    if (User.game == null) return false;

    CornerkickManager.Club? clb = Controllers.Member.MemberController.ckClub(User);
    if (clb == null) return false;

    bool bOnSubList = false;
    byte iHA = 0;
    if (clb.iId == User.game.data.team[1].iTeamId) iHA = 1;
    if (User.game.ltSubstitutions[iHA] != null) {
      foreach (byte[] iSub in User.game.ltSubstitutions[iHA]) {
        if (iSub[0] == iIndex || iSub[1] == iIndex) {
          bOnSubList = true;
          break;
        }
      }
    }

    return bOnSubList || ltiSubstitution?.Find(s => s[0] == iIndex || s[1] == iIndex) != null;
  }

}
