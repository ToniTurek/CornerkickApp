@using CornerkickApp.Shared.Models

@if (fElapsedTime > 0.0 && CkAppShared.debug) {
  <div>
    Elapsed time: @(fElapsedTime.ToString("0.000")) s
  </div>
}
<div class="@sClass" style="position: relative; width: 100%">
  @*
            Virtualize
            VirtualizeOptions="@(new() { DataGridHeight = "800px"})"
            PageSize="@(nPlStart + nPlRes + 1)"
  *@
  <DataGrid @ref="teamtable"
            TItem="TeamModel.TableTeam"
            Data="@ltTableTeam"
            SelectionMode="Blazorise.DataGrid.DataGridSelectionMode.Multiple"
            Style="white-space:nowrap"
            PageSize="@nPageSize"
            ShowPager
            CommandMode="DataGridCommandMode.ButtonRow"
            Narrow
            RowStyling="@OnRowStyling"
            Sortable
            SortMode="DataGridSortMode.Single"
            Responsive
            RowSelectable=@((x) => !(x.Item.bSubstituted || x.Item.bAtNationalTeam/* || x.Item.iSuspended > 0*/ || toBeSubstituted(x.Item.iIndex - 1)))
            SelectedRowsChanged="@switchPlayer">
    <ChildContent>
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.iIndex)"
                      Caption="#"
                      TextAlignment="Blazorise.TextAlignment.Center"
                      CellStyle="@((item) => {
                        string sRet = "";
                        if (item.bSubstituted || item.bAtNationalTeam || toBeSubstituted(item.iIndex - 1)) {
                          sRet = "color: rgb(180,180,180);";
                        } else {
                          if (item.iSuspended < 0) {         // Player has yellow card -->
                            sRet = "color: rgb(220,140,0);"; // --> text color yellow
                          } else if (item.iSuspended > 0) {  // Player has red card -->
                            sRet = "color: white;";          // --> text color white
                          }
                        }
                        if (item.iSuspended > 0) {
                          sRet += "background-color: red !important";
                        } else if (item.iIndex < nPlStart + 1) {
                          sRet += "background-color: rgb(210,230,188) !important";
                        } else if (item.iIndex < nPlStart + nPlRes + 1) {
                          sRet += "background-color: rgb(192,204,224) !important";
                        } else {
                          sRet += "background-color: rgb(225,225,225) !important";
                        }
                        return sRet;
                      })" />
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.iId)" Sortable="false" Displayable="false" />
      <DataGridColumn Field="" Sortable="false" Displayable="false" />
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.iNr)" Caption="Nr" TextAlignment="Blazorise.TextAlignment.Center" />
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.sName)" Caption="Name" TextAlignment="Blazorise.TextAlignment.Center">
        <DisplayTemplate>
          <a href="/member/playerdetails/@context.iId" class="@(context.bSubstituted ? "substituted" : "")" style="text-decoration: none">
            @((MarkupString)context.sName)
          </a>
        </DisplayTemplate>
      </DataGridColumn>
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.sPosition)" Caption="Pos." TextAlignment="Blazorise.TextAlignment.Center" />
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.sHp)" Caption="HP" TextAlignment="Blazorise.TextAlignment.Center" />
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.fSkill)" Caption="Stärke" TextAlignment="Blazorise.TextAlignment.Center" CellStyle="@((item) => {
                                    if (selected_player != null && selected_player.iId != item.iId) {
                                      if (selected_player.iIndex <= nPlStart) return "color: #ce00ff ";
                                      if (item           .iIndex <= nPlStart) return "color: blue ";
                                    }
                                    return "";
                                  })">
        <DisplayTemplate>
          @((MarkupString)(context.fSkill > 0 ? context.fSkill.ToString("0.0") : "?"))
        </DisplayTemplate>
      </DataGridColumn>
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.fCondi)" Caption="Kond." TextAlignment="Blazorise.TextAlignment.End">
        <DisplayTemplate>
          <span style="color: @CornerkickApp.Controllers.Member.PlayerController.getColorFromValue(0, context.fCondi)">
            @((context.fCondi * 100f).ToString("0.0"))
          </span>
        </DisplayTemplate>
      </DataGridColumn>
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.fFresh)" Caption="Frische" TextAlignment="Blazorise.TextAlignment.End">
        <DisplayTemplate>
          <span style="color: @CornerkickApp.Controllers.Member.PlayerController.getColorFromValue(1, context.fFresh)">
            @((context.fFresh * 100f).ToString("0.0"))
          </span>
        </DisplayTemplate>
      </DataGridColumn>
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.fMoral)" Caption="Moral" TextAlignment="Blazorise.TextAlignment.End">
        <DisplayTemplate>
          <span style="color: @CornerkickApp.Controllers.Member.PlayerController.getColorFromValue(2, context.fMoral)">
            @((context.fMoral * 100f).ToString("0.0"))
          </span>
        </DisplayTemplate>
      </DataGridColumn>
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.fExperience)" Caption="Spielpr." TextAlignment="Blazorise.TextAlignment.End">
        <DisplayTemplate>
          @((context.fExperience * 100f).ToString("0.0"))
        </DisplayTemplate>
      </DataGridColumn>
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.sForm)" Caption="Form" TextAlignment="Blazorise.TextAlignment.Center">
        <DisplayTemplate>
          @((MarkupString)Controllers.Tool.getFormIcon(context.sForm))
        </DisplayTemplate>
      </DataGridColumn>
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.fLeader)" Caption="FP" TextAlignment="Blazorise.TextAlignment.End">
        <DisplayTemplate>
          @((context.fLeader * 100f).ToString("0.0"))
        </DisplayTemplate>
      </DataGridColumn>
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.fAge)" Caption="Alter" TextAlignment="Blazorise.TextAlignment.Center">
        <CaptionTemplate>
          <Blazorise.Tooltip Text="Hello tooltip">
            @context.Caption
          </Blazorise.Tooltip>
        </CaptionTemplate>
        <DisplayTemplate>
          @(context.fAge.ToString("0"))
        </DisplayTemplate>
      </DataGridColumn>
      @if (DuringGame) {
        <DataGridColumn Field="@nameof(TeamModel.TableTeam.fGrade)" Caption="Note" TextAlignment="Blazorise.TextAlignment.Center">
          <DisplayTemplate>
            @(context.fGrade > 0f ? context.fGrade.ToString("0.0") : "-")
          </DisplayTemplate>
        </DataGridColumn>
      } else {
        <DataGridColumn Field="@nameof(TeamModel.TableTeam.fTalent)" Caption="Tal." DisplayFormat="{0:N1}" TextAlignment="Blazorise.TextAlignment.End" />
        <DataGridColumn Field="@nameof(TeamModel.TableTeam.fSkillIdeal)" Caption="St. ber." DisplayFormat="{0:N1}" TextAlignment="Blazorise.TextAlignment.End" />
      }
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.sCaptain)" Caption="C" TextAlignment="Blazorise.TextAlignment.Center" />
      <DataGridColumn Field="@nameof(TeamModel.TableTeam.sNat)" Caption="Nat." TextAlignment="Blazorise.TextAlignment.Center">
        <DisplayTemplate>
          @((MarkupString)Controllers.Tool.getNatIcon(context.sNat))
        </DisplayTemplate>
      </DataGridColumn>
    </ChildContent>
    <FirstPageButtonTemplate>
      <i class="fa fa-step-backward"></i>
    </FirstPageButtonTemplate>
    <LastPageButtonTemplate>
      <i class="fa fa-step-forward"></i>
    </LastPageButtonTemplate>
    <TotalItemsTemplate></TotalItemsTemplate>
    <TotalItemsShortTemplate></TotalItemsShortTemplate>
    <ItemsPerPageTemplate></ItemsPerPageTemplate>
    <ButtonRowTemplate>
      <button style="height: 100%; border: none" @onclick="switchMobile"><Blazorise.Icon Name="@(_bMobile ? Blazorise.IconName.AngleDown : Blazorise.IconName.AngleUp)"></Blazorise.Icon></button>
    </ButtonRowTemplate>
    <EmptyTemplate>
      <div class="box">
        Keine Spieler ...
      </div>
    </EmptyTemplate>
    <LoadingTemplate>
      Aufstellung wird geladen ...
    </LoadingTemplate>
  </DataGrid>
  @if (selected_player != null && _bMobile) {
    <div class="selected_player_row" @onclick="clearSelectedPlayer">
      <table>
        <TeamTableRow Player="selected_player" nPlStart=nPlStart nPlRes="nPlRes"></TeamTableRow>
      </table>
    </div>
  }
</div>

@code {
