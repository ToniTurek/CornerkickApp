@code {
  [Parameter]
  //public List<LeagueModel.ScorerItem>? ltScorer { get; set; }
  public int iCupId1 { get; set; }

  [Parameter]
  public int iCupId2 { get; set; }

  [Parameter]
  public int iCupId3 { get; set; }

  private List<LeagueModel.ScorerItem>? ltScorer;
  private CornerkickManager.User? _usr;

  bool bVisible = false;
  bool bInteractive = false;

  System.Diagnostics.Stopwatch sw = new System.Diagnostics.Stopwatch();
  double fElapsedTime = 0.0;

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();

#if _WebApp
    _usr = Controllers.Member.MemberController.ckUser(await _auth.GetUserId());
#else
    _usr = CkAppShared.ckMng.ltUser[CkAppShared.iUserActive];
#endif

    GetScorer();
  }

  public async Task Refresh(int _iCupId1, int _iCupId2, int _iCupId3)
  {
    iCupId1 = _iCupId1;
    iCupId2 = _iCupId2;
    iCupId3 = _iCupId3;

    ltScorer = null;
    await GetScorer();

    await InvokeAsync(StateHasChanged);
  }

  private async Task GetScorer()
  {
    sw.Restart();

    if (ltScorer == null) ltScorer = CornerkickApp.Controllers.Member.MemberController.getScorerTable(iCupId1, iCupId2, iCupId3, clb: Controllers.Member.MemberController.ckClub(_usr));
    if (!bInteractive) ltScorer = ltScorer?.Take(50).ToList();

    bool bRefresh = sw.IsRunning;
    sw.Stop();
    fElapsedTime = sw.ElapsedMilliseconds / 1000.0;
    if (bRefresh) await InvokeAsync(StateHasChanged);
  }

  private async Task OnAccordionVisibleChange(bool b)
  {
    bVisible = b;
    if (bVisible) await GetScorer();
  }

  private async Task OnCheckboxChange(object o)
  {
    if (!bool.TryParse(o.ToString(), out bInteractive)) return;

    GetScorer();
  }

  private void OnRowStyling(LeagueModel.ScorerItem pl, DataGridRowStyling styling)
  {
    if (pl.bBold) {
      styling.Style = "font-weight: bold";
    }
  }
}
