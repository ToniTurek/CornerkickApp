            <DataGridColumn Field="@nameof(LeagueModel.KeeperItem.iMinNoGoal)" Caption="Min o Ggt" TextAlignment="Blazorise.TextAlignment.Center" />
            <DataGridColumn Field="@nameof(LeagueModel.KeeperItem.sClubName)" Caption="Verein" TextAlignment="Blazorise.TextAlignment.Center">
              <DisplayTemplate>
                @((MarkupString)context.sClubEmblem)
