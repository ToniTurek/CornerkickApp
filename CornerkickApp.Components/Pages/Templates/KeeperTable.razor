@code {
  [Parameter]
  public int iCupId1 { get; set; }

  [Parameter]
  public int iCupId2 { get; set; }

  [Parameter]
  public int iCupId3 { get; set; }

  private List<LeagueModel.KeeperItem>? ltKeeper { get; set; }
  private CornerkickManager.User? _usr;

  bool bInteractive = false;
  bool bVisible = false;

  System.Diagnostics.Stopwatch sw = new System.Diagnostics.Stopwatch();
  double fElapsedTime = 0.0;

  public static class AppConstants
  {
#if DEBUG
    public const bool IS_DEBUG = true;
#else
    public const bool IS_DEBUG = false;
#endif
  }

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();

#if _WebApp
    _usr = Controllers.Member.MemberController.ckUser(await _auth.GetUserId());
#else
    _usr = CkAppShared.ckMng.ltUser[CkAppShared.iUserActive];
#endif

    GetKeeper();
  }

  public async Task Refresh(int _iCupId1, int _iCupId2, int _iCupId3)
  {
    iCupId1 = _iCupId1;
    iCupId2 = _iCupId2;
    iCupId3 = _iCupId3;

    ltKeeper = null;
    await GetKeeper();
  }

  private async Task GetKeeper()
  {
    sw.Restart();

    if (ltKeeper == null) ltKeeper = CornerkickApp.Controllers.Member.MemberController.getKeeperTable(iCupId1, iCupId2, iCupId3, clb: Controllers.Member.MemberController.ckClub(_usr));
    if (!bInteractive) ltKeeper = ltKeeper?.Take(50).ToList();

    bool bRefresh = sw.IsRunning;
    sw.Stop();
    fElapsedTime = sw.ElapsedMilliseconds / 1000.0;
    if (bRefresh) InvokeAsync(StateHasChanged);
  }

  private async Task OnCheckboxChange(object o)
  {
    if (!bool.TryParse(o.ToString(), out bInteractive)) return;

    GetKeeper();
  }

  private async Task OnAccordionVisibleChange(bool b)
  {
    bVisible = b;
    if (bVisible) GetKeeper();
  }

  private void OnRowStyling(LeagueModel.KeeperItem pl, DataGridRowStyling styling)
  {
    if (pl.bBold) {
      styling.Style = "font-weight: bold";
    }
  }
}
