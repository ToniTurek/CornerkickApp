  } else {
    if (ltKeeper.Count > 0) {
      <div class="table-fixed-header" style="width: fit-content; max-width: 100%; height: 22rem; max-height: 500px; overflow: auto; font-size: 90%;">
        <table class="b-table table table-striped table-sm b-datagrid" style="white-space: nowrap; margin-bottom: 0">
          <thead>
            <tr>
              <th scope="col" class="cursor-pointer text-end">
                <div class="d-inline-flex"></div>
              </th>
              <th scope="col" class="cursor-pointer">
                <div class="d-inline-flex">Spieler</div>
              </th>
              <th scope="col" class="cursor-pointer text-center">
                <div class="d-inline-flex">geh.</div>
              </th>
              <th scope="col" class="cursor-pointer text-center">
                <div class="d-inline-flex">Sp o Ggt</div>
              </th>
              <th scope="col" class="cursor-pointer text-center">
                <div class="d-inline-flex">Min o Ggt</div>
              </th>
              <th scope="col" class="cursor-pointer text-center">
                <div class="d-inline-flex">Verein</div>
              </th>
            </tr>
          </thead>
          <tbody>
            @foreach (LeagueModel.KeeperItem ki in ltKeeper) {
              <tr class="table-row-selectable" style="font-weight: @(ki.bBold ? "bold" : "normal")">
                <td class="text-end">@ki.iIx</td>
                <td data-caption="Spieler">
                  <a href="/member/playerdetails/@ki.iId" style="text-decoration: none">@ki.sPlName</a>
                </td>
                <td class="text-center" data-caption="Tore">@ki.fSaves.ToString("0.0%")</td>
                <td class="text-center" data-caption="Vorl.">@ki.iGamesNoGoal</td>
                <td class="text-center" data-caption="Sc.">@(ki.iMinNoGoal)</td>
                <td class="text-center" data-caption="Verein">
                  @((MarkupString)ki.sClubEmblem)
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    } else {
      <div class="box">
        Noch keine Torhüter ...
      </div>
    }
  }
  @if (fElapsedTime > 0.0 && AppConstants.IS_DEBUG) {
    <div>
      Elapsed time: @(fElapsedTime.ToString("0.000")) s
    </div>
  }
}
