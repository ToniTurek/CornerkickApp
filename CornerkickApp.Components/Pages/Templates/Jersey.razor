  private List<string> getOtherColors(string sClCurrent)
  {
  List<string> sClOthers = new List<string>();

  foreach (string s in ltClIni) {
    if (s.Equals(sClCurrent)) continue;
    if (sClOthers.Contains(s)) continue;
    sClOthers.Add(s);
  }

  /*
  for (int i = 0; i < ltClIni.Count; i++) {
