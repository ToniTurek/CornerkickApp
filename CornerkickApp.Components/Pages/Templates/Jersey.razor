@using CornerkickApp.Shared.Models

@inject HttpClient Http

<head>
  <style>
    .jersey {
      background-color: white;
      border-style: outset;
      border-width: 3px;
      border-color: gray;
      padding: 4px;
      margin-right: 10px;
    }
  </style>
</head>

@if (sCl != null && sCl.Length > 2) {
  <div style="display: flex">
    <div class="form-group" style="margin-top: 6px; margin-right: 20px">
      @if (Header) {
        <div style="width: 100%; text-align: center">@sHA[iSet]</div>
      }
      <div style="display: flex">
        <div class="jersey">
          <div style="position: relative; height: 114px">
            <div style="position: relative; top: 0px; left: 0px; width: 96px; height: auto; background-color: @sCl[0]">
              <img style="position: relative; top: 0px; left: 0px; width: 100%" src="@CornerkickApp.Shared.Models.CkAppShared.sContentDir/Icons/jersey.png" />
              @{
                if (iNb > 0) {
                  <div style="position: absolute; top: 12px; right: 0px; width: 100%; color: @sCl[2]; text-align: center; font-size: 44px">@iNb.ToString()</div>
                } else {
                  <div style="position: absolute; top: 12px; width: 94px; margin-left: 12px; display: flex; align-items: center">
                    @{
                      string sStyle = "font-size: 38px; text-align: center; background-color: transparent; color: " + sCl[2];
                    }
                    <Blazorise.Select TValue="int" SelectedValue="@(-iNb)" SelectedValueChanged="@setNo" class="form-control" style="@sStyle">
                      @if (ltNbFree != null) {
                        @foreach (int i in ltNbFree) {
                          <Blazorise.SelectItem Value="@i">@i.ToString()</Blazorise.SelectItem>
                        }
                      }
                    </Blazorise.Select>
                  </div>
                }
              }
            </div>
            <div style="position: absolute; top: 72px; left: 20px; width: 56px; height: 40px; border: 1px solid black; background-color: @sCl[1]"></div>
          </div>
        </div>
        @if (EditColors) {
          <div style="width: 60px">
            <div style="width: 100%; height: 100%; margin-right: 12px; display: flex; flex-direction: column">
              @for (int jC = 0; jC < 3; jC++) {
                int kC = jC;
                <input type="color" style="width: 100%" value="@sCl[kC]" @onchange="(e) => { setClubColor(iSet, kC, e); }" />
                  List<string> sClOthers = getOtherColors(sCl[kC]);
                  if (sClOthers.Count > 0) {
                    <div style="display: flex; flex-shrink: 0; width: 100%; height: 12px">
                      @foreach (string sco in sClOthers) {
                        @*
                        <div style="flex-basis: 100%; background-color: @sco" @onclick="() => setClubColor(iSet, kC, sco)"></div>
                        *@
                        <button type="button" style="flex-basis: 100%; background-color: @sco" @onclick="() => setClubColor(iSet, kC, sco)"></button>
                      }
                    </div>
                  }
                @*
                @defaultColors(iSet, kC, sCl[kC])
                <input type="color" value="@sCl[kC]" @onchange="(e) => { setClubColor(iSet, kC, e.Value.ToString()); }" />
                <Blazorise.ColorEdit ChildContent="@defaultColors(iSet, kC, sCl[kC])" @bind-Color="Color0" />
                <Blazorise.ColorEdit Color="@sCl[kC]" ChildContent="@defaultColors(iSet, kC, sCl[kC])" ColorChanged="(e) => setClubColor(iSet, kC, e.ToString())" />
                *@
              }
            </div>
          </div>
        }
      </div>
    </div>
  </div>
}

@code {
