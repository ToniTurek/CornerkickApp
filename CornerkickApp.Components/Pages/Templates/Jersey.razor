  public async Task draw(int jClubId = -1)
  {
  iClubId = jClubId;

  sCl = getColorArrayFromClub(jClubId, iSet);

  // Set colors for default buttons
  ltClIni = getColorArrayFromClub(jClubId, 0).ToList();
  ltClIni.AddRange(getColorArrayFromClub(jClubId, 1).ToList());

  await InvokeAsync(StateHasChanged);
  }

  public async Task draw(CornerkickManager.Club? clb)
  {
    if (clb == null) return;

    iClubId = clb.iId;

    sCl = getColorArrayFromClub(clb, iSet);

    // Set colors for default buttons
    ltClIni = getColorArrayFromClub(clb, 0).ToList();
    ltClIni.AddRange(getColorArrayFromClub(clb, 1).ToList());

    await InvokeAsync(StateHasChanged);
  }

  private string[] getColorArrayFromClub(int jClubId, int iC)
  {
    return getColorArrayFromClub(CkAppShared.ckMng.ltClubs.Find(c => c.iId == jClubId), iC);
  }

  private string[] getColorArrayFromClub(CornerkickManager.Club? clb, int iC)
  {
    List<string> sClRet = new List<string>();
    if (clb == null) return sCl;

    for (int j = 0; j < (iC == 0 ? clb.cl1.Length : clb.cl2.Length); j++) {
      sClRet.Add(CornerkickApp.Controllers.Tool.convertToHex(iC == 0 ? clb.cl1[j] : clb.cl2[j]));
    }

    return sClRet.ToArray();
  }

  protected Task setClubColor(int iC, int jC, ChangeEventArgs e)
  {
    if (e?.Value == null) return Task.CompletedTask;
    return setClubColor(iC, jC, e.Value.ToString());
  }

  protected async Task setClubColor(int iC, int jC, string? sColor)
  {
    if (string.IsNullOrEmpty(sColor)) return;

    sCl[jC] = sColor;

    CornerkickManager.Club? clb = CkAppShared.ckMng.ltClubs.Find(c => c.iId == iClubId);
    if (clb != null) {
      if (iC == 0) clb.cl1[jC] = System.Drawing.ColorTranslator.FromHtml(sColor);
      else         clb.cl2[jC] = System.Drawing.ColorTranslator.FromHtml(sColor);
    }

    //Task.Run(() => draw(iClubId)).Wait();
    draw(iClubId);

    //ColorChanged(sColor);
    await ColorChanged.InvokeAsync(
      new EventCallbackArgs() {
          i = jC,
          Color = sColor
        }
    );
  }

  private async Task setNo(int jNb)
  {
    iNb = Math.Abs(jNb);
    /*
    bool bOk = Controllers.Member.PlayerController.setPlayerNo(iPlayerId, jNb);

    if (bOk) iNb = -jNb;
    */
    await NumberChanged.InvokeAsync(iNb);
  }

}
