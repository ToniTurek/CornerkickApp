        @Html.DropDownListFor(m => m.sStepsLastSteps, new SelectList(Model.ddlStepsLastSteps, "Value", "Text", 0), new { @class = "form-control", @onchange = "plotPlayerStepsFreshLoss()", id = "ddlStepsLastSteps", @style = "width: 80px" })
