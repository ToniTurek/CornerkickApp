        <label>Antritt:</label>
        @Html.DropDownListFor(m => m.sStepsAcceleration, new SelectList(Model.ddlStepsAcceleration, "Value", "Text", 6), new { @class = "form-control", @onchange = "plotPlayerStepsFreshLoss()", id = "ddlStepsAcceleration", @style = "width: 80px" })
