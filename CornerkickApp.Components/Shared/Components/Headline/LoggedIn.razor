@page "/headline"

@using CornerkickApp.Shared.Models
@using static CornerkickApp.Shared.Models.CkAppShared
@inject HttpClient Http
@inject Controllers.Shared.MyAuthenticationStateProvider _auth

@{
  if (!string.IsNullOrEmpty(sHeadlineDate)) {
    <div style="padding-left: 1.5rem">
      <div style="position: relative; display: flex; align-items: center">
        @if (ucm != null) {
          @*
          <div style="width: 120px; height: 100%; display: flex; align-items: center; justify-content: center" title="Saisonfortschritt">
            <Blazorise.Progress Value="@ucm.iSeasonProgress" Animated Striped Color="Blazorise.Color.Warning" Style="width: 100%" />
            <span style="position: absolute">@((ucm.iSeasonProgress / 100f).ToString("0.0%"))</span>
          </div>
          *@
          <div style="position: absolute; left: -1rem; right: 0; height: 100%; display: flex; align-items: center; justify-content: center" title="Saisonfortschritt">
            <Blazorise.Progress Value="@ucm.iSeasonProgress" Animated Striped Color="Blazorise.Color.Success" Style="width: 100%; opacity: 0.4" />
          </div>
        }

        <a href="member/calendar" id="txtDate" style="text-decoration: none; white-space: nowrap; margin-right: 1rem; z-index: 2">@sHeadlineDate</a>
