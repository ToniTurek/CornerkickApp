@using Blazorise
@using CornerkickApp.Shared.Models

@if (_iProgress >= 0) {
  <div style="position: fixed; width: 400px; max-width: 90%; top: 50%; left: 50%; white-space: nowrap; -webkit-transform: translate(-50%, -50%); transform: translate(-50%, -50%); padding: 6px; background-color: white; border: 2px solid rgb(@CkAppShared.sClCkRgb)">
    <Progress Value="@_iProgress" Max="@_iProgressMax" Animated Striped Color="Color.Success" />
    <text>@_sProgressInfo</text>
  </div>
}

@code {
  int _iProgress = -1;
  int _iProgressMax = 100;
  string _sProgressInfo = "";

  public async Task update(int iProgress, string sProgressInfo, int iProgressMax = 100)
  {
    _iProgress = iProgress;
    _sProgressInfo = sProgressInfo;
    _iProgressMax = iProgressMax;

    await InvokeAsync(StateHasChanged);
  }

  public async Task stop()
  {
    _iProgress = -1;
    _sProgressInfo = "";

    await InvokeAsync(StateHasChanged);
  }
}
