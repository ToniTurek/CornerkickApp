          <Blazorise.ModalHeader>
            <Blazorise.ModalTitle>Spielvorschau</Blazorise.ModalTitle>
            <Blazorise.CloseButton />
          </Blazorise.ModalHeader>
          <Blazorise.ModalBody>
            @if (giPreviewGame != null) {
              <div style="position: relative; width: 100%; max-width: 1000px; height: auto;">
                <div style="position: absolute; top: 0px; left: 0px; text-align: left; width: 15%;">
                  @*
                  @if (giPreviewGame.bCupEmblem != null && giPreviewGame.bCupEmblem.Length > 0) {
                    <img style="width: 100%; object-fit: contain" src="data:image/*;base64,@Convert.ToBase64String(giPreviewGame.bCupEmblem)" onerror="this.onerror=null;this.src='@sErrorImg'" />
                  } else {
                    <img style="width: 100%; object-fit: contain" src="@sErrorImg" />
                  }
                  *@
                  @((MarkupString)giPreviewGame.sCupEmblem)
                </div>
                <div style="position: relative; text-align: center; width: 100%; z-index: 2">
                  <p style="margin: 0px; font-size: 80%;">@giPreviewGame.sGameDate</p>
                  @{
                    string sCupName = giPreviewGame.sCupName;
                    if (giPreviewGame.iMatchday >= 0) sCupName += " - " + (giPreviewGame.iMatchday + 1).ToString() + ". Spieltag";
                  }
                  <p style="font-size: 140%; margin: 0px;">@sCupName</p>
                  @if (_usr?.club?.nextGame != null && _usr.club.nextGame.team[0].iTeamId == _usr.club.iId && _usr.iResp >= CkAppShared.iUserRespFinance && !bGameToStart) {
                    <div style="display: flex; justify-content: center; margin-bottom: 1rem">
                      <Blazorise.Select TValue="int" SelectedValue="iSelectedStadium" SelectedValueChanged="@SetStadium" Style="width: fit-content; max-width: 310px">
                        <Blazorise.SelectItem Value="-1">@CkAppShared.stadiumDefaultTrainingCourt.sName (@CkAppShared.stadiumDefaultTrainingCourt.getSeats().ToString("N0") Pl.)</Blazorise.SelectItem>
                        @if (_usr.club.stadium.getSeats() > 0) {
                          <Blazorise.SelectItem Value="0">@_usr.club.stadium.sName (@_usr.club.stadium.getSeats().ToString("N0"))</Blazorise.SelectItem>
                        }
                        <Blazorise.SelectItem Value="1">@(CkAppShared.stadiumDefaultSmall.sName) (@(CkAppShared.stadiumDefaultSmall.getSeats().ToString("N0")) Pl., @((CkAppShared.iCostRentStadiumDefaultSmall / 1000).ToString())k€/Spiel)</Blazorise.SelectItem>
                        <Blazorise.SelectItem Value="2">@(CkAppShared.stadiumDefaultBig  .sName) (@(CkAppShared.stadiumDefaultBig  .getSeats().ToString("N0")) Pl., @((CkAppShared.iCostRentStadiumDefaultBig   / 1000).ToString())k€/Spiel)</Blazorise.SelectItem>
                      </Blazorise.Select>
                    </div>
                  } else {
                    <p style="margin: 0px; font-size: 80%;">@giPreviewGame.sStadium</p>
                  }
                </div>
                <div class="flex-container" style="display: flex; flex-direction: row; width: 100%;">
                  <div style="width: 50%; text-align: center;">
                    <div style="display: inline-block; width: 20%;">
                      @((MarkupString)giPreviewGame.sClubEmblemH)
                    </div>
                  </div>
                  <div style="width: 50%; text-align: center;">
                    <div style="display: inline-block; width: 20%;">
                      @((MarkupString)giPreviewGame.sClubEmblemA)
                    </div>
                  </div>
                </div>
                <div class="flex-container" style="display: flex; flex-direction: row; width: 100%;">
                  <div style="width: 50%; text-align: center;">
                    <p style="font-size: 130%; font-family: Tahoma; margin: 0px;">@giPreviewGame.sClubNameH</p>
                    <p style="font-size: 70%; font-family: Tahoma;">@giPreviewGame.sClubPlaceH</p>
                  </div>
                  <div style="width: 50%; text-align: center;">
                    <p style="font-size: 130%; font-family: Tahoma; margin: 0px;">@giPreviewGame.sClubNameA</p>
                    <p style="font-size: 70%; font-family: Tahoma;">@giPreviewGame.sClubPlaceA</p>
                  </div>
                </div>
              </div>
            }
            <div @ref=elref></div>
          </Blazorise.ModalBody>
          <Blazorise.ModalFooter>
            <div style="width: 100%; display: flex; align-items: center; justify-content: space-between">
              <div title="Schiedsrichter" style="width: fit-content; border: 1px solid gray; border-radius: 4px; padding: 4px">
                @if (giPreviewGame?.referee != null) {
                  <div style="display: flex; flex-direction: column; align-items: center">
                    <label>
                      <img width="20" src="@CkAppShared.sContentDir/Icons/whistle.png" style="position: relative; top: -6px; margin: 0px;">
                      <u style="margin-left: 4px">@giPreviewGame.referee.sName</u>
                    </label>
                    <div style="display: flex; flex-direction: row">
                      <table>
                        <tr>
                          <td align="right">Qualität:</td>
                          <td align="right">@giPreviewGame.referee.fQuality.ToString("0.0%")</td>
                        </tr>
                        <tr>
                          <td align="right">Härte:</td>
                          <td align="right">@giPreviewGame.referee.fStrict.ToString("0.0%")</td>
                        </tr>
                        <tr>
                          <td align="right">Neutralität:</td>
                          <td align="center">
                            @{
                              string sRefereeNeutral = "smiley" + (int)(Math.Min(giPreviewGame.fRefereeCorrupt, 0.4f) * 10) + ".png";
                            }
                            <img width="22" src="@CkAppShared.sContentDir/Icons/smileys/@sRefereeNeutral" style="position: relative; margin: 0px;">
                          </td>
                        </tr>
                      </table>
                      @if (!bGameToStart && _usr?.iResp >= CkAppShared.iUserRespSecretBalance) {
                        <div style="margin-left: 1rem">
                          <div style="display: flex; align-items: center">
                            <input name="iptCorruptReferee" type="number" class="form-control" min="0" autocomplete="off" style="width: 120px; text-align: right" @bind="iCorruptReferee" />
                            €
                          </div>
                          <button class="form-control" @onclick="CorruptReferee">Schiri bestechen</button>
                        </div>
                      }
                    </div>
                  </div>
                } else {
                  <label>
                    <img width="20" src="@CkAppShared.sContentDir/Icons/whistle.png" style="position: relative; top: -6px; margin: 0px;">
                    Noch nicht zugewiesen
                  </label>
                }
              </div>
              @if (bGameToStart) {
                <Blazorise.Button Color="Blazorise.Color.Primary" Clicked="@kickOff">
                  <img src="@CornerkickApp.Shared.Models.CkAppShared.sContentDir/Icons/whistle-32-white.png" />
                  Anstoß!
                </Blazorise.Button>
              }
            </div>
          </Blazorise.ModalFooter>
        </Blazorise.ModalContent>
      </Blazorise.Modal>

      <Blazorise.Toaster Placement="Blazorise.ToasterPlacement.Bottom">
        <Blazorise.Toast @ref="ckToast" @bind-Visible="@toastVisible" AutohideDelay="2000">
          <Blazorise.ToastHeader>
            <Blazorise.Strong Margin="Blazorise.Margin.IsAuto.FromEnd">Cornerkick</Blazorise.Strong>
          </Blazorise.ToastHeader>
          <Blazorise.ToastBody>
            @((MarkupString)toastMessage)
          </Blazorise.ToastBody>
        </Blazorise.Toast>
      </Blazorise.Toaster>
    }

    @*<RadzenComponents @rendermode="RenderMode.InteractiveAuto" />*@
    <RadzenComponents />
    <RadzenDialog />
  </main>

  <script src="./_content/CornerkickApp.Components/js/site.js"></script>
</div>

