  private bool doPromotion()
  {
    List<CornerkickManager.User> ltUserPromoted = new List<CornerkickManager.User>();
    foreach (CornerkickManager.User usr in CkAppShared.ckMng.ltUser) {
      if (doPromotion(usr, CkAppShared.ckMng.iSeason, CkAppShared.ckMng.dtDatum, ltCups: CkAppShared.ckMng.ltCups)) ltUserPromoted.Add(usr);
    }

#if !_WebApp
    if (ltUserPromoted.Count > 0) {
      //Navigation.NavigateTo("/member/desk");
      string sText = "";
      foreach (CornerkickManager.Main.News news in ltUserPromoted[0].ltNews) {
        if (news.iType == CornerkickManager.Main.iNewsTypeUserPromotion) {
          sText = news.sText;
          foreach (string sRespLvlName in CornerkickManager.Names.sUserRespLvlNames) {
            if (sText.Contains(sRespLvlName)) {
              sText = sText.Replace(sRespLvlName, "<b>" + sRespLvlName + "</b>");
              break;
            }
          }
          break;
        }
      }

      // Update nav menu
      if (navMenu != null) navMenu.refresh();

      // Show balance
      if (headline != null && ltUserPromoted[0].club != null && ltUserPromoted[0].iResp == CkAppShared.iUserRespFinance) {
        headline.Refresh(0, ltUserPromoted[0].club.iBalance, 0, 0);
      }

      // Update user resp. stars
      if (stars != null) stars.updateStarsFlicker(ltUserPromoted[0].iResp);
      if (stars_mobile != null) stars_mobile.updateStarsFlicker(ltUserPromoted[0].iResp);

      // Update desk warnings via trigger service
      if (_triggerSerivce != null) _triggerSerivce.TriggerMethodAsync();

      showPromotionInfo(sText, ltUserPromoted[0].iResp);
    }
#endif

    return ltUserPromoted.Count > 0;
  }
  private bool doPromotion(CornerkickManager.User usr, int iSeason, DateTime dt, List<CornerkickManager.Cup>? ltCups = null)
  {
    if (usr == null) return false;
    if (usr.iResp >= CornerkickManager.Names.sUserRespLvlNames.Length - 1) return false;

    bool bUserPromoted = false;

    if (usr.iResp == 0) {
      if ((dt - usr.dtClubStart).TotalDays > 40.0 + (40.0 / (usr.club.getAttractionFactor(iSeason, ltCups: ltCups, dtNow: dt) * 0.01))) {
        usr.iResp++;
        usr.fSkillPointsFree += (float)usr.iResp;
        bUserPromoted = true;
      }
    } else if (usr.iResp == 1) {
      if ((dt - usr.dtClubStart).TotalDays > 120.0 + (200.0 / (usr.club.getAttractionFactor(iSeason, ltCups: ltCups, dtNow: dt) * 0.01))) {
        usr.iResp++;
        usr.fSkillPointsFree += (float)usr.iResp;
        bUserPromoted = true;
      }
    } else if (usr.iResp > 1) {
      if (iSeason == usr.iResp) {
        usr.iResp++;
        usr.fSkillPointsFree += (float)usr.iResp;
        bUserPromoted = true;
      }
    }

    if (bUserPromoted) {
      CkAppShared.ckMng.sendNews(usr, CornerkickManager.Main.iNewsTypeUserPromotion, sReplace: CornerkickManager.Names.sUserRespLvlNames[usr.iResp]);

      if (usr.iResp == CkAppShared.iUserRespFinance) {
        // Add 5 mio. sponsor bonus for finance plan
        CornerkickManager.Finance.doTransaction(usr.club, CkAppShared.ckMng.dtDatum, 5000000, CornerkickManager.Finance.iTransferralTypeInSponsorBonusYear);

        // Set club balance to ~10 mio. €
        usr.club.iBalance = 9900000 + CkAppShared.random.Next(1000000);
      }
      if (usr.iResp == CkAppShared.iUserRespSponsors) {
        usr.club.ltSponsorOffers.Add(Controllers.App.createDefaultSponsor(CkAppShared.ckMng.ltUser[CkAppShared.iUserActive].iLevel, true, 1));
      }
    }

    return bUserPromoted;
  }

