@using System.Text.Json
@using System.Text.Json.Serialization
@using CornerkickApp.Shared.Models
@using CornerkickApp.Controllers.Member
@using CornerkickApp.Components.Shared.Components
@using Radzen.Blazor

@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http
@inject Radzen.DialogService dialogService
@inject Controllers.App.TriggerService _triggerSerivce
@inject Controllers.Shared.MyAuthenticationStateProvider _auth

@inherits LayoutComponentBase

<head>
  <style>
    div.top-row > a {
      color: white !important;
    }

    div.top-row > button {
      color: white !important;
    }

    .club-border-colors {
      border-left-color: @sCl1;
      border-bottom-color: @sCl2;
      border-right-color: @sCl3;
    }
  </style>
</head>

<div class="page">
  <div class="sidebar">
    <div class="top-row navbar navbar-dark">
      <div class="container-fluid">
        @{
          string sHome = bIsLoggedIn ? "/member/desk" : "";
        }
        <a class="navbar-brand" href="@sHome" style="text-decoration: none;">
          <img src="@CkAppShared.sContentDir/Images/logo_64.png" alt="logo" style="width: 40px">
          Cornerkick
        </a>
      </div>
    </div>
    <div class="sidebar-img">
      <img src="@CkAppShared.sContentDir/Images/CornerFlag.png" alt="logo" style="position: absolute; bottom: 0px; width: 100%">

      @if (bIsLoggedIn) {
        <div id="divSidebarLeft" style="position: absolute; width: 120px; height: 600px; top: 100px; left: 0px">
          @*
          <iframe src="https://rcm-eu.amazon-adsystem.com/e/cm?o=3&p=11&l=ur1&category=amazongeneric&banner=04XC64PQF8225B91CZG2&f=ifr&linkID=69ad9bc9b4c6d65ef48410b92f70dd1c&t=cornerkick08-21&tracking_id=cornerkick08-21" width="120" height="600" scrolling="no" border="0" marginwidth="0" style="border:none;" frameborder="0" sandbox="allow-scripts allow-same-origin allow-popups allow-top-navigation-by-user-activation"></iframe>
          *@
        </div>
      }
    </div>
  </div>

  <main>
    <div class="top-row px-4" style="background-color: @(bLiveGame ? "yellow" : "rgb(" + CkAppShared.sClCkRgb + ")")">
      <div class="user-stars-mobile">
        @if (bLiveGame) {
          <a @onclick="checkNextStepAndContinue" style="cursor: pointer; display: table-cell; width: fit-content; font-weight:bold; color:red; z-Index: 9">@sLiveGameInfo</a>
        } else {
          <Stars_horizontal @ref="stars_mobile"></Stars_horizontal>
        }
      </div>
      <div style="display: flex; flex-direction: row; align-items: center; flex-wrap: nowrap; margin-right: 0">
        @if (iGamesTotal < 1) {
          <NavMenu @ref=navMenu bLiveGame="bLiveGame" />
        }
        <div class="user-stars-wide">
          @if (bLiveGame) {
            <a @onclick="checkNextStepAndContinue" style="cursor: pointer; display: table-cell; width: fit-content; font-size: 120%; font-weight:bold; color:red; z-Index: 9">@sLiveGameInfo</a>
          } else {
            <Stars_horizontal @ref="stars"></Stars_horizontal>
          }
        </div>
      </div>

      <div class="top-row px-2 auth nav-item-action" style="background-color: @(bLiveGame ? "yellow" : "rgb(" + CkAppShared.sClCkRgb + ")")">
        @if (CkAppShared.bWebApp) {
          <LoginDisplay />
        } else {
          if (CkAppShared.ckMng?.ltUser?.Count > 0) {
            if (iGamesTotal > 0) {
              <div style="width: 160px; display: flex; flex-direction: column; align-items: center; justify-content: center">
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center">
                  <Blazorise.Progress Value="@iGamesDone" Max="@iGamesTotal" Animated Striped Color="Blazorise.Color.Warning" Style="width: 100%" />
                  <span style="position: absolute">@((iGamesDone / (float)iGamesTotal).ToString("0.0%"))</span>
                </div>
                <span style="color: white">
                  @sGameInfo
                </span>
              </div>
            } else {
              <a class="nav-link" id="aContinue" @onclick="checkNextStepAndContinue" style="cursor: pointer; display: table-cell; width: fit-content; @(bLiveGame ? "color: red !important" : "")">
                @if (bOnViewGamePage) {
                  <i class="fa fa-caret-left"></i>
                }
                <span class="mobile-hide" id="aContinueText" style="margin-left: 4px; margin-right: 4px">@sNextText</span>
                @if (!bOnViewGamePage) {
                  <i class="@sIconClass"></i>
                }
              </a>
            }
          } else {
            <a href="/privacy" class="nav-link" style="cursor: pointer; display: table-cell; width: fit-content">Impressum</a>
          }
        }
      </div>
    </div>

    @if (_usr != null) {
      <div class="p-0" style="position: sticky; top: 3.5rem; z-index: 8">
        @{
          <div class="d-flex justify-content-between" id="headline_container" style="position: relative; width: 100%; height: 1.6rem; background-color: white; border-width: 2px; border-style: none solid solid solid; border-color: rgb(@CkAppShared.sClCkRgb)">
            <CornerkickApp.Components.Shared.Components.Headline.LoggedIn @ref="headline"></CornerkickApp.Components.Shared.Components.Headline.LoggedIn>
          </div>

          @* Live game link *@
          @*
          if (!string.IsNullOrEmpty(sLiveGameInfo) && !bOnViewGamePage) {
            <div style="position: relative; width: 100%; margin-top: 2px; height: 24px; text-align: center">
              <a href="/member/viewgame/x" style="font-weight:bold; color:red; z-Index: 9">@sLiveGameInfo</a>
            </div>
          }
          *@

#if _WebApp
          if (CkAppShared.settings.bMaintenance || !CkAppShared.settings.bLoginPossible) {
            string sMsg = "ACHTUNG! ";
            if (CkAppShared.settings.bMaintenance) { sMsg += "PROGRAMM INSTABIL."; } else if (!CkAppShared.settings.bLoginPossible) { sMsg += "DEMNÄCHST FINDET EIN UPDATE STATT."; }
            sMsg += " BITTE LOGGEN SIE SICH AUS!";
            <div class="" style="position: relative; width: 100%; margin-top: 6px; margin-bottom: 6px; height: auto; text-align: center; background-color: yellow; border: 2px solid red">
              <strong style="font-size: 24px; color: red">@sMsg</strong>
            </div>
          }
#endif
        }
      </div>
    }

    <div class="@sArticleClass"></div>
    <article class="content">
      @Body
    </article>

    <Tutorial @ref="tutorial"></Tutorial>
    <CkDialog></CkDialog>
    <CkProgressBar @ref="ckProgressBar"></CkProgressBar>
    <ScoutingReport @ref="ckScoutingReport"></ScoutingReport>
