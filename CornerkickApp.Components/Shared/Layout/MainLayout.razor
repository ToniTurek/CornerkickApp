  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender) {
      await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CornerkickApp.Components/js/draw.js");
      await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CornerkickApp.Components/js/Formation.js");
    }
  }

  void setLiveGame()
  {
    if (_usr == null) {
      bLiveGame = false;
      return;
    }

    bLiveGame = CornerkickApp.Controllers.Member.MemberController.checkUserGame2(_usr);

    if (bLiveGame && !bOnViewGamePage) {
      CornerkickManager.Club? clbH = CkAppShared.ckMng.ltClubs.Find(c => c.iId == _usr.game.data.team[0].iTeamId);
      if (clbH == null) return;
      CornerkickManager.Club? clbA = CkAppShared.ckMng.ltClubs.Find(c => c.iId == _usr.game.data.team[1].iTeamId);
      if (clbA == null) return;

      string sClubNameH = string.IsNullOrEmpty(clbH.sNameShort) ? clbH.sName.Substring(0, 5) : clbH.sNameShort;
      string sClubNameA = string.IsNullOrEmpty(clbA.sNameShort) ? clbA.sName.Substring(0, 5) : clbA.sNameShort;

      sLiveGameInfo = CornerkickManager.UI.getMinuteString(_usr.game.tsMinute, false) + ": " +
                      sClubNameH + " vs. " + sClubNameA + " - " +
                      _usr.game.data.team[0].iGoals.ToString() + ":" + _usr.game.data.team[1].iGoals.ToString();
    } else {
      sLiveGameInfo = "";
    }
  }

  void LocationChanged(object sender, LocationChangedEventArgs e)
  {
    string navigationMethod = e.IsNavigationIntercepted ? "HTML" : "code";
    System.Diagnostics.Debug.WriteLine($"Notified of navigation via {navigationMethod} to {e.Location}");

#if !_WebApp
    Pages.Member.ViewGame.bInterruptLiveGame = true;
    bool bOnViewGamePageTmp = bOnViewGamePage;
    bOnViewGamePage = e.Location.Contains("/member/viewgame");
    if (bOnViewGamePageTmp != bOnViewGamePage) setNextButton();

    if (navMenu != null) navMenu.setSaveButtonVisibility();
#endif

    if (navMenu != null) navMenu.close();
    if (tutorial != null) tutorial.Close();
  }

  public static async Task showPreviewGame(IJSRuntime JS, PreviewGameModel.GameInfo? gi, bool bButtonKickoff, TeamModel.Player[][]? ltPlayerGameIni = null)
  {
    if (gi == null) return;

    bGameToStart = bButtonKickoff;
    giPreviewGame = gi;

    await JS.InvokeVoidAsync("showGameIni", elref, JsonSerializer.Serialize(gi), false, null, JsonSerializer.Serialize(ltPlayerGameIni));
    if (modalGameIni != null) await modalGameIni.Show();
  }

#if _WebApp
  private async Task checkNextStepAndContinue()
  {
    Navigation.NavigateTo("member/viewgame/x");
  }

  private async Task kickOff()
  {
  }
#else
  private async Task checkNextStepAndContinue()
  {
    if (navMenu != null) navMenu.close();

    // Get calendar speed setting
    if (_usr != null && _usr.lti.Count > UserOptionsModel.iUserOptionsIxCalSpeed) iCalSpeed = _usr.lti[UserOptionsModel.iUserOptionsIxCalSpeed];

    if (_usr?.ltNews != null) {
      for (int iN = 0; iN < _usr.ltNews.Count; iN++) {
        CornerkickManager.Main.News n = _usr.ltNews[iN];
        n.bRead  = true;
        n.bRead2 = true;
        _usr.ltNews[iN] = n;
      }
    }
    try {
      await checkNextStepAndContinueWork();
    } catch (Exception ex) {
      string sError = "<u>Source:</u><br />" + ex.Source + "<br /><u>Message:</u><br />" + ex.Message + "<br /><u>StackTrace:</u><br />" + ex.StackTrace;
      if (ex.InnerException != null) sError += "<br /><br /><u>InnerException:</u><br />" + ex.InnerException.StackTrace;

      await CkDialog.ckDialog.Show(
        "Error in next",
        sError,
        sButtonCancelText2: ""
      );
    }
  }

  public static void StopCalendar()
  {
    bCalendarRunning = false;
  }

  private async Task checkNextStepAndContinueWork()
  {
    if (_usr == null) return;

    if (bOnViewGamePage) {
      bOnViewGamePage = false;
      await setNextButton();

      Navigation.NavigateTo("/member/desk");
      return;
    }

    bool[] bUserGame = CornerkickApp.Controllers.Member.MemberController.CheckUserGame(_usr);

    progressIndicator = new Progress<int[]>(ReportProgress);

    if (bUserGame[0]) {  // User game running
      bLiveGame = true;
      bOnViewGamePage = true;
      await setNextButton();

      Navigation.NavigateTo("/member/viewgame/x");
    } else {
      bCalendarRunning = !bCalendarRunning;
      await setNextButton();
      await InvokeAsync(StateHasChanged);

      if (bUserGame[1]) {  // User game to start
        continueCalendar(false, true, progress: progressIndicator);
      } else {
        if (bMultiUser) {
          List<CornerkickManager.Main.IgnoreNextWarning> ltWarnIgnore = getIgnoreWarningList(_usr);
          List<CornerkickManager.Main.CalendarReturn> ltCr = CornerkickManager.Main.checkCalendarStart(_usr, CkAppShared.ckMng.dtDatum, CkAppShared.ckMng.dtSeasonStart, CkAppShared.ckMng.dtSeasonEnd, ltWarnIgnore: ltWarnIgnore);
          if (ltCr.Count > 0) {
            CkAppShared.CalendarReturn? crCheck = new CkAppShared.CalendarReturn() {
              ltRet = ltCr
            };
            await handleWarnings(true, crCheck);
            return;
          }
        }

        await checkNextStep();
      }
    }
  }

  void ReportProgress(int[] value)
  {
    iGamesDone = value[0];
    iGamesFailed = value[1];
    iGamesTotal = value[2];

    CornerkickManager.Cup? cup = CkAppShared.ckMng.ltCups.Find(c => c.iId == value[3] && c.iId2 == value[4] && c.iId3 == value[5]);
    if (cup != null) sGameInfo = cup.sName;

    // If all games are done or failed, reset the counters
    if (iGamesDone + iGamesFailed >= iGamesTotal) {
      iGamesDone = 0;
      iGamesFailed = 0;
      iGamesTotal = 0;
      sGameInfo = "";
    }

    //Update the UI to reflect the progress value that is passed back.
    StateHasChanged();
    //await InvokeAsync(StateHasChanged);
  }

  private async Task checkNextStep() {
    bool bStartCalendar = CornerkickApp.Controllers.Member.MemberController.CheckNextUser(true);

    if (bStartCalendar) {
      continueCalendar(false, true, progress: progressIndicator);
    } else {
      bCalendarRunning = false;

      string uri = string.IsNullOrEmpty(CkAppShared.ckMng.ltUser[CkAppShared.iUserActive].sPw) ? "member/desk" : "userpassword";
      Navigation.NavigateTo(uri, true);
    }
  }

  private async Task update(bool bUpdateDesk = false, bool bForce = false)
  {
    if (headline != null) await headline.Refresh();

    //if (bUpdateDesk) await _triggerSerivce.TriggerMethodAsync(bForce);
    if (bUpdateDesk) await _triggerSerivce.TriggerMethodAsync();

    // Update the UI to reflect the progress value that is passed back.
    await InvokeAsync(StateHasChanged);
    //StateHasChanged();
  }

  private static List<CornerkickManager.Main.IgnoreNextWarning> getIgnoreWarningList()
  {
    List<CornerkickManager.Main.IgnoreNextWarning> ltIgnWarn = new List<CornerkickManager.Main.IgnoreNextWarning>();
    foreach (CornerkickManager.User u in CkAppShared.ckMng.ltUser) ltIgnWarn.AddRange(getIgnoreWarningList(u));
    return ltIgnWarn;
  }
  private static List<CornerkickManager.Main.IgnoreNextWarning> getIgnoreWarningList(CornerkickManager.User usr)
  {
    List<CornerkickManager.Main.IgnoreNextWarning> ltIgnWarn = new List<CornerkickManager.Main.IgnoreNextWarning>() {
      new CornerkickManager.Main.IgnoreNextWarning(CornerkickManager.Main.CalendarReturn.SeasonStart,        usr),
      new CornerkickManager.Main.IgnoreNextWarning(CornerkickManager.Main.CalendarReturn.SponsorNotFinished, usr)
    };

    int iUserRespLvl = usr.iResp;

    if (iUserRespLvl < CkAppShared.iUserRespStaff)   ltIgnWarn.Add(new CornerkickManager.Main.IgnoreNextWarning(CornerkickManager.Main.CalendarReturn.StaffNotFinished,   usr)); // Staff not finished (begin of season)
    if (iUserRespLvl < CkAppShared.iUserRespFinance) ltIgnWarn.Add(new CornerkickManager.Main.IgnoreNextWarning(CornerkickManager.Main.CalendarReturn.FinanceNotFinished, usr)); // Finance calculation not finished (begin of season)

    return ltIgnWarn;
  }

  private static void filterCalendarWarnings(CkAppShared.CalendarReturn cr, CornerkickManager.User usr)
  {
    cr.ltRet.Remove(CornerkickManager.Main.CalendarReturn.SeasonStart);        // Start of season
    cr.ltRet.Remove(CornerkickManager.Main.CalendarReturn.SponsorNotFinished); // Sponsor not selected

    int iUserRespLvl = usr.iResp;

    if (iUserRespLvl < CkAppShared.iUserRespStaff)   cr.ltRet.Remove(CornerkickManager.Main.CalendarReturn.StaffNotFinished);   // Staff not finished (begin of season)
    if (iUserRespLvl < CkAppShared.iUserRespFinance) cr.ltRet.Remove(CornerkickManager.Main.CalendarReturn.FinanceNotFinished); // Finance calculation not finished (begin of season)
  }

  private async Task continueCalendar(bool bForce, bool bUserClick, IProgress<int[]>? progress = null)
  {
    if (_usr == null) return;

    //int nWarn = 0;

    if (bForce) bCalendarRunning = true;

    List<CornerkickManager.Main.IgnoreNextWarning> ltWarnIgnore = getIgnoreWarningList();

    while (bCalendarRunning) {
      // Get update frequency
      byte iGetDetails = 0; // Get details every step
      if      (iCalSpeed ==  0) iGetDetails = 9; // Do not get details
      else if (iCalSpeed ==  1) iGetDetails = 1; // Get details at midnight
      else if (iCalSpeed <  11) iGetDetails = 2; // Get details each 2h

      List<CkAppShared.CalendarReturn> ltCr = CornerkickApp.Controllers.Member.MemberController.SetCalenderNext(bForce, ltWarnIgnore: ltWarnIgnore, progress: progress, iGetDetails: iGetDetails);

      // Do promotion
      if (CkAppShared.ckMng.dtDatum.TimeOfDay.Equals(new TimeSpan(08, 00, 00))) { //  8:00 Uhr
        if (CkAppShared.ckMng.dtDatum.DayOfWeek == DayOfWeek.Monday) { // If monday
          if (doPromotion()) break;
        }
      }

      // Check portrait of new players
      if (CkAppShared.ckMng.dtDatum.TimeOfDay.Equals(new TimeSpan(13, 15, 00))) { //  13:15 Uhr (after new jouth player)
        foreach (CornerkickManager.Player p in CkAppShared.ckMng.ltPlayer) {
          if (CornerkickApp.Controllers.Member.PlayerController.getPlayerPortraitId(p) == 0) {
            p.clSkin = Controllers.Member.PlayerController.getSkinFromId((byte)CkAppShared.random.Next(byte.MaxValue));
          }
        }
      }

      bool bUpdate = false;

      if (ltCr != null) {
        //nWarn = cr.ltRet.Count;
        //filterCalendarWarnings(cr, _usr);

        foreach (CkAppShared.CalendarReturn cr in ltCr) {
          bUpdate = bUpdate || cr.bWithDetails;

          if (cr.ltRet.Contains(CornerkickManager.Main.CalendarReturn.SeasonStart) && doPromotion()) break;

          if (cr.ltRet.Count > 0) {
            bCalendarRunning = false;
            CkAppShared.iUserActive = CkAppShared.ckMng.ltUser.IndexOf(cr.user);
            _usr = cr.user;
            await update(bUpdateDesk: true, bForce: true);
            await handleWarnings(bUserClick, cr);
            break;
            //} else if (nWarn > 0) { // If warnings were > 0 before but 0 after filtering, force next step
            //  CornerkickApp.Controllers.Member.MemberController.SetCalenderNext(_usr, true);
          }
          //}
        }
      }

      bUserClick = false;
      bForce = false;

      if (bUpdate) await update(bUpdateDesk: bUpdate);

      // Wait
      if (iCalSpeed > 1) {
        Task tkDelay = Task.Delay(iCalSpeed);
        await tkDelay.ConfigureAwait(false);
        tkDelay.Dispose();
      }
    }

    iGamesDone = 0;
    iGamesFailed = 0;
    iGamesTotal = 0;

    bCalendarRunning = false;

    await setNextButton();
    //await InvokeAsync(StateHasChanged);
  }

  private async Task wait(int iDuration)
  {
    if (iDuration <= 0) return;

    Task tkDelay = Task.Delay(iDuration);
    await tkDelay.ConfigureAwait(false);
    tkDelay.Dispose();
  }

  private async Task setNextButton()
  {
    if (bOnViewGamePage) {
      sNextText = "zum Schreibtisch";
    } else {
      bool[] bUserGame = CornerkickApp.Controllers.Member.MemberController.CheckUserGame(_usr);

      if (bUserGame[0]) {
        sNextText = "zurück zum Spiel";
        sIconClass = "fa fa-futbol";
      } else if (bUserGame[1]) {
        sNextText = "zum Spiel";
        sIconClass = "fa fa-futbol";
      } else {
        if (bCalendarRunning) {
          sNextText = iCalSpeed > 0 ? "stop" : "warten";
          sIconClass = iCalSpeed > 0 ? "fa fa-stop" : "fa fa-hourglass-end";
        } else {
          if (checkReadyForCalendarRunning()) sNextText = "weiter";
          else                                sNextText = "nächster";
          sIconClass = "fa fa-play";
        }
      }
    }

    setLiveGame();

    // This is not allowed here
    await InvokeAsync(StateHasChanged);
    //StateHasChanged();
  }

  private async Task handleWarnings(bool bUserClick, CkAppShared.CalendarReturn cr)
  {
    if (_usr == null) return;

    // If this function was executed by user click (no repetition call) --> show dialogs
    if (bUserClick) {
      // Do the game independent of warnings
      if (cr.ltRet.Contains(CornerkickManager.Main.CalendarReturn.UserGameToStart)) {
        TeamModel.Player[][]? ltPlayerGameIni = CornerkickApp.Controllers.Member.MemberController.getGamePreviewPlayer(_usr);

        // Set stadium
        SetStadium(iSelectedStadium);

        if (cr.gameInfo != null) {
          cr.gameInfo.sStadium = CornerkickApp.Controllers.Member.MemberController.getStadiumInfo(_usr.club.nextGame.stadium);
          await showPreviewGame(JS, cr.gameInfo, true, ltPlayerGameIni: ltPlayerGameIni);
        }

        return;
      }

      // Handle warnings
      for (int i = cr.ltRet.Count - 1; i >= 0; i--) {
        CornerkickManager.Main.CalendarReturn iRet = cr.ltRet[i];

        if (iRet == CornerkickManager.Main.CalendarReturn.Sat1530) {
          await CkDialog.ckDialog.Show(
            "Neue Woche",
            "Neue Woche starten?",
            sButtonOkText2: "weiter",
            actionOnOk: () => rmWarningAndContinueCalendar(iRet, cr)
          );

          return;
        } else if (iRet == CornerkickManager.Main.CalendarReturn.StaffNotFinished) {
          await CkDialog.ckDialog.Show(
            "Personal einstellen",
            "Sie haben noch offene Personalstellen. Trotzdem fortfahren?",
            sButtonOkText2: "weiter",
            actionOnOk: () => rmWarningAndContinueCalendar(iRet, cr)
          );

          return;
        } else if (iRet == CornerkickManager.Main.CalendarReturn.FinanceNotFinished) {
          await CkDialog.ckDialog.Show(
            "Finanzplanung",
            "Sie haben Ihre Finanzplanung noch nicht abgeschlossen. Trotzdem fortfahren?",
            sButtonOkText2: "weiter",
            actionOnOk: () => rmWarningAndContinueCalendar(iRet, cr)
          );

          return;
        } else if (iRet == CornerkickManager.Main.CalendarReturn.TrainingNotSet) { // No training set
          await CkDialog.ckDialog.Show(
            "Training planen?",
            "Sie haben für die nächste Woche noch kein Training angesetzt. Trotzdem fortfahren?",
            sButtonOkText2: "weiter",
            actionOnOk: () => rmWarningAndContinueCalendar(iRet, cr)
          );

          return;
        } else if (iRet == CornerkickManager.Main.CalendarReturn.SeasonEnd) { // Start new season
          CornerkickManager.Cup? l = CkAppShared.ckMng.ltCups.Find(c => c.iId == CkAppShared.iCupIdLeague && c.iId2 == _usr.club.iLand && c.iId3 == _usr.club.iDivision);

          string sEndOfSeasonMessage = _usr.sFirstname + " " + _usr.sSurname + ", dies ist das Ende Ihrer <b>" + CkAppShared.ckMng.iSeason.ToString() + ".</b> Saison.";
          if (l != null) {
            sEndOfSeasonMessage += "<br><br>Sie haben mit Ihrem Verein <b>" + _usr.club.sName +
                                   "</b> die " + l.sName + " auf dem <b>" + l.getPlace(_usr.club, CkAppShared.ckMng.dtDatum).ToString() + ". Platz</b> abgeschlossen.";
          }
          sEndOfSeasonMessage += "<br>";
          foreach (CornerkickManager.Cup? c in CkAppShared.ckMng.ltCups.FindAll(c => c.iId == CkAppShared.iCupIdNatCup && c.iId2 == _usr.club.iLand)) {
            if (c == null) continue;
            int iPlace = c.getPlace(_usr.club, CkAppShared.ckMng.dtDatum);
            if (iPlace > 0) sEndOfSeasonMessage += "<br>Im " + c.sName + " haben Sie den <b>" + iPlace.ToString() + ". Platz</b> belegt.";
          }

          CornerkickManager.Finance.Budget budgetAct = CkAppShared.ckMng.ui.getActualBudget(_usr.club);
          long iInTotal  = CornerkickManager.Finance.getBudgetInTotal(budgetAct);
          long iPayTotal = CornerkickManager.Finance.getBudgetPayTotal(budgetAct);
          string sWinLoose = iInTotal > iPayTotal ? "Gewinn" : "Verlust";
          sEndOfSeasonMessage += "<br><br>Ihr Verein hat in dieser Saison insgesamt einen Attraktivitätsfaktor von <b>" + _usr.club.getAttractionFactor(CkAppShared.ckMng.iSeason, CkAppShared.ckMng.ltCups, CkAppShared.ckMng.dtDatum).ToString("0.0") + "</b> erzielt, " +
          "und dabei einen <b>" + sWinLoose + "</b> von <b style=\"color: " + (iPayTotal > iInTotal ? "red" : "green") + "\">" + (iInTotal - iPayTotal).ToString("N0") + "€</b> erwirtschaftet.";
          sEndOfSeasonMessage += "<br><br>";

          // End of trial version after 3 seasons
          if (CkAppShared.ckMng.iSeason > 3) {
            sEndOfSeasonMessage += "Dies ist das Ende des Spiels. Um eine Vollversion zu erhalten, wenden Sie sich bitte an:<br><br>mail@cornerkick-manager.de";

            await CkDialog.ckDialog.Show(
              "Saisonende",
              sEndOfSeasonMessage,
              sButtonOkText2: ""
            );

            return;
          }

          sEndOfSeasonMessage += "Möchten Sie jetzt die nächste Saison starten?";

          await CkDialog.ckDialog.Show(
            "Saisonende",
            sEndOfSeasonMessage,
            sButtonOkText2: String.Format("Zur {0}. Saison", CkAppShared.ckMng.iSeason + 1),
            actionOnOk: () => StartNewSeason(iRet, cr)
          );

          return;
        } else {
          CornerkickManager.Main.CalendarReturn jRet = iRet;

          /*
          getDialog(
          document.body,
          "Return: " + iRet.ToString(),
          "?",
          function () {
            int index = ltRetTmp.indexOf(jRet);
            if (index > -1) {
              ltRetTmp.splice(index, 1);
              }

            if (ltRetTmp.Count == 0) {
              continueCalendar(true, false);
              }
            }
        );
      */
        }
  }

    if (cr.ltRet.Count == 0) {
      if (checkReadyForCalendarRunning()) continueCalendar(true, false, progress: progressIndicator);
      else                                checkNextStep();
      }
    } else { // If no user click (but returnObj.ltRet.length > 0)
      if (bMultiUser) {
  //window.location.reload(true);
      } else {
  //updateAtMidnight(cr.iBalance, cr.iBalanceSecret);
  await update(true);

  for (var i = cr.ltRet.Count - 1; i >= 0; i--) {
    CornerkickManager.Main.CalendarReturn ckMngCr = cr.ltRet[i];
    if (ckMngCr == CornerkickManager.Main.CalendarReturn.UserGame) { // User game
      sNextText = "zum Spiel";
    } else if (ckMngCr == CornerkickManager.Main.CalendarReturn.SeasonEnd) { // New season
      //window.location.reload(true);
    }
  }
      }
    }
  }

