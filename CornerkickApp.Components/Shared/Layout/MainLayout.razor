  private void SetStadium(int i)
  {
    iSelectedStadium = i;

    if (_usr == null) return;

    if (_usr.lti == null) _usr.lti = new List<int>();
    while (_usr.lti.Count <= UserOptionsModel.iUserOptionsIxStadium) _usr.lti.Add(0);

    _usr.lti[UserOptionsModel.iUserOptionsIxStadium] = iSelectedStadium;

    if (_usr?.club?.nextGame != null && _usr.club.nextGame.team[0].iTeamId == _usr.club.iId) {
      // Set stadium for next game
      if      (iSelectedStadium ==  0) _usr.club.nextGame.stadium = _usr.club.stadium;
      else if (iSelectedStadium ==  1) _usr.club.nextGame.stadium = CkAppShared.stadiumDefaultSmall        .Clone();
      else if (iSelectedStadium ==  2) _usr.club.nextGame.stadium = CkAppShared.stadiumDefaultBig          .Clone();
      else if (iSelectedStadium == -1) _usr.club.nextGame.stadium = CkAppShared.stadiumDefaultTrainingCourt.Clone();
    }
  }

  public async Task CorruptReferee()
  {
    if (iCorruptReferee < 1) return;
    if (_usr?.club?.nextGame == null) return;

    CornerkickManager.Club clb = _usr.club;
    if (clb.iBalanceSecret < iCorruptReferee && ckToast != null) {
      toastMessage = "Leider haben Sie nicht mehr genug Kleingeld in der schwarzen Kasse...";
      await ckToast.Show();
      return;
    }

    int iBalanceStart = clb.iBalance;
    int iBalanceSecretStart = clb.iBalanceSecret;

    for (byte iHA = 0; iHA < 2; iHA++) {
      if (clb.iId == clb.nextGame.team[iHA].iTeamId) {
        clb.nextGame.team[iHA].fRefereeCorrupt += (float)(iCorruptReferee / 1E6); // 1% corruption per 10.000€
        clb.nextGame.team[iHA].fRefereeCorrupt = Math.Min(clb.nextGame.team[iHA].fRefereeCorrupt, 0.5f); // Max 50% corruption with 500.000€
        //fCorruptFactor = clb.nextGame.team[iHA].fRefereeCorrupt;
        clb.iBalanceSecret -= iCorruptReferee;
        if (giPreviewGame != null) giPreviewGame.fRefereeCorrupt = clb.nextGame.getRefereeCorrupt();
        break;
      }
    }

    //modalGameIni.Show();
    if (MainLayout.headline != null) MainLayout.headline.Refresh(iBalanceStart: iBalanceStart, iBalance: clb.iBalance, iBalanceSecretStart: iBalanceSecretStart, clb.iBalanceSecret);

    iCorruptReferee = 0;

    if (ckToast != null) {
      toastMessage = "Der Schiedsrichter steckt das Geld ein und zieht pfeifend von dannen...";
      await ckToast.Show();
    }
  }

  public class BrowserService
  {
    private readonly IJSRuntime _js;

    public BrowserService(IJSRuntime js)
    {
      _js = js;
    }

    public async Task<BrowserDimension> GetDimensions()
    {
      try {
        return await _js.InvokeAsync<BrowserDimension>("getDimensions");
      } catch {
        return new BrowserDimension();
      }
    }

    public async Task<BrowserDimension> GetObjectDimensions()
    {
      return await _js.InvokeAsync<BrowserDimension>("getDimensions");
    }
  }

  public class BrowserDimension
  {
    public int Width { get; set; }
    public int Height { get; set; }
  }

}
