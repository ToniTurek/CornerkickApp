  protected override async Task OnInitializedAsync()
  {
#if _WebApp
    var identity = await _auth.GetIdentity();

    if (identity != null) {
      bIsLoggedIn = identity.IsAuthenticated;
    }
#else
    bIsLoggedIn = CkAppShared.ckMng.ltUser.Count > 0;
#endif

    if (bIsLoggedIn) {
      await refresh(bGetUser: true);
    }
  }

  public async Task refresh(bool bGetUser = false)
  {
    if (bGetUser) {
#if _WebApp
      _usr = Controllers.Member.MemberController.ckUser(_auth.GetUserId().Result);
#else
      _usr = CkAppShared.ckMng.ltUser[CkAppShared.iUserActive];
#endif
    }

    if (_usr != null) {
      iUserRespLevel = _usr.iResp;

      CornerkickManager.Club? _clb = CornerkickApp.Controllers.Member.MemberController.ckClub(_usr);

      if (_clb != null) {
        iLand = _clb.iLand;
        iDiv = _clb.iDivision;
        bNation = _clb.bNation;
      }

#if !_WebApp
      setSaveButtonVisibility();
#endif
    }
    await InvokeAsync(StateHasChanged);
  }
  public Task close()
  {
    Task tk = ToggleNavMenu(-9);
    refresh();
    return tk;
  }
  private Task ToggleNavMenu(int i)
  {
    if (i < 0) {
      if (i == -1) collapseNavMenu = !collapseNavMenu;
      else         collapseNavMenu = true;

      for (int j = 0; j < expandSubNav.Length; j++) expandSubNav[j] = false;
    } else {
      for (int j = 0; j < expandSubNav.Length; j++) {
        if (j == i) expandSubNav[j] = !expandSubNav[j];
        else        expandSubNav[j] = false;
      }

      /*
      if (!expandSubNav[i]) {
        collapseNavMenu = true;
      }
      */
    }

    return Task.CompletedTask;
  }
  public Task setSaveButtonVisibility()
  {
    saveButtonHidden = string.IsNullOrEmpty(CkAppShared.sFileCk) || Controllers.Member.MemberController.checkUserGame2(_usr);
    saveAsButtonHidden = Controllers.Member.MemberController.checkUserGame2(_usr);
    StateHasChanged();
    return Task.CompletedTask;
  }

