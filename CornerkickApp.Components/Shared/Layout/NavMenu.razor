        }

        if (MainLayout.ckToast != null) {
          MainLayout.toastMessage = "Spielstand <b>" + Path.GetFileNameWithoutExtension(CkAppShared.sFileCk) + "</b> gespeichert" + (bUploadOk ? " und hochgeladen" : "");
          await MainLayout.ckToast.Show();
        }
        //await CommunityToolkit.Maui.Alerts.Toast.Make($"Spiel gespeichert", ToastDuration.Long).Show();
      } else if (!string.IsNullOrEmpty(retSave.sError)) {
        CkAppShared.ckMng.tl.writeLog(retSave.sError, bError: true);
      } else if (!string.IsNullOrEmpty(retSave.sWarning)) {
        CkAppShared.ckMng.tl.writeLog(retSave.sWarning, bError: true);
      }
    } catch (Exception e) {
      string sErrorMsg = "ERROR saving game. Message: " + e.Message + Environment.NewLine + e.StackTrace;
      CkAppShared.ckMng.tl.writeLog(sErrorMsg);
    }

    saveButtonDisabled = false;
    await InvokeAsync(StateHasChanged);
  }

  public async Task endGame()
  {
    await CkDialog.ckDialog.Show(
      "Spiel beenden?",
      "Möchten Sie das aktuelle Spiel beenden? Nicht gespeicherte Daten gehen verloren.",
      actionOnOk: () => {
        //CkAppShared.ckMng.tl.writeLog("Game ended by user.");
        clearCkMng();
        CkAppShared.sFileCk = "";
        saveButtonHidden = true;
        saveAsButtonHidden = true;
        NavMng.NavigateTo("/", forceLoad: true);
      }
    );
  }

  public static void clearCkMng()
  {
    CkAppShared.ckMng.ltUser.Clear();
    CkAppShared.ckMng.ltClubs.Clear();
    CkAppShared.ckMng.ltPlayer.Clear();
    CkAppShared.ckMng.ltCups.Clear();
    CkAppShared.ckMng.ltTransfer.Clear();
    CkAppShared.ckMng.ltStadiums.Clear();
  }
#endif

}
