@page "/login"
@inject MauiAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS;

<EditForm Model="LoginModel" OnValidSubmit="LoginUser" FormName="login">
    <DataAnnotationsValidator />
    <Microsoft.AspNetCore.Components.Forms.ValidationSummary />
    <div class="alert alert-danger" hidden="@loginFailureHidden">
        @AuthStateProvider.LoginFailureMessage
    </div>
    <div style="display: flex; flex-direction: row">
      <div class="form-group" style="margin-right: 1rem">
          <label>Email</label>
          <InputText id="email" type="email" @bind-Value="LoginModel.Email" @onclick="(async() => await ScrollTo())" class="form-control" />
      </div>
      <div class="form-group">
          <label>Passwort</label>
          <InputText id="password" type="password" @bind-Value="LoginModel.Password" class="form-control" />
      </div>
    </div>
    <div class="form-group mt-1">
        <button type="submit" class="btn btn-primary w-100" style="background-color: orchid; border-color: blueviolet">einloggen</button>
    </div>

    <a href="https://cornerkick-manager.de/Account/Register">registrieren</a>

</EditForm>

@code {
    [Parameter]
    public Action<LoginRequest> GetLoginData { get; set; }

    public LoginRequest LoginModel { get; set; } = new();
    private bool loginFailureHidden = true;

    protected override void OnInitialized()
    {
        if (AuthStateProvider.LoginStatus == LoginStatus.Failed)
        {
            loginFailureHidden = false;
        }
    }

    private async Task LoginUser()
    {
        GetLoginData?.Invoke(LoginModel);

        await AuthStateProvider.LogInAsync(LoginModel);

        if (AuthStateProvider.LoginStatus != LoginStatus.Success)
        {
            loginFailureHidden = false;
            return;
        }

        //Navigation.NavigateTo(""); //Root URL
    }

    async Task ScrollTo()
    {
      await JS.InvokeVoidAsync("ScrollTo", "email");
    }
}
