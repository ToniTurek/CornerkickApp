  private async Task setCupNGroups(CornerkickManager.Cup? cup, object? o)
  {
    if (cup == null) return;
    if (o == null) return;

    byte nGroups;
    if (!byte.TryParse(o.ToString(), out nGroups)) return;

    cup.settings.nGroups = nGroups;

    List<CornerkickManager.Club> ltClubsOld = new List<CornerkickManager.Club>();
    foreach (List<CornerkickManager.Club> lc in cup.ltClubs) ltClubsOld.AddRange(lc);
    cup.ltClubs = new List<CornerkickManager.Club>[nGroups];
    for (int i = 0; i < nGroups; i++) cup.ltClubs[i] = new List<CornerkickManager.Club>();

    // Distribute clubs into new groups
    for (int i = 0; i < ltClubsOld.Count; i++) cup.ltClubs[i % nGroups].Add(ltClubsOld[i]);

    await changeCup(cup);

    //InvokeAsync(StateHasChanged);
  }

