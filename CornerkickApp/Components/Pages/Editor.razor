  protected void changeCkMngCup(CornerkickManager.Cup? cup)
  {
    changeCup(cup);
  }
  protected Task changeCup(string sCupIds)
  {
    int iId  = -1;
    int iId2 = -1;
    int iId3 = -1;
    string[] sIds = sCupIds.Split('_');
    if (sIds.Length > 2) {
      iId  = int.Parse(sIds[0]);
      iId2 = int.Parse(sIds[1]);
      iId3 = int.Parse(sIds[2]);
    }

    //return changeCup(CkAppShared.ckMng.ltCups.Find(c => c.sName.Equals(sCupName)));
    return changeCup(CkAppShared.ckMng.ltCups.Find(c => c.iId == iId && c.iId2 == iId2 && c.iId3 == iId3));
  }
  private Task changeCup(Cup cup)
  {
    if (cup == null) return Task.CompletedTask;
    return changeCup(CkAppShared.ckMng.ltCups.Find(c => c.iId == cup.iId && c.iId2 == cup.iId2 && c.iId3 == cup.iId3));
  }
  protected async Task changeCup(CornerkickManager.Cup? cup)
  {
    if (cup == null) return;

    if (cup.iId == CkAppShared.iCupIdNatCup) {
      cup.iId3 = Math.Max(cup.iId3, 0);
    }

    selectedCupName = getCupIdString(cup);

    selected_cup = new Cup();
    selected_cup.iId  = cup.iId;
    selected_cup.iId2 = cup.iId2;
    selected_cup.iId3 = cup.iId3;
    selected_cup.sName = cup.sName;
    selected_cup.iDayOfWeek = cup.settings.iDayOfWeek;
    selected_cup.toTimeOfDay = TimeOnly.FromTimeSpan(cup.settings.tsTimeOfDay);
    if (selected_cup.toTimeOfDay.Equals(TimeOnly.MinValue)) selected_cup.toTimeOfDay = new TimeOnly(15, 30);
    if (cupTimePicker != null) {
      cupTimePicker.TimeValue = selected_cup.toTimeOfDay;
      cupTimePicker.refresh();
    }
    selected_cup.iStart = cup.settings.iStart;
    selected_cup.iEnd   = cup.settings.iEnd;
    if (cup.ltMatchdays != null && cup.ltMatchdays.Count > 0) {
      selected_cup.dtStart = cup.ltMatchdays[0].dt;
      selected_cup.dtEnd   = cup.ltMatchdays[cup.ltMatchdays.Count - 1].dt;
      selected_cup.nMatchdays = cup.ltMatchdays.Count;
    }

    selected_cup.nClubs = cup.getClubsTotal();
    foreach (CornerkickManager.Club clb in cup.getParticipants()) {
      float[] fTeamAve = CornerkickManager.Tool.getTeamAve(clb, CkAppShared.ckMng.dtDatum, CkAppShared.ckMng.dtSeasonEnd, bIdeal: true, bTeamValue: true);
      Services.Emblem? ce = ltClubEmblem.Find(ce => ce.iId == clb.iId);

      selected_cup.ltClubs.Add(
        new Club() {
          iId = clb.iId,
          sName = clb.sName,
          fSkillAve = fTeamAve[3],
          fAgeAve = fTeamAve[4],
          fValueAve = fTeamAve[5],
          iNat = clb.iLand,
          bEmblem = ce == null ? await CornerkickApp.Services.StartGameService.loadMediaDataClub(dbfile2, clb.iId) : ce.bEmblem
        }
      );
    }

