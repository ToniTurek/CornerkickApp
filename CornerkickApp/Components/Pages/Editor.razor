@page "/editor/{dbfile?}"

@using System.Text.Json
@using System.Text.Json.Serialization
@using CommunityToolkit.Maui.Core
@using CommunityToolkit.Maui.Storage
@using CommunityToolkit.Maui.Alerts
@using CornerkickApp.Controllers
@using CornerkickApp.Components.Shared.Components
@using CornerkickApp.Components.Pages.Templates
@using CornerkickApp.Shared.Models

@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IFolderPickerService folderPickerService

<PageTitle>Spielerdetails</PageTitle>

<!DOCTYPE html>
<html>
<head>
</head>

<body class="@sClassDisabled" style="margin-bottom: 4rem">
  <h3>Datenbank: @dbfile2</h3>

  @{
#if ANDROID
    //string sFilter = "application/octet-stream,application/xml";
    string sFilter = "";
#else
    string sFilter = ".ckdbx,.xml.zip,.xml";
#endif
  }
  <div style="width: fit-content; max-width: 100%; margin-top: 20px; display: flex; flex-wrap: wrap; flex-direction: row">
    <div style="margin-right: 1rem; margin-bottom: 1rem">
      <input class="form-control" placeholder="Name Datensatz" style="width: 100%; min-width: 160px; margin-bottom: 4px" @bind="dbfile2" />
      <div style="display: flex; flex-direction: row; margin-bottom: 4px; flex-wrap: wrap">
        <Button Color="Blazorise.Color.Primary" Clicked="@saveDatabase" Disabled="@string.IsNullOrEmpty(dbfile2)" Style="white-space: nowrap; margin-right: 4px; flex: 1">Datensatz speichern</Button>
        <Select TValue="int" @bind-SelectedValue="iFileFormat" Style="width: 84px">
          <SelectItem Value="0">ckdb</SelectItem>
          <SelectItem Value="1">XML</SelectItem>
        </Select>
      </div>
      <FileEdit Multiple Changed="@importDb" Written="@OnWritten" Progressed="@OnProgressed" Ended="@OnEnded" Filter="@sFilter" Placeholder="Daten importieren" Style="width: 100%" />
      <Button Color="Blazorise.Color.Success" Clicked="@goBack" Style="width: 100%; margin-top: 4px">zurück</Button>
    </div>

    @*
    <div>
      <FileEdit Multiple Changed="@importDb" Written="@OnWritten" Progressed="@OnProgressed" Ended="@OnEnded" Filter="@sFilter" Placeholder="Datensatz importieren" Style="width: 100%" />
      <Button Color="Blazorise.Color.Info" Clicked="@exportDatabaseXML" Style="width: 100%; margin-top: 4px">
        <img height=24 src="./_content/CornerkickApp.Components/Content/Images/xml.png" />
        XML Datensatz exportieren
      </Button>
      <Button Color="Color.Secondary" Clicked="@importTmDataset" Style="width: 100%; margin-top: 4px">Datensatz importieren</Button>
    </div>
    *@
  </div>
  <div style="width: 100%; margin-top: 12px; display: @( string.IsNullOrEmpty(sProgressType) ? "none" : "block" )">
    <Progress Value="@iProgress" Animated Striped Color="Blazorise.Color.Success" />
    <p>@sProgressType</p>
  </div>
  <Blazorise.Tabs SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged" Style="margin-top: 12px">
    <Items>
      <Blazorise.Tab Name="tabOverview">
        <Blazorise.Icon Name="Blazorise.IconName.Circle" />Übersicht
      </Blazorise.Tab>
      <Blazorise.Tab Name="tabCups">
        <Blazorise.Icon Name="Blazorise.Icons.FontAwesome.FontAwesomeIcons.Trophy" />Wettbewerbe
      </Blazorise.Tab>
      <Blazorise.Tab Name="tabClubs">
        <Blazorise.Icon Name="Blazorise.IconName.Shield" />Vereine
      </Blazorise.Tab>
      <Blazorise.Tab Name="tabPlayer">
        <Blazorise.Icon Name="Blazorise.IconName.Users" />Spieler
      </Blazorise.Tab>
    </Items>
    <Content>
      <TabPanel Name="tabOverview">
        <div id="tab-1" style="margin-top: 10px">
          <EditorOverview @ref="editorOverview" changeCup="changeCkMngCup" deleteClub="deleteCkMngClub"></EditorOverview>
        </div>
      </TabPanel>
      <TabPanel Name="tabCups">
        <div id="tab-2" style="margin-top: 10px; overflow: auto">
          <Select SelectedValue="@selectedCupName" SelectedValueChanged="changeCup" TValue="string">
            @{
              foreach (CornerkickManager.Cup cup in CkAppShared.ckMng.ltCups) {
                <SelectItem Value="@getCupIdString(cup)">@getCupName(cup)</SelectItem>
              }
            }
          </Select>

          @if (selected_cup != null) {
            CornerkickManager.Cup? c = CkAppShared.ckMng.ltCups.Find(c => c.iId == selected_cup.iId && c.iId2 == selected_cup.iId2 && c.iId3 == selected_cup.iId3);

            int iCupTypeIx = Array.IndexOf(iCupIds, selected_cup.iId);
            if (iCupTypeIx >= 0 && iCupTypeIx < sCupNames.Length) {
              <h5>Typ: <span style="font-weight: normal">@sCupNames[Array.IndexOf(iCupIds, selected_cup.iId)]</span></h5>
            }

            <h5>Wappen</h5>
            @if (isLoading) {
              <p>Uploading ...</p>
            } else {
              @if (selected_cup.bEmblem != null) {
                <img style="height: 150px; object-fit: contain; margin-bottom: 6px" src="data:image/*;base64,@Convert.ToBase64String(selected_cup.bEmblem)" />
              }
              <p>
                <InputFile OnChange="loadCupEmblem" accept="image/*" />
              </p>
            }

            <div style="display: flex; flex-wrap: wrap; max-width: 100%">
              <div style="margin-right: 1rem; margin-bottom: 1rem">
                <h5>Einstellungen</h5>
                <div style="overflow: auto">
                  <table class="cup_settings">
                    @if (selected_cup.iId != CkAppShared.iCupIdWc) {
                      <tr>
                        <td style="text-align: right">Wochentag</td>
                        <td>
                          <Select TValue="int" SelectedValue="selected_cup.iDayOfWeek" SelectedValueChanged="setCupDayOfWeek">
                            @for (int i = 0; i < 7; i++) {
                              DateTime dt = CkAppShared.ckMng.dtSeasonStart.AddDays(i+1);
                              int iDoW = (int)dt.DayOfWeek;
                              <SelectItem Value="@iDoW">@dt.ToString("ddd")</SelectItem>
                            }
                          </Select>
                        </td>
                      </tr>
                    } else {
                      <tr>
                        <td style="text-align: right">Austragung jedes N Jahr</td>
                        <td>
                          <input type="number" min="0" style="width: 46px; text-align: right" value="@selected_cup.nYears" @onchange="(e) => setCupEveryYear(e.Value)" />
                        </td>
                      </tr>
                    }
                    <tr>
                      <td style="text-align: right">Anstoßzeit</td>
                      <td>
                        <RadzenTimePicker @ref="cupTimePicker" Name="CupTimeOfDay" TimeValue="@selected_cup.toTimeOfDay" TimeValueChanged="setCupTimeOfDay"></RadzenTimePicker>
                      </td>
                    </tr>
                    @if (selected_cup.iId != CkAppShared.iCupIdWc) {
                      <tr>
                        <td style="text-align: right">Startwoche (&lt; 0: von Saisonende)</td>
                        <td>
                          @*
                          <Radzen.Blazor.RadzenDatePicker TValue="DateTime?" Value=@selected_cup.dtStart InitialViewDate="CkAppShared.ckMng.dtSeasonStart" DateFormat="dd.MM." ShowCalendarWeek Change="@(args => setCupStart(args.Value))" Name="RadzenDatePickerChangeEvent" Style="width: 90px" />
                          *@
                          <input type="text" inputmode="numeric" style="width: 46px; text-align: right" value="@selected_cup.iStart" @onchange="(e) => setCupStart(e.Value)" />
                        </td>
                      </tr>
                      <tr>
                        <td style="text-align: right">Endwoche (&le; 0: von Saisonende)</td>
                        <td>
                          @*
                          <Radzen.Blazor.RadzenDatePicker TValue="DateTime?" Value=@selected_cup.dtEnd InitialViewDate="CkAppShared.ckMng.dtSeasonEnd" DateFormat="dd.MM." ShowCalendarWeek Change="@(args => setCupEnd(args.Value))" Name="RadzenDatePickerChangeEvent" Style="width: 90px" />
                          *@
                          <input type="text" inputmode="numeric" style="width: 46px; text-align: right" value="@selected_cup.iEnd" @onchange="(e) => setCupEnd(e.Value)" />
                        </td>
                      </tr>
                    }
                    <tr>
                      <td style="text-align: right">Anzahl Gruppen</td>
                      <td>
                        <input type="number" style="width: 46px; text-align: right" value="@selected_cup.nGroups" @onchange="(e) => setCupNGroups(selected_cup, e.Value)" />
                      </td>
                    </tr>
                    @if (selected_cup.nGroups > 0) {
                      <tr>
                        <td style="text-align: right">Gruppenphase Hin- & Rückspiel</td>
                        <td>
                          <input type="checkbox" checked="@selected_cup.bGroupsTwoGames" @onchange="(e) => setCupBGroupTwoGames(selected_cup, e.Value)" />
                        </td>
                      </tr>
                    }
                    <tr>
                      <td style="text-align: right">KO-Phase</td>
                      <td>
                        <input type="checkbox" checked="@selected_cup.bKo" @onchange="(e) => setCupBKo(selected_cup, e.Value)" />
                      </td>
                    </tr>
                    @if (selected_cup.bKo && selected_cup.nGroups > 0) {
                      <tr>
                        <td style="text-align: right">Anzahl Qualif. für KO-Phase pro Gruppe</td>
                        <td>
                          <input type="number" min="0" style="width: 46px; text-align: right" value="@selected_cup.nQualifierKo" @onchange="(e) => setCupNQualiKo(selected_cup, e.Value)" />
                        </td>
                      </tr>
                    }
                    @if (selected_cup.bKo) {
                      <tr>
                        <td style="text-align: right">KO-Phase Hin- & Rückspiel</td>
                        <td>
                          <input type="checkbox" checked="@selected_cup.bKoTwoGames" @onchange="(e) => setCupBKoTwoGames(selected_cup, e.Value)" />
                        </td>
                      </tr>
                    }
                    <tr>
                      <td style="text-align: right">Prioritätsfaktor</td>
                      <td>
                        <input type="tel" min="0" style="width: 46px; text-align: right" value="@selected_cup.fAttrFactor.ToString("0.00")" @onchange="(e) => setCupAttrFactor(selected_cup, e.Value)" />
                      </td>
                    </tr>
                    <tr>
                      <td style="text-align: right">Spieldauer [min]</td>
                      <td>
                        <input type="number" min="1" style="width: 46px; text-align: right" value="@selected_cup.nGameMin" @onchange="(e) => setCupGameMin(selected_cup, e.Value)" />
                      </td>
                    </tr>
                    <tr>
                      <td style="text-align: right">Anzahl Spieler</td>
                      <td>
                        <input type="number" min="1" style="width: 46px; text-align: right" value="@selected_cup.nPlStart" @onchange="(e) => setCupPlStart(selected_cup, e.Value)" />
                      </td>
                    </tr>
                    <tr>
                      <td style="text-align: right">Anzahl Reservespieler</td>
                      <td>
                        <input type="number" min="0" style="width: 46px; text-align: right" value="@selected_cup.nPlRes" @onchange="(e) => setCupPlRes(selected_cup, e.Value)" />
                      </td>
                    </tr>
                    <tr>
                      <td style="text-align: right">Anzahl Spielerwechsel</td>
                      <td>
                        <input type="number" min="0" style="width: 46px; text-align: right" value="@selected_cup.nSubstitutions" @onchange="(e) => setCupSubstitutions(selected_cup, e.Value)" />
                      </td>
                    </tr>
                    <tr>
                      <td style="text-align: right">Abseits</td>
                      <td>
                        <input type="checkbox" checked="@selected_cup.bOffsite" @onchange="(e) => setCupBOffsite(selected_cup, e.Value)" />
                      </td>
                    </tr>
                    <tr>
                      <td style="text-align: right">Karten</td>
                      <td>
                        <input type="checkbox" checked="@selected_cup.bCards" @onchange="(e) => setCupBCards(selected_cup, e.Value)" />
                      </td>
                    </tr>
                    @if (selected_cup.bCards) {
                      <tr>
                        <td style="text-align: right">Sperre nach N gelben Karten</td>
                        <td>
                          <input type="number" min="0" style="width: 46px; text-align: right" value="@selected_cup.nYellowCardsSuspension" @onchange="(e) => setYellowCardSuspension(selected_cup, e.Value)" />
                        </td>
                      </tr>
                    }
                    @if (selected_cup.bKo && selected_cup.bKoTwoGames) {
                      <tr>
                        <td style="text-align: right">Auswärtstorregel</td>
                        <td>
                          <input type="checkbox" checked="@selected_cup.bAwwayGoalRule" @onchange="(e) => setCupBAwayGoalRule(selected_cup, e.Value)" />
                        </td>
                      </tr>
                    }
                    <tr>
                      <td style="text-align: right">Größe Spielfeld</td>
                      <td>
                        <input type="tel" min="0" style="width: 46px; text-align: right" value="@selected_cup.fPitchSizeRel.ToString("0.00")" @onchange="(e) => setCupPitchSize(selected_cup, e.Value)" />
                      </td>
                    </tr>
                  </table>
                </div>
                @if (selected_cup.iId != CkAppShared.iCupIdWc) {
                  <div>
                    <table>
                      <tr>
                        <td style="border: none; padding: 0; text-align: right">Erster Spieltag: </td>
                        <td style="border: none; padding: 0; text-align: left">@selected_cup.dtStart.ToLongDateString()</td>
                      </tr>
                      <tr>
                        <td style="border: none; padding: 0; text-align: right">Letzter Spieltag: </td>
                        <td style="border: none; padding: 0; text-align: left">@selected_cup.dtEnd.ToLongDateString()</td>
                      </tr>
                      <tr>
                        <td style="border: none; padding: 0; text-align: right">Anzahl Spieltage: </td>
                        <td style="border: none; padding: 0; text-align: left">@selected_cup.nMatchdays.ToString()</td>
                      </tr>
                    </table>
                  </div>
                }
              </div>
              @if (selected_cup.iId != CkAppShared.iCupIdWc) {
                <div style="margin-right: 1rem; margin-bottom: 1rem">
                  <h5>Prämien:</h5>
                  <div style="overflow: auto">
                    <table class="cup_settings">
                      <tr>
                        <td style="text-align: right">Antrittsprämie</td>
                        <td>
                          <input type="tel" min="0" class="currency" value="@selected_cup.iBonusStart.ToString("N0")" @onchange="(e) => setCupBonusStart(selected_cup, e.Value)" />
                        </td>
                      </tr>
                      @if (selected_cup.nGroups > 0 && selected_cup.bKo) {
                        <tr>
                          <td style="text-align: right">Prämie Sieg Gruppenphase</td>
                          <td>
                            <input type="tel" min="0" class="currency" value="@selected_cup.iBonusVicGroup.ToString("N0")" @onchange="(e) => setCupBonusVicGroup(selected_cup, e.Value)" />
                          </td>
                        </tr>
                      }
                      <tr>
                        <td style="text-align: right">Prämie Titelgewinn</td>
                        <td>
                          <input type="tel" min="0" class="currency" value="@selected_cup.iBonusCupWin.ToString("N0")" @onchange="(e) => setCupBonusCupWin(selected_cup, e.Value)" />
                        </td>
                      </tr>
                      @if (selected_cup.bKo) {
                        <tr>
                          <td style="text-align: right">Ausschüttung während KO Phase</td>
                          <td>
                            <input type="checkbox" checked="@selected_cup.bBonusReleaseCupWinInKo" @onchange="(e) => setCupBonusReleaseCupWinInKo(selected_cup, e.Value)" />
                          </td>
                        </tr>
                      }
                    </table>
                  </div>
                </div>
                <div>
                  <h5>TV-Gelder:</h5>
                  <div style="overflow: auto">
                    <label>
                      Ausschüttung pro Spiel:
                      <input type="tel" min="0" class="currency" value="@selected_cup.iTvBonus.ToString("N0")" @onchange="(e) => setCupTvBonus(selected_cup, e.Value)" />
                    </label>
                  </div>
                </div>
              }
            </div>

            <div style="display: flex; flex-wrap: wrap; max-width: 100%">
              <div style="margin-right: 1rem; margin-bottom: 1rem">
                <h5>Qualifikationen für Wettb.:</h5>
                <div style="margin-left: 6px">
                  @{
                    int iQualiSum = 0;
                  }
                  <table>
                    <thead>
                      <tr>
                        <th>Name</th>
                        <th>St.</th>
                        <th>Von Pl.</th>
                        <th>Bis Pl.</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      @if (selected_cup.ltQ != null) {
                        foreach (CornerkickManager.Cup.Qualification q in selected_cup.ltQ) {
                          if (q.cup == null) continue;

                          iQualiSum += (q.iPlaceLast > 0 ? q.iPlaceLast : q.cup.getClubsTotal()) - Math.Max(q.iPlaceFirst, (byte)1) + 1;

                          <tr>
                            <td>@getCupName(q.cup)</td>
                            <td>
                              @if (q.cup.iId == selected_cup.iId && q.cup.iId2 == selected_cup.iId2 && q.cup.iId3 == selected_cup.iId3) {
                                <div title="verbleiben in Wettb.">
                                  <Blazorise.Icon Name="Blazorise.Icons.FontAwesome.FontAwesomeIcons.Refresh" IconSize="IconSize.Large" />
                                </div>
                              } else {
                                <div title="kommen zu Wettb. hinzu">
                                  <Blazorise.Icon Name="Blazorise.Icons.FontAwesome.FontAwesomeIcons.ArrowCircleLeft" IconSize="IconSize.Large" TextColor="TextColor.Success" />
                                </div>
                              }
                            </td>
                            <td>@(Math.Max(q.iPlaceFirst, (byte)1).ToString())</td>
                            <td>@(q.iPlaceLast > 0 ? q.iPlaceLast.ToString() : "Letzter")</td>
                            <td>
                              <Blazorise.Icon Name="Blazorise.IconName.MinusCircle" IconSize="IconSize.Large" TextColor="TextColor.Danger" Style="cursor: pointer" @onclick="() => removeQualiFromCup(selected_cup, q)" />
                            </td>
                          </tr>
                        }
                      }
                      <tr>
                        <td>
                          <select @bind="selected_cup.sQualiCupName">
                            @foreach (CornerkickManager.Cup cup in selected_cup.iId == CkAppShared.iCupIdWc ? CkAppShared.ckMng.ltCups.FindAll(c => c.iId == CkAppShared.iCupIdWc) : CkAppShared.ckMng.ltCups) {
                              string cupIdStr = getCupIdString(cup);
                              string cupName = getCupName(cup);
                              <option value="@cupIdStr" selected>@cupName</option>
                            }
                          </select>
                        </td>
                        <td></td>
                        <td>
                          <input type="number" style="width: 46px; text-align: right" @bind-value="selected_cup.iPlaceFirst" />
                        </td>
                        <td>
                          <input type="number" style="width: 46px; text-align: right" @bind-value="selected_cup.iPlaceLast" />
                        </td>
                        <td>
                          <Blazorise.Icon Name="Blazorise.IconName.PlusSquare" IconSize="IconSize.Large" TextColor="TextColor.Success" Style="cursor: pointer" @onclick="addQualiToCup" />
                        </td>
                      </tr>
                    </tbody>
                    <tfoot>
                      <tr style="font-weight: bold">
                        <td colspan="2" style="text-align: right; border-top-style: double">Summe / akt.:</td>
                        <td colspan="2" style="color: @(iQualiSum == selected_cup.nClubs ? "green" : "orange"); border-top-style: double">@(iQualiSum.ToString() + (selected_cup.nClubs.ToString(" / 0")))</td>
                        <td></td>
                      </tr>
                    </tfoot>
                  </table>
                  <div style="display: flex; flex-wrap: wrap">
                    @if (selected_cup.iId == CkAppShared.iCupIdLeague) {
                      if (selected_cup.ltQ == null || selected_cup.ltQ.Find(q => q.cup.iId == selected_cup.iId && q.cup.iId2 == selected_cup.iId2 && q.cup.iId3 == selected_cup.iId3 - 1) == null) {
                        CornerkickManager.Cup? cupUp = CkAppShared.ckMng.ltCups.Find(c => c.iId == selected_cup.iId && c.iId2 == selected_cup.iId2 && c.iId3 == selected_cup.iId3 - 1);
                        if (cupUp != null) {
                          <div style="margin-right: 1rem">
                            <h6>Aufsteiger hinzufügen:</h6>
                            <table>
                              <thead>
                                <tr>
                                  <th>In Liga</th>
                                  <th>Anzahl</th>
                                  <th></th>
                                </tr>
                              </thead>
                              <tr>
                                <td>
                                  <Blazorise.Icon Name="Blazorise.IconName.PlusSquare" IconSize="IconSize.Large" TextColor="TextColor.Success" Style="cursor: pointer" @onclick="addQualiLeagueUpToCup" />
                                </td>
                                <td>@cupUp.sName</td>
                                <td>
                                  <input type="number" style="width: 46px; text-align: right" @bind-value="selected_cup.iPlaceFirst" />
                                </td>
                              </tr>
                            </table>
                          </div>
                        }
                      }
                      if (selected_cup.ltQ == null || selected_cup.ltQ.Find(q => q.cup.iId == selected_cup.iId && q.cup.iId2 == selected_cup.iId2 && q.cup.iId3 == selected_cup.iId3 + 1) == null) {
                        CornerkickManager.Cup? cupDn = CkAppShared.ckMng.ltCups.Find(c => c.iId == selected_cup.iId && c.iId2 == selected_cup.iId2 && c.iId3 == selected_cup.iId3 + 1);
                        if (cupDn != null) {
                          <div>
                            <h6>Absteiger hinzufügen:</h6>
                            <table>
                              <thead>
                                <tr>
                                  <th>In Liga</th>
                                  <th>Anzahl</th>
                                  <th></th>
                                </tr>
                              </thead>
                              <tr>
                                <td>@cupDn.sName</td>
                                <td>
                                  <input type="number" style="width: 46px; text-align: right" @bind-value="selected_cup.iPlaceFirst" />
                                </td>
                                <td>
                                  <Blazorise.Icon Name="Blazorise.IconName.PlusSquare" IconSize="IconSize.Large" TextColor="TextColor.Success" Style="cursor: pointer" @onclick="addQualiLeagueDnToCup" />
                                </td>
                              </tr>
                            </table>
                          </div>
                        }
                      }
                    }
                  </div>
                </div>
              </div>

              <div style="color: grey">
                <h5>Qualifikationen aus Wettb.:</h5>
                <div style="margin-left: 6px">
                  <table>
                    <tr>
                      <th>Name</th>
                      <th>St.</th>
                      <th>Von Pl.</th>
                      <th>Bis Pl.</th>
                    </tr>
                    @foreach (CornerkickManager.Cup cq in CkAppShared.ckMng.ltCups) {
                      if (cq.iId == selected_cup.iId && cq.iId2 == selected_cup.iId2 && cq.iId3 == selected_cup.iId3) continue;

                      if (cq.ltQualification != null) {
                        foreach (CornerkickManager.Cup.Qualification q2 in cq.ltQualification) {
                          if (q2.cup == null) continue;

                          if (q2.cup.iId == selected_cup.iId && q2.cup.iId2 == selected_cup.iId2 && q2.cup.iId3 == selected_cup.iId3) {
                            <tr>
                              <td>@cq.sName</td>
                              <td>
                                <div title="Qualifikation für Wettb.">
                                  <Blazorise.Icon Name="Blazorise.Icons.FontAwesome.FontAwesomeIcons.ArrowCircleRight" IconSize="IconSize.Large" TextColor="TextColor.Primary" />
                                </div>
                              </td>
                              <td>@(Math.Max(q2.iPlaceFirst, (byte)1).ToString())</td>
                              <td>@(q2.iPlaceLast > 0 ? q2.iPlaceLast.ToString() : "Letzter")</td>
                            </tr>
                          }
                        }
                      }
                    }
                  </table>
                </div>
              </div>
            </div>

