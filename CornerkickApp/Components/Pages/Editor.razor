  private async Task fillSelectClubs(int iCupId1 = -9, int iCupId2 = -9, int iCupId3 = -9, bool bChangeClub = true)
  {
    ltClubs = new List<LayoutModel.SelectListItem>();

    List<CornerkickManager.Club>? ltClubsTmp = null;

    if (iCupId1 >= 0) {
      CornerkickManager.Cup cup = CkAppShared.ckMng.tl.getCup(iId: iCupId1, iId2: iCupId2, iId3: iCupId3);
      ltClubsTmp = cup == null ? null : cup.getParticipants();
    } else if (iCupId1 == -2) { // Nations
      ltClubsTmp = CkAppShared.ckMng.ltClubs.Where(c => c.bNation).ToList();
    } else if (iCupId1 == -9) { // All clubs
      ltClubsTmp = CkAppShared.ckMng.ltClubs;
    }

    if (ltClubsTmp != null) {
      ltClubsTmp = ltClubsTmp.OrderBy(c => c.sName).ToList();

      foreach (CornerkickManager.Club clb in ltClubsTmp) {
        ltClubs.Add(new LayoutModel.SelectListItem() {
            Value = clb.iId.ToString(),
            Text = clb.sName
          });
      }

      if (bChangeClub) {
        int jClubId = -1;
        if (ltClubs.Count > 0) int.TryParse(ltClubs[0].Value, out jClubId);
        await changeClub(jClubId);
      } else {
        await InvokeAsync(StateHasChanged);
      }
    }
  }

  protected async Task createClub()
  {
    if (string.IsNullOrEmpty(selectedLeagueName)) return;
    if (fNewClubTeamAve < 1f) return;

    CornerkickManager.Cup? league = CkAppShared.ckMng.ltCups.Find(c => c.sName == selectedLeagueName);
    if (league == null) return;

    CornerkickManager.Club? clbNew = CornerkickApp.Controllers.App.createClub(CkAppShared.ckMng, "", (byte)league.iId2, (byte)league.iId3);
    if (clbNew == null) return;

    string sTeamNameLand = "Land_" + league.iId2.ToString();
    if (CornerkickManager.Main.sLandShort != null && CornerkickManager.Main.sLandShort.Length > league.iId2) sTeamNameLand = CornerkickManager.Main.sLandShort[league.iId2];
    clbNew.sName = "Team_" + sTeamNameLand + "_" + clbNew.iId.ToString();

    CornerkickApp.Controllers.App.addPlayerToClub(CkAppShared.ckMng, ref clbNew, fSkillAve: fNewClubTeamAve);

    CkAppShared.ckMng.ltClubs.Add(clbNew);
    league.ltClubs[0].Add(clbNew);

    await changeCup(league);
    await changeClub(clbNew.iId);
    fillSelectClubs();
  }

  protected async Task changeClub(int jClubId)
  {
    sClassDisabled = "disabled";
    await InvokeAsync(StateHasChanged);

    iClubId = jClubId;

    selectedCupToAddToClub = "";

    int[] iCupIds = getCupIdsFromCupIdStr(selectedCupFilterClubs);
    bool bNat = iCupIds[0] == CkAppShared.iCupIdWc || iCupIds[0] == -2;
    selected_club = new Club();
    CornerkickManager.Club? clb = CkAppShared.ckMng.ltClubs.Find(c => c.iId == iClubId && c.bNation == bNat);
    if (clb == null) {
      sClassDisabled = "";
      await InvokeAsync(StateHasChanged);
      return;
    }

    selected_club.iId = clb.iId;
    selected_club.sName = clb.sName;
    selected_club.iNat = clb.iLand;
    selected_club.bNation = clb.bNation;

    if (clb.ltTactic != null && clb.ltTactic.Count > 0) selected_club.iFrm = CkAppShared.ckMng.ltFormationen.FindIndex(f => f.iId == clb.ltTactic[0].formation.iId);

    selected_club.stadium = clb.stadium;

    float[] fTeamAve = CornerkickManager.Tool.getTeamAve(clb, CkAppShared.ckMng.dtDatum, CkAppShared.ckMng.dtSeasonEnd, bIdeal: true, bTeamValue: true);
    selected_club.fSkillAve = fTeamAve[3];
    selected_club.fAgeAve   = fTeamAve[4];
    selected_club.fValueAve = fTeamAve[5];

    /*
    selected_club.sCl1 = new string[3];
    selected_club.sCl2 = new string[3];
    for (int iC = 0; iC < 3; iC++) {
      selected_club.sCl1[iC] = CornerkickApp.Controllers.Tool.convertToHex(clb.cl1[iC]);
      selected_club.sCl2[iC] = CornerkickApp.Controllers.Tool.convertToHex(clb.cl2[iC]);
      }
    */
    if (jerseyH != null) await jerseyH.draw(clb);
    if (jerseyA != null) await jerseyA.draw(clb);

    if (ltClubEmblem != null) {
      CornerkickApp.Services.Emblem? ce = new CornerkickApp.Services.Emblem();
      ce = ltClubEmblem.Find(c => c.iId == clb.iId);
      if (ce != null) selected_club.bEmblem = ce.bEmblem;
    }

    if (selected_club.bEmblem == null) {
      selected_club.bEmblem = await CornerkickApp.Services.StartGameService.loadMediaDataClub(dbfile2, clb.iId);
    }

    await getTableTeam(clb, bInteractive: false);

    // Select first player of team
    if (tableTeam != null && tableTeam.Count > 0) selectPlayer(tableTeam[0]);

    sClassDisabled = "";
    await InvokeAsync(StateHasChanged);
  }

  private async Task getTableTeam(int iClubId, bool bInteractive = true)
  {
    await getTableTeam(CkAppShared.ckMng.ltClubs.Find(c => c.iId == iClubId), bInteractive: bInteractive);
