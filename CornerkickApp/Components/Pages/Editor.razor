  private Task addQualiToCup()
  {
    if (selected_cup == null) return Task.CompletedTask;

    CornerkickManager.Cup? c = CkAppShared.ckMng.ltCups.Find(c => c.iId == selected_cup.iId && c.iId2 == selected_cup.iId2 && c.iId3 == selected_cup.iId3);
    if (c == null) return Task.CompletedTask;

    if (addQualiToCup(c,
                      CkAppShared.ckMng.ltCups.Find(c => getCupIdString(c).Equals(selected_cup.sQualiCupName)),
                      selected_cup.iPlaceFirst,
                      selected_cup.iPlaceLast)) {
      selected_cup.ltQ = c.ltQualification;
      StateHasChanged();
    }

    return Task.CompletedTask;
  }
  private static bool addQualiToCup(CornerkickManager.Cup? cup, CornerkickManager.Cup? cupQ, int iPlaceFrst, int iPlaceLast)
  {
    if (cup == null) return false;
    if (cupQ == null) return false;

    byte jPlaceFrst = (byte)(iPlaceFrst < 0 ? (cupQ.ltClubs[0].Count + iPlaceFrst) + 1 : iPlaceFrst);
    byte jPlaceLast = (byte)(iPlaceLast < 0 ? (cupQ.ltClubs[0].Count + iPlaceLast) + 1 : iPlaceLast);

    if (cup.ltQualification == null) cup.ltQualification = new List<CornerkickManager.Cup.Qualification>();
    cup.ltQualification.Add(new CornerkickManager.Cup.Qualification() {
        cup = cupQ,
        iPlaceFirst = jPlaceFrst,
        iPlaceLast = jPlaceLast
      });

    // Order qualifications
    cup.ltQualification = cup.ltQualification.OrderBy(q => q.cup.iId).ThenBy(q => q.cup.iId2).ThenBy(q => q.cup.iId3).ToList();

    // Adjust self quali in qualification cup
    if (cupQ.ltQualification != null) {
      foreach (CornerkickManager.Cup.Qualification q in cupQ.ltQualification) {
        if (q.cup.iId == cupQ.iId && q.cup.iId2 == cupQ.iId2 && q.cup.iId3 == cupQ.iId3) {
          byte jQPlaceLast = (byte)(q.iPlaceLast < 1 ? cupQ.ltClubs[0].Count : q.iPlaceLast);

          if (q.iPlaceFirst < jPlaceFrst) q.iPlaceLast = (byte)Math.Min(jQPlaceLast, jPlaceFrst - 1);
          if (jQPlaceLast > (jPlaceLast == 0 ? 999 : jPlaceLast)) q.iPlaceFirst = (byte)Math.Max(q.iPlaceFirst, jPlaceLast + 1);
        }
      }
    }

    return true;
  }

  private Task addQualiLeagueUpToCup()
  {
    if (selected_cup == null) return Task.CompletedTask;

    CornerkickManager.Cup? cup = CkAppShared.ckMng.ltCups.Find(c => c.iId == selected_cup.iId && c.iId2 == selected_cup.iId2 && c.iId3 == selected_cup.iId3);
    if (cup == null) return Task.CompletedTask;

    CornerkickManager.Cup? cupUp = CkAppShared.ckMng.ltCups.Find(c => c.iId == selected_cup.iId && c.iId2 == selected_cup.iId2 && c.iId3 == selected_cup.iId3 - 1);
    if (cupUp == null) return Task.CompletedTask;

    if (!addQualiToCup(cup, cupUp, -selected_cup.iPlaceFirst, 0)) return Task.CompletedTask;
    if (!addQualiToCup(cupUp, cup, +1, selected_cup.iPlaceFirst)) return Task.CompletedTask;

    selected_cup.ltQ = cup.ltQualification;
    StateHasChanged();

    return Task.CompletedTask;
  }

  private Task addQualiLeagueDnToCup()
  {
    if (selected_cup == null) return Task.CompletedTask;

