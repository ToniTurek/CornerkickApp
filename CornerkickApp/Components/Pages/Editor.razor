  private static string getCupName(CornerkickManager.Cup cup)
  {
    string sName = cup.sName + " (" + sCupNames[Array.IndexOf(iCupIds, cup.iId)];
    if (cup.iId != CkAppShared.iCupIdInt && CornerkickManager.Main.sLandShort != null && cup.iId2 >= 0 && cup.iId2 < CornerkickManager.Main.sLandShort.Length) {
      sName += ", " + CornerkickManager.Main.sLandShort[cup.iId2];
      if (cup.iId == CkAppShared.iCupIdLeague) sName += " / " + (cup.iId3 + 1).ToString();
    }
    sName += ")";
    return sName;
  }

