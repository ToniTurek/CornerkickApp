  private async Task SearchPlayer()
  {
    ltPlayerSearchResult = null;

    if (string.IsNullOrEmpty(sPlayerSearchString)) return;

    ltPlayerSearchResult = new List<Player>();

    List<CornerkickManager.Player> ltPl = CkAppShared.ckMng.ltPlayer.FindAll(p => p.plGame.sName.Contains(sPlayerSearchString));
    if (ltPl == null) return;
    if (ltPl.Count < 1) return;

    foreach (CornerkickManager.Player pl in ltPl) {
      ltPlayerSearchResult.Add(new Player() {
        iId = pl.plGame.iId,
        sName = pl.plGame.sName,
        dtBirthday = pl.plGame.dtBirthday,
        iHp = pl.plGame.getMainPosition(),
        sPos = CornerkickManager.PlayerTool.getStrPos(pl),
        iClubId = pl.contract?.club == null ? -1 : pl.contract.club.iId,
        iNat = pl.iNat1,
      });
    }
  }

  private async Task saveDatabase()
  {
    sClassDisabled = "disabled";
    await InvokeAsync(StateHasChanged);

    try {
      DirectoryInfo d = new DirectoryInfo(Path.Combine(CkAppShared.sAppDataDir, "database"));
      if (!d.Exists) Directory.CreateDirectory(Path.Combine(CkAppShared.sAppDataDir, "database"));

      // Order cups
      //CkAppShared.ckMng.ltCups = CkAppShared.ckMng.ltCups.OrderBy(c => c.iId2).ThenBy(c => c.iId3).ThenBy(c => c.iId).ToList();
      CkAppShared.ckMng.ltCups = CkAppShared.ckMng.ltCups.OrderByDescending(c => c.iId).ThenBy(c => c.iId2).ThenBy(c => c.iId3).ToList();

      // Order cup qualis
      foreach (CornerkickManager.Cup c in CkAppShared.ckMng.ltCups) {
        if (c.ltQualification != null) {
          try{
            c.ltQualification = c.ltQualification.OrderBy(q => q.cup.iId).ThenBy(q => q.cup.iId2).ThenBy(q => q.cup.iId3).ToList();
          } catch {
            Console.WriteLine("Error ordering cup qualification for cup: " + c.sName);
          }
        }
      }

      bool bParallel = false;
      Progress<int[]>? progressIndicatorCount = null;
      if (!bParallel) {
        progressIndicatorCount = new Progress<int[]>(ReportProgressSaveDb);
      }
      string sFileExt = iFileFormat == 0 ? ".ckdbx" : "";
      await CkAppShared.ckMng.io.saveAsync(Path.Combine(CkAppShared.sAppDataDir, "database", dbfile2 + sFileExt), bDatabase: true, bParallel: bParallel, progress: progressIndicatorCount);
      if (MainLayout.ckProgressBar != null) MainLayout.ckProgressBar.stop();

      foreach (CornerkickApp.Services.Emblem ce in ltCupEmblem) {
        if (ce?.bEmblem == null) continue;
        CornerkickApp.Controllers.App.uploadFile(ce.bEmblem, CornerkickApp.Controllers.App.getMediaDir(dbfile2), Path.Combine("images", "cup_emblems"), ce.iId, iId2: ce.iId2, iId3: ce.iId3);
      }

      foreach (CornerkickApp.Services.Emblem ce in ltClubEmblem) {
        if (ce?.bEmblem == null) continue;
        CornerkickApp.Controllers.App.uploadFile(ce.bEmblem, CornerkickApp.Controllers.App.getMediaDir(dbfile2), Path.Combine("images", "cup_emblems"), ce.iId);
      }

      foreach (CornerkickApp.Services.Emblem pp in ltPlayerPortrait) {
        if (pp?.bEmblem == null) continue;
        CornerkickApp.Controllers.App.uploadFile(pp.bEmblem, CornerkickApp.Controllers.App.getMediaDir(dbfile2), Path.Combine("images", "cup_emblems"), pp.iId);
      }

      dbfile = dbfile2 + sFileExt;

      if (MainLayout.ckToast != null) {
        MainLayout.toastMessage = $"Datenbank: <b>{dbfile2}</b> gespeichert";
        await MainLayout.ckToast.Show();
      }
      //await CommunityToolkit.Maui.Alerts.Toast.Make($"Datenbank: {dbfile2} gespeichert", ToastDuration.Long).Show();
    } catch (Exception ex) {
      string sError = "Error saving database: " + dbfile2 + ".ckdbx. Error message: " + ex.Message;

      await CkDialog.ckDialog.Show(
        "Fehler",
        sError,
        sButtonCancelText2: ""
      );
    }

    sClassDisabled = "";
    await InvokeAsync(StateHasChanged);
  }

