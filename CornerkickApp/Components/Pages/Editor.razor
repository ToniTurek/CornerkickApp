  private int[] getCupIdsFromCupIdStr(string sCupIdStr)
  {
    int iId1 = -9;
    int iId2 = -9;
    int iId3 = -9;

    if (!string.IsNullOrEmpty(sCupIdStr)) {
      string[] sParts = sCupIdStr.Split('_');
      if (sParts.Length > 2) {
        int.TryParse(sParts[0], out iId1);
        int.TryParse(sParts[1], out iId2);
        int.TryParse(sParts[2], out iId3);
      } else if (sParts.Length > 0) {
        int.TryParse(sParts[0], out iId1);
      }
    }

    return [iId1, iId2, iId3];
  }

  private CornerkickManager.Cup? getCupFromCupIdStr(string sCupIdStr)
  {
    int[] iCupIds = getCupIdsFromCupIdStr(sCupIdStr);
    return CkAppShared.ckMng.ltCups.Find(c => c.iId == iCupIds[0] && c.iId2 == iCupIds[1] && c.iId3 == iCupIds[2]);
  }

