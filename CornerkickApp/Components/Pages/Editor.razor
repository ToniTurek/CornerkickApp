  private async Task getTableTeam(CornerkickManager.Club? clb, bool bInteractive = true)
  {
    if (bInteractive) {
      sClassDisabled = "disabled";
      //StateHasChanged();
      //body.Invoke(StateHasChanged);
      await InvokeAsync(StateHasChanged);
    }

    tableTeam = new List<Player>();

    if (clb?.ltPlayer != null) {
      clb.ltPlayer = clb.ltPlayer.OrderBy(p => p.plGame.getMainPosition()).ToList();

      int iIx = 0;
      foreach (CornerkickManager.Player pl in clb.ltPlayer) {
        Player? player = await getPlayer(pl, iIx: iIx++);
        if (player != null) tableTeam.Add(player);
      }
    }

    if (bInteractive) {
      sClassDisabled = "";
      //body.Invoke(StateHasChanged);
      await InvokeAsync(StateHasChanged);
    }
  }

