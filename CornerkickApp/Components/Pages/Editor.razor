  private Task deleteClub(Club? clb = null)
  {
    if (clb == null) return Task.CompletedTask;
    return deleteClub(clb: CkAppShared.ckMng.ltClubs.Find(c => c.iId == clb.iId));
  }
  private Task deleteClub(CornerkickManager.Club? clb = null, bool bForce = false)
  {
    if (clb == null && selected_club != null && !bForce) clb = CkAppShared.ckMng.ltClubs.Find(c => c.iId == selected_club.iId);
    if (clb == null) return Task.CompletedTask;

    if (bForce) {
      deleteClubWork(clb);
      return Task.CompletedTask;
    }

    CkDialog.ckDialog.Show(
      "Verein wirklich löschen?",
      "Alle Spieler des Vereins werden ebenfalls gelöscht!",
      actionOnOk: () => deleteClubWork(clb)
    );

    return Task.CompletedTask;
  }

  private Task deleteClubWork(CornerkickManager.Club? clb = null)
  {
    if (clb == null && selected_club != null) clb = CkAppShared.ckMng.ltClubs.Find(c => c.iId == selected_club.iId);
    if (clb == null) return Task.CompletedTask;

    // Remove club from cups
    foreach (CornerkickManager.Cup cup in CkAppShared.ckMng.ltCups) {
      cup.ltClubs[0].Remove(clb);
    }

    // Delete player from club
    while (clb.ltPlayer.Count > 0) {
      CornerkickManager.Player pl = clb.ltPlayer[0];

      CkAppShared.ckMng.ltPlayer.Remove(pl);
      clb.ltPlayer.RemoveAt(0);
    }

    CkAppShared.ckMng.ltClubs.Remove(clb);

    fillSelectClubs();

    changeCup(selected_cup);

    StateHasChanged();

    return Task.CompletedTask;
  }

