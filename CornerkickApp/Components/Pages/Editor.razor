  private async Task deletePlayerWork(Player pl)
  {
    if (pl == null) return;

    CornerkickManager.Player? plCk = CkAppShared.ckMng.ltPlayer.Find(p => p.plGame.iId == pl.iId);
    if (plCk == null) return;

    CkAppShared.ckMng.ltPlayer.Remove(plCk);
    if (plCk.contract?.club != null) plCk.contract.club.ltPlayer.Remove(plCk);

    if (selected_club != null) await getTableTeam(selected_club.iId);

    selected_player = null;

    await InvokeAsync(StateHasChanged);
  }

