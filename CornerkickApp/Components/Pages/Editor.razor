  private async Task exportDatabaseXML()
  {
    string pickResult = await folderPickerService.PickFolderAsync();
    if (string.IsNullOrEmpty(pickResult)) return;

    bWorking = true;
    await InvokeAsync(StateHasChanged);

    string SelectedFolder;
    string SelectedFolderName;

    // Android-implementation liefert aktuell URI (content://...), andere Plattformen liefern Pfad
    if (pickResult.StartsWith("content://")) {
      SelectedFolder = pickResult;
      // robustere Extraktion des letzten Segments
      var idx = pickResult.LastIndexOf("%2F");
      SelectedFolderName = idx >= 0 ? pickResult[(idx + 3)..] : pickResult;
    } else {
      SelectedFolder = pickResult;
      SelectedFolderName = Path.GetFileName(SelectedFolder);
    }

    await CkAppShared.ckMng.io.saveAsync(Path.Combine(SelectedFolder, dbfile2 + ".xml"), bDatabase: true);
  }

  private async Task importDb(FileChangedEventArgs e)
  {
    CancellationTokenSource source = new();
    CancellationToken token = source.Token;

    bool bUpdateAll = false;
    bool bUpdatePlayer = false;
    CornerkickManager.Player? pl_read_xml = null;

    foreach (var file in e.Files) {
      try {
        // A stream is going to be the destination stream we're writing to.
        await using (var stream = new MemoryStream()) {
          // Here we're telling the FileEdit where to write the upload result
          await file.WriteToStreamAsync(stream);

          // Once we reach this line it means the file is fully uploaded.
          // In this case we're going to offset to the beginning of file
          // so we can read it.
          stream.Seek(0, SeekOrigin.Begin);

          string sDbTmpDir = Path.Combine(CkAppShared.sAppDataDir, "database");
          string sDbFilename = Path.Combine(sDbTmpDir, Path.GetFileName(file.Name));
          if (!Directory.Exists(sDbTmpDir)) Directory.CreateDirectory(sDbTmpDir);
          using (FileStream DestinationStream = File.Create(sDbFilename)) {
            await stream.CopyToAsync(DestinationStream);
          }

          Progress<int[]> progressIndicator = new Progress<int[]>(ReportProgressImportDb);

          int processCount = await Task.Run<int>(() => {
            int iCount = 0;

            if (file.Name.StartsWith("Player") && file.Name.EndsWith(".xml")) {
              CkAppShared.ckMng.io.ioxml.read_player(sDbFilename, out pl_read_xml);
            } else {
              CkAppShared.ckMng.io.loadAsync(sDbFilename, bDatabase: true, progress: progressIndicator).Wait();
            }

            return iCount;
          });

          // Delete xml format database file after import
          if (sDbFilename.EndsWith(".xml") || sDbFilename.EndsWith(".xml.zip")) File.Delete(sDbFilename);

          if (file.Name.EndsWith(".ckdbx") || file.Name.EndsWith(".zip")) {
            bUpdateAll = true;
          } else if (file.Name.EndsWith(".xml")) {
            if (file.Name.StartsWith("Player")) bUpdatePlayer = true;
          }
        }
      } catch (Exception ex) {
        Console.WriteLine(ex.Message);

        string sError = "File: " + file.Name + " Error: " + ex.Message;

        await CkDialog.ckDialog.Show(
          "Fehler",
          sError,
          sButtonCancelText2: ""
        );
      }
    }

    if (MainLayout.ckProgressBar != null) MainLayout.ckProgressBar.stop();

    if (bUpdateAll) {
      if (string.IsNullOrEmpty(dbfile2)) dbfile2 = CkAppShared.ckMng.sDatabaseName;
      await update();
    } else if (pl_read_xml != null) {
      await selectPlayer(pl_read_xml);
    }
    await InvokeAsync(StateHasChanged);
  }
  
