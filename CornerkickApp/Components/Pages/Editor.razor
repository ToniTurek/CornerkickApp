  private Task removeClubFromCup(Cup cup, Club? clb = null)
  {
    if (cup == null) return Task.CompletedTask;
    if (CkAppShared.ckMng?.ltCups == null) return Task.CompletedTask;

    return removeClubFromCup(CkAppShared.ckMng.ltCups.Find(c => c.iId == cup.iId && c.iId2 == cup.iId2 && c.iId3 == cup.iId3), clb: clb);
  }
  private async Task removeClubFromCup(CornerkickManager.Cup? cup, Club? clb = null)
  {
    if (cup == null) return;

    if (clb == null && selected_club != null) clb = selected_club;
    if (clb == null) return;

    CornerkickManager.Club? clbCk = CkAppShared.ckMng.ltClubs.Find(c => c.iId == clb.iId);
    if (clbCk == null) return;

    for (int iG = 0; iG < cup.ltClubs.Length; iG++) cup.ltClubs[iG].Remove(clbCk);

    await changeCup(cup);

    await InvokeAsync(StateHasChanged);
  }

  private Task addClubToCup(string sCupName)
  {
    if (selected_club == null) return Task.CompletedTask;

    CornerkickManager.Club? clb = CkAppShared.ckMng.ltClubs.Find(c => c.iId == selected_club.iId);
    if (clb == null) return Task.CompletedTask;

    CornerkickManager.Cup? cup = CkAppShared.ckMng.ltCups.Find(c => c.sName == sCupName);
    if (cup == null) return Task.CompletedTask;

    selectedCupToAddToClub = "";

    if (!cup.checkClubInCup(clb)) {
      //int iG = Array.FindIndex(cup.ltClubs, l => l.Count
      //int iG = cup.ltClubs.Min(l => l.Count);
      int iG = 0;
      int nCl = cup.ltClubs[0].Count;
      for (int i = cup.ltClubs.Length - 1; i > 0; i--) {
        if (cup.ltClubs[i].Count < nCl) iG = i;
      }
      cup.ltClubs[iG].Add(clb);

      changeCup(cup);
    }
    //StateHasChanged();

    return Task.CompletedTask;
  }

