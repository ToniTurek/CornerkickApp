  private async Task setPlayerCharacter(int iPlId, int iType, float fChar)
  {
    CornerkickManager.Player? pl = CkAppShared.ckMng.ltPlayer.Find(p => p.plGame.iId == iPlId);
    if (pl?.character == null) return;

    if      (iType == 0) pl.plGame.character.fLeader     = Math.Min(Math.Max(fChar, 0f), 2f);
    else if (iType == 1) pl.plGame.character.fShoot      = Math.Min(Math.Max(fChar, 0f), 2f);
    else if (iType == 2) pl.plGame.character.fPass       = Math.Min(Math.Max(fChar, 0f), 2f);
    else if (iType == 3) pl.plGame.character.fDribbling  = Math.Min(Math.Max(fChar, 0f), 2f);
    else if (iType == 4) pl.plGame.character.fFlexibel   = Math.Min(Math.Max(fChar, 0f), 2f);
    else if (iType == 5) pl.plGame.character.fRobustness = Math.Min(Math.Max(fChar, 0f), 2f);
    else if (iType == 6) pl.plGame.character.fCholeric   = Math.Min(Math.Max(fChar, 0f), 2f);
    else if (iType == 7) pl.plGame.character.fMoney      = Math.Min(Math.Max(fChar, 0f), 2f);

    selected_player = await getPlayer(pl);
  }

