@page "/userpassword"

@using CornerkickApp.Shared.Models
@inject NavigationManager NavigationManager

<h3>Bitte Passwort eingeben</h3>

<div class="alert alert-danger" hidden="@string.IsNullOrEmpty(errMsg)">
  @errMsg
</div>
<div class="form-group">
  <label>Passwort</label>
  <InputText id="password" type="password" @bind-Value="sPw" class="form-control" />
</div>
<div class="form-group mt-1">
  <button class="btn btn-primary w-100" @onclick=next>weiter</button>
</div>

@code {
  string sPw { get; set; }
  private bool loginFailureHidden = true;
  private string errMsg = "";

  private async Task next()
  {
    if (sPw.Equals(CkAppShared.ckMng.ltUser[CkAppShared.iUserActive].sPw)) {
      NavigationManager.NavigateTo("member/desk", true);
      return;
    }

    errMsg = "Fehler";
  }
}
