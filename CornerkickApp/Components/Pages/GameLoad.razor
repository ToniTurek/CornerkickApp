    if (firstRender) {
    }
  }

  private void selectGame(string? sFileCk)
  {
    sFileCkSelected = sFileCk;
    StateHasChanged();
  }

  private void selectGameOnline(string? sFileCk)
  {
    ltFilesCk = Services.StartGameService.getFilesToLoad().Result;
    sFileCkSelected = sFileCk;
    if (lcf != null) lcf.update(sFileCkSelected);
    StateHasChanged();
  }

  private void loadGame2(string? sFileCk)
