  private async Task deleteGame()
  {
    if (string.IsNullOrEmpty(sFileCkSelected)) return;

    await CkDialog.ckDialog.Show(
      "Warnung",
      "Spielstand <b>" + Path.GetFileNameWithoutExtension(sFileCkSelected) + "</b> wirklich löschen?",
      sButtonOkText2: "löschen",
      actionOnOk: () => deleteGameWork()
    );
  }

  private async Task deleteGameWork()
  {
    if (string.IsNullOrEmpty(sFileCkSelected)) return;

    await Task.Run(() => { File.Delete(sFileCkSelected); });

    sFileCkSelected = null;
    CkAppShared.sFileCk = null;

    ltFilesCk = await Services.StartGameService.getFilesToLoad();
    HomeModel.iFilesLoad = ltFilesCk.Count();

    await InvokeAsync(StateHasChanged);
  }

  private Task loadGameBackup(CornerkickGame.Game gmBck)
