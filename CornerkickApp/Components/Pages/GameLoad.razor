@page "/gameload"

@using CornerkickApp.Shared.Models
@using CornerkickApp.Components.Shared.Components
@using Blazorise.Modules
@inject NavigationManager NavigationManager
@inject Controllers.Shared.MyAuthenticationStateProvider _auth

<!DOCTYPE html>
<html>
<head>
  <style>
    /* Set background color to all buttons */
    .btn-group .btn {
      background-color: yellow !important;
    }

    /* Set background color of active button */
    .btn-group .btn.active {
      background-color: #ff9933 /*#ff4d4d*/ !important;
    }

    /* Set background color on hover */
    .btn-group .btn:hover {
      background-color: #ffcc00 !important;
    }
  </style>
</head>

<body class="@sClassDisabled">
  <div style="position: relative; max-width: 1000px">
    <h4>Lokale Spielstände</h4>
    <hr />

    <div class="p-3 form-group" style="margin-bottom: 6px">
      <ListCkFiles @ref=lcf ltFilesCk="ltFilesCk" action="selectGame"></ListCkFiles>

      <div style="margin-top: 10px">
        <button class="btn btn-primary" style="width: 100%; font-size: 120%; background-color: rgb(@CkAppShared.sClCkRgb); border-color: darkgreen" @onclick="() => loadGame(sFileCkSelected)" disabled="@string.IsNullOrEmpty(sFileCkSelected)">
          <Blazorise.Icon Name="Blazorise.IconName.FolderOpen" />
          laden
        </button>
        <button class="btn btn-secondary" style="width: 100%; margin-top: 4px; background-color: lightcoral; border-color:red" @onclick="deleteGame" disabled="@string.IsNullOrEmpty(sFileCkSelected)">
          <Blazorise.Icon Name="Blazorise.IconName.Delete" />
          löschen
        </button>
      </div>
    </div>
    <GameLoadOnline action="selectGameOnline"></GameLoadOnline>
  </div>
</body>
</html>

@code {
