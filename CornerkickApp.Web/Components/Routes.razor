@using CornerkickApp.Web.Components.Account.Pages
@using Microsoft.AspNetCore.Components.Authorization

<Router AppAssembly="typeof(App).Assembly"
        AdditionalAssemblies="new[] { typeof(CornerkickApp.Shared.Pages.Home).Assembly, typeof(CornerkickApp.Components.Shared.Layout.MainLayout).Assembly }">
    <Found Context="routeData">
       <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(CornerkickApp.Components.Shared.Layout.MainLayout)">
            <Authorizing>
                Authorizing...
            </Authorizing>
            <NotAuthorized>
                <Login />
            </NotAuthorized>
        </AuthorizeRouteView>   
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
